# Database
DATABASE_URL="postgresql://username:password@localhost:5432/stockflow?schema=public"
PAYROLL_IMMUTABILITY_DATABASE_URL="postgresql://username:password@localhost:5432/stockflow_immutability_test?schema=public"

# Auth.js Configuration
AUTH_SECRET="your-super-secret-key-here-minimum-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Configuration (for password reset, etc.)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@yourdomain.com"

# Redis (for session storage and caching - optional)
REDIS_URL="redis://localhost:6379"

# Application Settings
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# WhatsApp POS receipt delivery is disabled unless explicitly enabled and fully configured.
STOQUIFY_WHATSAPP_RECEIPT_LIVE_SENDS=0
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_RECEIPT_TEMPLATE_NAME="stoquify_receipt"
WHATSAPP_RECEIPT_TEMPLATE_LANGUAGE="en"
WHATSAPP_CLOUD_API_VERSION="v20.0"
# Production-only dedicated secrets. Generate independent random values; do not reuse AUTH_SECRET.
PUBLIC_IDENTITY_ABUSE_HASH_SECRET="your-public-identity-hash-secret-minimum-32-characters-long"
AQSTOQFLOW_RECEIPT_TOKEN_SECRET="your-receipt-token-secret-minimum-32-characters-long"
AQSTOQFLOW_HISTORY_CURSOR_SECRET="your-history-cursor-secret-minimum-32-characters-long"
PAYROLL_PAYMENT_DESTINATION_HASH_SECRET="your-payroll-destination-hmac-secret-minimum-32-characters-long"

# Migration deployment overrides (normally leave disabled; see the production migration runbook)
AQSTOQFLOW_DEPLOY_MIGRATIONS=0
AQSTOQFLOW_DATABASE_TARGET=""

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Security Settings
BCRYPT_ROUNDS=12
JWT_EXPIRATION="7d"
SESSION_MAX_AGE=604800

# Two-Factor Authentication
TWO_FACTOR_ISSUER="StockFlow"

# File Upload
UPLOADTHING_SECRET="your-uploadthing-secret"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# Monitoring & Logging
LOG_LEVEL="info"
SENTRY_DSN=""

# Feature Flags
ENABLE_GOOGLE_AUTH=true
ENABLE_TWO_FACTOR=true
ENABLE_AUDIT_LOGGING=true
# Governed Command Agent release and scheduled control-plane reconciliation
STOQUIFY_COMMAND_AGENT_KILL_SWITCH=1
STOQUIFY_COMMAND_AGENT_ROLLOUT="off"
STOQUIFY_COMMAND_AGENT_PILOT_ORG_IDS=""
STOQUIFY_COMMAND_AGENT_PILOT_ROLE_CODES=""
STOQUIFY_AGENT_RELEASE_ENVIRONMENT="local"
STOQUIFY_AGENT_RECONCILER_BASE_URL="https://your-production-like-stoquify-host.example"
STOQUIFY_AGENT_RECONCILER_SECRET="your-independent-reconciler-secret-minimum-32-characters-long"
STOQUIFY_AGENT_RECONCILER_SECRET_PREVIOUS=""
STOQUIFY_AGENT_RECONCILER_LEASE_MINUTES=10
STOQUIFY_AGENT_RECONCILER_TIMEOUT_MS=120000
STOQUIFY_AGENT_RECONCILER_MAX_ATTEMPTS=3
STOQUIFY_AGENT_RECONCILE_AFTER_MINUTES=15
STOQUIFY_AGENT_RECONCILE_LIMIT=100
STOQUIFY_AGENT_SCHEDULER_EVIDENCE_URL="https://your-scheduler-control-plane.example/stoquify-agent-runtime/deployment"
STOQUIFY_AGENT_SCHEDULER_EVIDENCE_SECRET="your-independent-scheduler-evidence-secret-minimum-32-characters-long"
STOQUIFY_AGENT_SCHEDULER_EVIDENCE_TIMEOUT_MS=20000
STOQUIFY_ASSURANCE_ALERT_WEBHOOK_URL=""
STOQUIFY_ASSURANCE_ALERT_WEBHOOK_SECRET=""
STOQUIFY_AGENT_ALERT_EVIDENCE_URL="https://your-alert-evidence-host.example/stoquify-agent-runtime"
STOQUIFY_AGENT_ALERT_EVIDENCE_SECRET="your-independent-alert-evidence-secret-minimum-32-characters-long"
STOQUIFY_AGENT_ALERT_EVIDENCE_TIMEOUT_MS=20000
STOQUIFY_AGENT_GOVERNANCE_EVIDENCE_URL="https://your-governance-authority.example/stoquify-agent-runtime"
STOQUIFY_AGENT_GOVERNANCE_EVIDENCE_SECRET="your-independent-governance-evidence-secret-minimum-32-characters-long"
STOQUIFY_AGENT_GOVERNANCE_EVIDENCE_TIMEOUT_MS=20000
STOQUIFY_AGENT_CI_RELEASE_EVIDENCE_URL="https://your-ci-attestation.example/stoquify-agent-runtime"
STOQUIFY_AGENT_CI_RELEASE_EVIDENCE_SECRET="your-independent-ci-release-evidence-secret-minimum-32-characters-long"
STOQUIFY_AGENT_CI_RELEASE_EVIDENCE_TIMEOUT_MS=20000
STOQUIFY_AGENT_CREDENTIAL_EVIDENCE_URL="https://your-security-authority.example/stoquify-agent-runtime/credential-rotation"
STOQUIFY_AGENT_CREDENTIAL_EVIDENCE_SECRET="your-independent-credential-evidence-secret-minimum-32-characters-long"
STOQUIFY_AGENT_CREDENTIAL_EVIDENCE_TIMEOUT_MS=20000
