# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
jest-cache*/
probe-cache/

# next.js
/.next/
/.next-dev/
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem
~$*

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.codex-tmp/
/.codex/
.tmp-*.txt

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env
example.env

# generated analysis artifacts
.graphify_*
**/graphify-out/cache/
ideas/**/outputs/
outputs/

# Separately versioned published site (has its own repository and remote).
/artifacts/stoquify-analytics-network-strategy-site/

# local runtime uploads
/public/uploads/
/public/seed-images/
/.next-item-media-test/
/.next-item-media-build/
/.next-item-media-test/
/.next-item-media-build/

# Synthetic development seed credentials (plaintext, local-only)
.seed-artifacts/
# Generated plaintext development credential handoff (explicitly requested;
# local-only even though it is stored beside the compliance document).
/docs/blockers-and-gates/Development database roles and passwords.docx
# playwright
/test-results/
/playwright-report/
/playwright/.auth/
/.next-modern-modules-integration/
/.next-modern-modules-integration/
/.next-modern-modules-build-*/
/.next-workflow-registration/

# Local approval signatures, personal verification records and controller enrollment.
/docs/X1/approval-register/records/
/docs/X1/approval-register/controllers/
/docs/X1/approval-register/events/
/docs/X1/approval-register/exports/
/docs/X1/approval-register/audit-head.json
/docs/X1/approval-register/register.json
/docs/X1/approval-register/FORMS.md
/docs/X1/approval-register/FORMS.pdf

# Prevent isolated evidence snapshots from recursively copying transaction history.
what-next/transaction-history/runs/*/isolated-workspace/**/what-next/transaction-history/
