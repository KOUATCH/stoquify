    "/[locale]/(dashboard)/error": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/[locale]/(dashboard)/error.js"
    ],
    "/[locale]/(dashboard)/loading": [
