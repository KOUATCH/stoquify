        "local.evidence.create",
        "local.evidence.read"
      ]
    },
    "independentVerifier": {
      "id": "local-sp://x1-independent-verifier",
      "displayName": "Stoquify X1 Local Independent Verifier",
      "permissions": [
        "local.approval.read",
        "local.evidence.read",
        "local.hash.verify"
      ]
    },
    "implementationCi": {
      "id": "local-sp://x1-implementation-ci",
