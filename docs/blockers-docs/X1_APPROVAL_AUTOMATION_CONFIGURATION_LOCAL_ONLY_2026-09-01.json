      "permissions": [
        "local.contract.read",
        "local.implementation.execute"
      ]
    }
  },
  "simulationControls": {
    "requiredEnvironmentVariable": "X1_ALLOW_LOCAL_SIMULATION=true",
    "allowedApplicationOrigins": [
      "http://127.0.0.1:3000",
      "http://localhost:3000"
