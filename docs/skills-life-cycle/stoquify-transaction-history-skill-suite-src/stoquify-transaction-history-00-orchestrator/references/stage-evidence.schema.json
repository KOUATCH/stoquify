{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stoquify.local/schemas/transaction-history-stage-evidence.schema.json",
  "title": "Stoquify Transaction History Stage Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "traceId",
    "runId",
    "sliceId",
    "stageId",
    "skillName",
    "agentType",
    "mode",
    "status",
    "activeLanes",
    "blockedLanes",
    "inputArtifacts",
    "inputFingerprint",
    "allowedEdits",
    "observedEdits",
    "repository",
    "claims",
    "verification",
    "outputs",
    "blockers",
    "nextEligibleStages",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "traceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^th-[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "sliceId": {
      "enum": ["foundation-inventory", "cash-payment", "ap-ar"]
    },
    "stageId": {
      "enum": ["00", "01", "02", "03", "04", "05", "06", "07"]
    },
    "skillName": {
      "type": "string",
      "pattern": "^stoquify-transaction-history-[0-9]{2}-[a-z0-9-]+$"
    },
    "agentType": {
      "enum": [
        "Software Architect",
        "Security Architect",
        "Bookkeeper & Controller",
        "Database Optimizer",
        "UX Architect",
        "Frontend Developer",
        "API Tester/Code Reviewer"
      ]
    },
    "mode": {
      "enum": ["audit", "implement", "verify"]
    },
    "status": {
      "enum": ["PASS", "PARTIAL", "BLOCKED", "FAILED", "STALE"]
    },
    "activeLanes": { "$ref": "#/$defs/lanes" },
    "blockedLanes": { "$ref": "#/$defs/lanes" },
    "inputArtifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/checksummedPath" }
    },
    "inputFingerprint": { "$ref": "#/$defs/sha256" },
    "allowedEdits": { "$ref": "#/$defs/pathList" },
    "observedEdits": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repoPath" }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headBefore", "headAfter", "dirtyFilesBefore", "dirtyFilesAfter"],
      "properties": {
        "headBefore": { "$ref": "#/$defs/gitCommit" },
        "headAfter": { "$ref": "#/$defs/gitCommit" },
        "dirtyFilesBefore": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "dirtyFilesAfter": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "result": { "enum": ["PASS", "GAP", "NA"] },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/repoPath" }
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "exitCode", "logPath"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "SKIPPED"] },
          "exitCode": { "type": ["integer", "null"] },
          "logPath": { "type": ["string", "null"] }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/checksummedPath" }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "reason"],
        "properties": {
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "code": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nextEligibleStages": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["01", "02", "03", "04", "05", "06", "07"] }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "pathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repoPath" }
    },
    "checksummedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "lanes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["workbench", "inventory", "cash", "payment", "ap", "ar"]
      }
    }
  }
}
