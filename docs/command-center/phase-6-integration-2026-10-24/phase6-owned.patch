+import "server-only";
+import { queueAssignmentNotice, visibleNotices } from "./notices";
+import { randomUUID } from "node:crypto";
+import { Prisma } from "@prisma/client";
+import { db } from "@/prisma/db";
+import { hasRbacPermission } from "@/lib/security/rbac-permissions";
+import {
+  BusinessRuleError,
+  ConflictError,
+} from "@/services/_shared/action-errors";
+import { deny, loadAuthority, moduleAllowed, type Identity } from "./authority";
+import {
+  canReadSource,
+  digest,
+  readSources,
+  sources,
+  sourceModulesAllowed,
+  type Observation,
+} from "./sources";
+import type {
+  Coordination,
+  Condition,
+  FollowUpQuery,
+  FollowUpCommand,
+  FollowUpData,
+  ReviewCommand,
+  SourceKey,
+} from "./contracts";
+
+type Occurrence = {
+  id: string;
+  organizationId: string;
+  logicalKey: string;
+  sourceKey: SourceKey;
+  sourceRefs: string[];
+  scopeKey: string;
+  windowKey: string;
+  episode: number;
+  sourceRevision: string;
+  revision: number;
+  condition: Condition;
+  coordination: Coordination;
+  ownerId: string | null;
+  dueAt: Date | null;
+  updatedAt: Date;
+};
+type ReviewState = { id: string; evidenceKey: string; revision: number };
+const conflict = () =>
+  new ConflictError(
+    "The source or follow-up changed. Refresh before trying again.",
+  );
+export async function inCoordinationTransaction<T>(
+  work: (tx: Prisma.TransactionClient) => Promise<T>,
+): Promise<T> {
+  try {
+    return await db.$transaction(work, {
+      isolationLevel: Prisma.TransactionIsolationLevel.Serializable,
+      maxWait: 10000,
+      timeout: 45000,
+    });
+  } catch (error) {
+    if (
+      error instanceof Prisma.PrismaClientKnownRequestError &&
+      ["P2034", "P2002"].includes(error.code)
+    )
+      throw conflict();
+    throw error;
+  }
+}
+async function latest(tx: Prisma.TransactionClient, org: string, key: string) {
+  const rows = await tx.$queryRaw<Occurrence[]>(
+    Prisma.sql`SELECT * FROM "command_center_occurrences" WHERE "organizationId"=${org} AND "logicalKey"=${key} ORDER BY "episode" DESC LIMIT 1 FOR UPDATE`,
+  );
+  return rows[0] ?? null;
+}
+async function event(
+  tx: Prisma.TransactionClient,
+  identity: Identity,
+  row: Occurrence,
+  type: string,
+  changes: unknown,
+  requestId: string | null = null,
+  intentHash: string | null = null,
