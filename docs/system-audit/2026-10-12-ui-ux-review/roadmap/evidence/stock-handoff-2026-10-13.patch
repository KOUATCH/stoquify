 function actionLink(input: BIActionLink): BIActionLink {
   return input
+}
+
+function ownerStockAction(id: string, actorPermissions: readonly string[] = []): BIActionLink {
+  const disabled = !["inventory.read", "inventory.items.read"].every(permission =>
+    hasRbacPermission(actorPermissions, permission),
+  )
+  return {
+    id,
+    label: "Open stock items",
+    href: OWNER_STOCK_WORKSPACE,
+    requiredPermission: "inventory.read",
+    additionalRequiredPermissions: ["inventory.items.read"],
+    moduleSlug: "inventory",
+    disabled,
+    disabledReason: disabled ? "Inventory item access is required to open this workspace." : null,
+  }
+}
+
+function actionDrillThrough(action: BIActionLink): BIDrillThrough {
+  const permissions = {
+    requiredPermission: action.requiredPermission,
+    ...(action.additionalRequiredPermissions ? { additionalRequiredPermissions: action.additionalRequiredPermissions } : {}),
+  }
+  if (action.disabled) {
+    return { available: false, type: "route", label: action.label, ...permissions, unavailableReason: action.disabledReason ?? "This workspace is unavailable." }
+  }
+  return { available: true, type: "route", label: action.label, href: action.href, ...permissions }
 }
 
