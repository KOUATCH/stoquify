+  "historical payroll run is explicitly disclosed as legacy partial evidence and cannot be represented as verified runtime proof.": "paie(s) historique(s) explicitement déclarée(s) comme preuve ancienne partielle, ne pouvant être présentée(s) comme preuve d’exécution vérifiée.",
+  "posted or paid payroll run is missing a ledger posting batch.": "paie(s) comptabilisée(s) ou payée(s) sans lot de comptabilisation au grand livre.",
+  "posted or paid payroll run is missing statutory component register proof in accounting evidence.": "paie(s) comptabilisée(s) ou payée(s) sans preuve du registre des composantes réglementaires dans les justificatifs comptables.",
+  "posted or paid payroll run is missing explicit certified HRIS readiness, payroll readiness, or engine input proof required for close evidence.": "paie(s) comptabilisée(s) ou payée(s) sans preuve explicite et certifiée de préparation RH, de préparation de paie ou des données du moteur requise pour la clôture.",
+  "posted or paid payroll run line lacks effective-dated allowance, benefit, leave, or overtime proof needed for certified close evidence.": "ligne(s) de paie comptabilisée(s) ou payée(s) sans justificatif daté d’applicabilité des indemnités, avantages, congés ou heures supplémentaires nécessaire à une clôture certifiée.",
+  "posted or paid payroll run line has no emitted payslip evidence for register tie-out.": "ligne(s) de paie comptabilisée(s) ou payée(s) sans bulletin émis pour la concordance du registre.",
+  "emitted payroll payslip has an empty document hash and cannot support certified close evidence.": "bulletin(s) de paie émis avec une empreinte documentaire vide, inutilisable(s) comme preuve de clôture certifiée.",
+  "paid payroll run has no settled payment batch for register tie-out.": "paie(s) payée(s) sans lot de paiement réglé pour la concordance du registre.",
+  "released or partially settled payroll payment batch is missing a ledger posting batch.": "lot(s) de paiement de paie libéré(s) ou partiellement réglé(s) sans lot de comptabilisation au grand livre.",
+  "posted payroll ledger batch is missing accounting source-link evidence.": "lot(s) de paie comptabilisé(s) sans preuve de lien source comptable.",
+  "fiscal document rejection needs correction or authority follow-up evidence.": "rejet(s) de document fiscal nécessitant une preuve de correction ou de suivi auprès de l’autorité.",
+  "fiscal document is queued or submitted but not certified yet.": "document(s) fiscal(aux) en attente ou soumis, mais pas encore certifié(s).",
+  "offline POS conflict requires manager review before certification or close.": "conflit(s) de caisse hors ligne nécessitant une revue du responsable avant certification ou clôture.",
+  "offline POS sync certificate is blocking close readiness.": "certificat(s) de synchronisation de caisse hors ligne bloquant la préparation à la clôture.",
+  "accepted offline POS event is still provisional and pending replay/certification.": "événement(s) accepté(s) de caisse hors ligne encore provisoire(s), en attente de reprise ou de certification.",
+}
+
+export function portalEvidenceText(value: string, locale: Locale): string {
+  if (locale !== "fr") return value
+  if (Object.prototype.hasOwnProperty.call(frenchEvidence, value)) return frenchEvidence[value]
+  if (/^\d+(?:\.\d+)?%$/.test(value)) return value.replace(".", ",").replace("%", "\u00a0%")
+  const count = /^(\d+) (.+)$/.exec(value)
+  if (count && Object.prototype.hasOwnProperty.call(countedFrenchEvidence, count[2])) {
+    return `${count[1]} ${countedFrenchEvidence[count[2]]}`
+  }
+  return value
+}
