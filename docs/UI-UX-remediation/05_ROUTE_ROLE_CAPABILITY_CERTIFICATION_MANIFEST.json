  "coveragePolicy": {
    "universalRule": "Every canonical protected route and action in the B-01 registry must map to exactly one owning module, at least one permitted capability fixture, at least one denied fixture, its declared route states, and a risk tier.",
    "aliasRule": "Aliases receive redirect and locale-preservation tests, not duplicate functional certification.",
    "changedRouteRule": "A change to a Tier-0 or Tier-1 route, shared primitive, contract, capability policy, formatter, or route-state renderer invalidates affected evidence and blocks merge until recertified.",
    "tier0": "Every commit affecting the surface; all supported locales, required browsers and viewports; automated accessibility plus manual AT at phase/release gate.",
    "tier1": "Every affected commit and every release candidate; all supported locales and themes, three browser engines, role/package allow-and-deny coverage.",
    "tier2": "At least one canonical success/state path per release candidate plus changed-route dimensions; rotate full route coverage every 30 days.",
    "evidenceFreshnessDays": {"tier0":14,"tier1":14,"tier2":30},
    "prohibitedEvidence": [
      "screenshots without route and fixture metadata",
      "dev-server timings represented as production performance",
      "a retry that discards the failed run",
      "UI visibility tests without server authorization tests",
      "automated accessibility as a substitute for manual assistive-technology validation"
    ]
  },
