{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stoquify:evaluation-result/v1",
  "title": "Stoquify Evaluation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "capability_id",
    "capability_version",
    "status",
    "evaluated_at",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string"
    },
    "capability_id": {
      "type": "string"
    },
    "capability_version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "PARTIAL",
        "INCONCLUSIVE",
        "NOT_TESTED"
      ]
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
