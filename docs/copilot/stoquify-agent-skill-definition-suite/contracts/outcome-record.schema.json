{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stoquify:outcome-record/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "capability_id",
    "terminal_status",
    "completed_at",
    "evidence_refs",
    "business_outcome"
  ],
  "properties": {
    "trace_id": {
      "type": "string"
    },
    "capability_id": {
      "type": "string"
    },
    "terminal_status": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "business_outcome": {
      "type": "object"
    },
    "user_correction": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "title": "Outcome Record v1"
}
