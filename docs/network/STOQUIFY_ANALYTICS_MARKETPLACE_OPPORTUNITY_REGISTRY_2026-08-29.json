  "kpi_definitions": [
    {
      "id": "KPI-CLOSING-CASH",
      "name": "Projected closing cash",
      "formula": "opening_cash + trusted_inflows - trusted_outflows",
      "owner": "Cash Command",
      "controls": ["currency_consistent", "source_deduplication", "coverage_state"]
    },
    {
      "id": "KPI-FORECAST-ERROR",
      "name": "Forecast error",
      "formula": "abs(actual - prior_forecast) / max(abs(actual), materiality_floor)",
      "owner": "Cash Command",
      "controls": ["forecast_version_binding", "actual_source_binding"]
    },
    {
      "id": "KPI-UNRECONCILED-EXPOSURE",
      "name": "Unreconciled exposure",
      "formula": "sum(unmatched_or_suspense_amounts_in_selected_scope)",
      "owner": "Payments Reconciliation",
      "controls": ["not_labeled_confirmed_loss", "provider_completeness"]
    },
    {
      "id": "KPI-SIGNED-RUN-COVERAGE",
      "name": "Signed reconciliation coverage",
      "formula": "signed_in_scope_amount / total_in_scope_amount",
      "owner": "Payments Reconciliation"
    },
    {
      "id": "KPI-INVENTORY-DAYS",
      "name": "Inventory days",
      "formula": "average_inventory_value / approved_daily_COGS",
      "owner": "Inventory and Accounting",
      "controls": ["approved_valuation", "posted_or_labeled_operational_COGS"]
    },
    {
      "id": "KPI-OPEN-COMMITMENT",
      "name": "Open purchase commitment",
      "formula": "sum(max(ordered_quantity - accepted_received_quantity, 0) * authoritative_unit_cost)",
      "owner": "Purchasing"
    },
    {
      "id": "KPI-DSO",
      "name": "Days sales outstanding",
      "formula": "average_accounts_receivable / credit_sales * days_in_period",
      "owner": "Accounting Receivables",
      "controls": ["credit_sales_only", "opening_balance_quality"]
    },
    {
      "id": "KPI-INVITE-ACCEPTANCE",
      "name": "Invite acceptance rate",
      "formula": "accepted_unique_invites / delivered_unique_invites",
      "owner": "Referrals",
      "controls": ["delivery_denominator", "unique_invite", "bot_filtering"]
    },
    {
      "id": "KPI-ACTIVATION",
      "name": "Referral activation rate",
      "formula": "organizations_reaching_activation / accepted_unique_invites",
      "owner": "Referrals and Onboarding"
    },
    {
      "id": "KPI-TIME-FIRST-TRUST",
      "name": "Time to first trusted value",
      "formula": "first_trusted_value_at - accepted_or_organization_created_at",
      "owner": "Growth Analytics",
      "controls": ["versioned_event_definition"]
    },
    {
      "id": "KPI-K-FACTOR",
      "name": "Viral coefficient",
      "formula": "invites_per_active_organization * invite_acceptance_rate * activation_rate",
      "owner": "Growth Analytics",
      "controls": ["retained_activation_reported_separately", "no_spam_incentive"]
    },
    {
      "id": "KPI-NO-REKEY",
      "name": "External completion without staff re-keying",
      "formula": "accepted_external_actions_without_manual_reentry / accepted_external_actions",
      "owner": "Collaboration"
    }
  ],
