model BusinessEvent {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  eventType     String
  eventSource   BusinessEventSource @default(INTERNAL)
  schemaVersion Int                 @default(1)
  status        BusinessEventStatus @default(RECORDED)

  idempotencyKey String
  payloadHash    String
  payload        Json
  correlationId  String?

  occurredAt  DateTime
  recordedAt  DateTime  @default(now())
  processedAt DateTime?
  failedAt    DateTime?

  actorId    String?
  locationId String?
  registerId String?
  deviceId   String?

  sourceType     AccountingSourceType?
  sourceId       String?
  postingBatchId String?
  documentHash   String?

  failureCode    String?
  failureMessage String?
  metadata       Json?

  outboxMessages   BusinessEventOutbox[]
  audits           BusinessEventAudit[]
  anomalies        BusinessEventAnomaly[]
  offlinePosEvents POSOfflineEvent[]
  reviewedPayrollRuns PayrollRun[] @relation("PayrollRunReviewedBusinessEvent")
  approvedPayrollRuns PayrollRun[] @relation("PayrollRunApprovedBusinessEvent")
  emittedPayrollRuns  PayrollRun[] @relation("PayrollRunEmittedBusinessEvent")
  postedPayrollRuns   PayrollRun[] @relation("PayrollRunPostedBusinessEvent")
  payrollRunTransition PayrollRunTransition? @relation("PayrollRunTransitionBusinessEvent")
  emittedPayrollPayslips PayrollPayslip[] @relation("PayrollPayslipEmittedBusinessEvent")
  decidedHrisTimeRequests HrisTimeRequest[] @relation("HrisTimeRequestDecisionBusinessEvent")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, eventSource, idempotencyKey])
  @@unique([organizationId, id])
  @@index([organizationId, eventType, occurredAt])
  @@index([organizationId, status, recordedAt])
  @@index([organizationId, sourceType, sourceId])
  @@index([organizationId, correlationId])
  @@index([payloadHash])
  @@map("business_events")
}

model BusinessEventOutbox {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  businessEventId String
