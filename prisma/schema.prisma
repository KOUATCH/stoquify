  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, tokenHash])
  @@unique([organizationId, jtiHash])
  @@index([organizationId, salesOrderId, status])
  @@index([organizationId, status, expiresAt])
