  paymentStatus PaymentStatus @default(PENDING)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdById String?
  createdBy   User?   @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])

  terminalId String?
  terminal   POSStation? @relation(fields: [terminalId], references: [id])

  sessionId String?
  session   POSSession? @relation(fields: [sessionId], references: [id])

  lines                         SalesOrderLine[]
  payments                      Payment[]
  publicReceiptAccessTokens     PublicReceiptAccessToken[]
  posCommitResults              POSCommitResult[]
  customerReceivableDocuments   CustomerReceivableDocument[]
  customerSettlementAllocations CustomerSettlementAllocation[]
  deliveryReservations          DeliveryReservation[]
  deliveryGoodsIssues           DeliveryGoodsIssue[]
  deliveryBillingOutcome        DeliveryBillingOutcome?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([organizationId, orderNumber])
  @@index([customerId])
  @@index([organizationId, orderDate]) // hot: daily reports
  @@index([organizationId, locationId, orderDate]) // hot: location-scoped daily
  @@index([organizationId, status, orderDate])
  @@index([organizationId, channel, status, orderDate])
  @@index([organizationId, paymentStatus])
  @@index([locationId])
  @@map("sales_orders")
}

enum SalesOrderChannel {
  POS
  DELIVERY
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  RETURNED
}

model PublicReceiptAccessToken {
