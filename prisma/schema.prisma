/// Append-only evidence for independently authorized payroll lifecycle stages.
/// Runtime rows are complete; historical bridge rows remain explicitly partial.
model PayrollRunTransition {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [organizationId, payrollRunId], references: [organizationId, id], onDelete: Restrict)

  sequence    Int
  fromStatus  PayrollRunStatus?
  toStatus    PayrollRunStatus
  fromVersion Int?
  toVersion   Int?

  actorId       String?
  transitionedAt DateTime?

  businessEventId String?
  businessEvent   BusinessEvent? @relation("PayrollRunTransitionBusinessEvent", fields: [organizationId, businessEventId], references: [organizationId, id], onDelete: Restrict)

  idempotencyKey String?
  payloadHash    String?
  origin         PayrollRunTransitionOrigin         @default(RUNTIME)
  evidenceStatus PayrollRunTransitionEvidenceStatus @default(VERIFIED)
  legacyNote     String?
  metadata       Json?

  createdAt DateTime @default(now())

  @@unique([organizationId, payrollRunId, sequence])
  @@unique([organizationId, payrollRunId, toStatus])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, businessEventId])
  @@index([organizationId, payrollRunId, createdAt])
  @@index([organizationId, toStatus, transitionedAt])
  @@map("payroll_run_transitions")
}

