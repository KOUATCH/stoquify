  stockAdjustments                  StockAdjustment[]
  stockTransfers                    StockTransfer[]
  goodsReceipts                     GoodsReceipt[]
  goodsReceiptInspections           GoodsReceiptInspection[]
  goodsReceiptInspectionResolutions GoodsReceiptInspectionResolution[]
  inventoryTransactions             InventoryTransaction[]
  serialNumbers                     SerialNumber[]
  posStations                       POSStation[]
  dailySalesReports                 DailySalesReport[]
  payments                          Payment[]

  expenseCategories                       ExpenseCategory[]
  expenses                                Expense[]
  customerLedgerEntries                   CustomerLedgerEntry[]
  customerReceivableDocuments             CustomerReceivableDocument[]
  customerReceivableDocumentStates        CustomerReceivableDocumentState[]
  customerStatementSnapshots              CustomerStatementSnapshot[]
  customerStatementAccessTokens           CustomerStatementAccessToken[]
  customerStatementAccessLogs             CustomerStatementAccessLog[]
  customerStatementRecipientActions       CustomerStatementRecipientAction[]
  customerStatementRecipientActionStates  CustomerStatementRecipientActionState[]
  customerStatementDeliveries             CustomerStatementDelivery[]
  customerStatementDeliveryStates         CustomerStatementDeliveryState[]
  supplierPoEnvelopes                     SupplierPoEnvelope[]
  supplierPoAccessTokens                  SupplierPoAccessToken[]
  supplierPoAccessLogs                    SupplierPoAccessLog[]
  supplierPoProposals                     SupplierPoProposal[]
  supplierPoProposalLines                 SupplierPoProposalLine[]
  supplierPoProposalStates                SupplierPoProposalState[]
  referralAttributions                    ReferralAttribution[]
  referralAttributionEvents               ReferralAttributionEvent[]               @relation("ReferralAttributionSourceOrganization")
  referralConversionEvents                ReferralAttributionEvent[]               @relation("ReferralAttributionTargetOrganization")
  accountantClientInvites                 AccountantClientInvite[]
  accountantClientInviteStates            AccountantClientInviteState[]
  customerSettlements                     CustomerSettlement[]
  customerSettlementAllocations           CustomerSettlementAllocation[]
  supplierLedgerEntries                   SupplierLedgerEntry[]
  accountingSettings                      OrganizationAccountingSettings?
  fiscalYears                             FiscalYear[]
  accountingPeriods                       AccountingPeriod[]
  chartOfAccounts                         ChartOfAccount[]
  journals                                Journal[]
  journalEntries                          JournalEntry[]
  journalEntryLines                       JournalEntryLine[]
  ledgerPostingBatches                    LedgerPostingBatch[]
  accountingSourceLinks                   AccountingSourceLink[]
  postingRules                            PostingRule[]
  postingRuleLines                        PostingRuleLine[]
  ledgerAuditEvents                       LedgerAuditEvent[]
  businessEvents                          BusinessEvent[]
  businessEventOutbox                     BusinessEventOutbox[]
  businessEventAudits                     BusinessEventAudit[]
  businessEventAnomalies                  BusinessEventAnomaly[]
  auditLogs                               AuditLog[]
  branchDailyCloseRuns                    BranchDailyCloseRun[]
  branchDailyCloseSignOffs                BranchDailyCloseSignOff[]
  cashShortagePolicies                    CashShortagePolicy[]
  posCashShortageWorkerCheckpoints        PosCashShortageWorkerCheckpoint[]
  publicReceiptAccessTokens               PublicReceiptAccessToken[]
  posOfflineDevices                       POSOfflineDevice[]
  posOfflineSyncBatches                   POSOfflineSyncBatch[]
  posOfflineEvents                        POSOfflineEvent[]
  posOfflineSyncConflicts                 POSOfflineSyncConflict[]
  posOfflineSyncCertificates              POSOfflineSyncCertificate[]
  posCommitResults                        POSCommitResult[]
  payrollEmployees                        PayrollEmployee[]
  hrisOrgUnits                            HrisOrgUnit[]
  hrisPositions                           HrisPosition[]
  hrisEmploymentAssignments               HrisEmploymentAssignment[]
  hrisReportingRelationships              HrisReportingRelationship[]
  hrisManagerDelegations                  HrisManagerDelegation[]
  hrisWorkCalendars                       HrisWorkCalendar[]
  hrisPublicHolidays                      HrisPublicHoliday[]
  hrisWorkSchedules                       HrisWorkSchedule[]
  hrisLeavePolicies                       HrisLeavePolicy[]
  hrisLeaveBalanceEntries                 HrisLeaveBalanceEntry[]
  hrisTimeRequests                        HrisTimeRequest[]
  hrisTimeImportBatches                   HrisTimeImportBatch[]
  hrisTimeEntries                         HrisTimeEntry[]
  hrisAttendanceAnomalies                 HrisAttendanceAnomaly[]
  payrollContracts                        PayrollContract[]
  payrollRubriques                        PayrollRubrique[]
  payrollRubriqueAssignments              PayrollEmployeeRubriqueAssignment[]
  payrollSalaryChangeRequests             PayrollSalaryChangeRequest[]
  payrollPaymentDestinationChangeRequests PayrollPaymentDestinationChangeRequest[]
  payrollPeriods                          PayrollPeriod[]
  payrollAttendanceSnapshots              PayrollAttendanceSnapshot[]
  payrollRuns                             PayrollRun[]
  payrollRunTransitions                   PayrollRunTransition[]
  payrollRunLines                         PayrollRunLine[]
  payrollPayslips                         PayrollPayslip[]
  payrollPayslipLines                     PayrollPayslipLine[]
  payrollDeclarations                     PayrollDeclaration[]
  payrollDeclarationEvidence              PayrollDeclarationEvidence[]
  payrollPaymentBatches                   PayrollPaymentBatch[]
  payrollPaymentAllocations               PayrollPaymentAllocation[]
  payrollEmployeeBalanceCases             PayrollEmployeeBalanceCase[]
  payrollEmployeeBalanceEvents            PayrollEmployeeBalanceEvent[]
  paymentRails                            PaymentRail[]
  providerAccounts                        ProviderAccount[]
  settlementAccounts                      SettlementAccount[]
  providerEvents                          ProviderEvent[]
  statementFiles                          StatementFile[]
  statementLines                          StatementLine[]
  paymentTransactions                     PaymentTransaction[]
  matchRecords                            MatchRecord[]
  suspenseItems                           SuspenseItem[]
  reconciliationRuns                      ReconciliationRun[]
  paymentExceptions                       PaymentException[]
  reconciliationInbox                     PaymentReconciliationInboxItem[]
  closeRuns                               CloseRun[]
  closeChecklistItems                     CloseChecklistItem[]
  closeAssuranceFindings                  CloseAssuranceFinding[]
  closeEvidenceItems                      CloseEvidenceItem[]
  closePackExports                        ClosePackExport[]
  accountantReviews                       AccountantReview[]
  accountantComments                      AccountantComment[]
  accountantAccessGrants                  AccountantAccessGrant[]
  fiscalDocuments                         FiscalDocument[]
  fiscalDocumentLines                     FiscalDocumentLine[]
  fiscalSequences                         FiscalSequence[]
  documentSequences                       DocumentSequence[]
  complianceSubmissions                   ComplianceSubmission[]
  complianceAdapterConfigs                ComplianceAdapterConfig[]
  complianceEvidence                      ComplianceEvidence[]
  stockCountSessions                      StockCountSession[]
  supplierBankAccounts                    SupplierBankAccount[]
  supplierBankChanges                     SupplierBankChangeRequest[]
  supplierInvoices                        SupplierInvoice[]
  supplierInvoiceLines                    SupplierInvoiceLine[]
  supplierInvoiceMatchExceptions          SupplierInvoiceMatchException[]
  purchaseReturns                         PurchaseReturn[]
  purchaseReturnLines                     PurchaseReturnLine[]
  supplierCreditNotes                     SupplierCreditNote[]
  supplierCreditNoteLines                 SupplierCreditNoteLine[]
  threeWayMatches                         ThreeWayMatch[]
  supplierPayments                        SupplierPayment[]
  supplierPaymentAllocations              SupplierPaymentAllocation[]
  workflowAssuranceCheckRuns              WorkflowAssuranceCheckRun[]
  workflowAssuranceCheckFindings          WorkflowAssuranceCheckFinding[]
  workflowAssuranceIncidents              WorkflowAssuranceIncident[]
  workflowAssuranceIncidentEvents         WorkflowAssuranceIncidentEvent[]
  workflowAssuranceAlertDeliveries        WorkflowAssuranceAlertDelivery[]
  workflowAssuranceWaivers                WorkflowAssuranceWaiver[]
  agentRuns                               AgentRun[]
  agentFeedback                           AgentFeedback[]
  agentCostLedger                         AgentCostLedger[]
  agentPolicyIncidents                    AgentPolicyIncident[]
  aiActionProposals                       AiActionProposal[]
  agentActivationPackages                 AgentActivationPackage[]
  onboardingImportMappings                OnboardingImportMapping[]
  onboardingImportBatches                 OnboardingImportBatch[]
  onboardingImportRows                    OnboardingImportRow[]
  onboardingImportIssues                  OnboardingImportIssue[]
  onboardingReadinessMilestones           OnboardingReadinessMilestone[]

  @@unique([slug])
  @@index([slug])
  @@index([isActive, deletedAt])
  @@map("organizations")
}

model Invite {
  id             String       @id @default(cuid())
  // Opaque 64-char hex token (32 bytes) used as the ONLY identifier in the
  // invite URL. Replaces the previous pattern of putting orgId+roleId+email
  // in the query string, which let recipients self-promote by editing the URL.
  token          String       @unique
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Role to assign on redemption — stored at invite time so the redeemer
  // cannot forge it. FK to a Role row scoped to this organisation.
  roleId         String
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([email, organizationId])
  @@index([email])
  @@index([organizationId, status])
  @@index([token, status]) // hot path: redeem flow
  @@map("invites")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model Location {
  id   String       @id @default(cuid())
  name String // tenant-specific naming (proper noun), no i18n needed
  code String
  type LocationType @default(WAREHOUSE)

  address   String?
  phone     String?
  email     String?
  isActive  Boolean   @default(true)
  isDefault Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  managerId String?
  manager   User?   @relation("LocationManager", fields: [managerId], references: [id])

  allowNegativeStock Boolean @default(false)
  requiresApproval   Boolean @default(false)

  inventoryLevels            InventoryLevel[]
  inventoryTransactions      InventoryTransaction[]
  transfersFrom              StockTransfer[]             @relation("TransferFrom")
  transfersTo                StockTransfer[]             @relation("TransferTo")
  purchaseOrders             PurchaseOrder[]
  salesOrders                SalesOrder[]
  customerLocations          CustomerLocation[]
  stockAdjustments           StockAdjustment[]
  goodsReceipts              GoodsReceipt[]
  posStations                POSStation[]
  cashDrawers                CashDrawer[]
  dailySalesReports          DailySalesReport[]
  posSessions                POSSession[]
  posOfflineDevices          POSOfflineDevice[]
  posOfflineEvents           POSOfflineEvent[]
  posOfflineSyncCertificates POSOfflineSyncCertificate[]
  posCommitResults           POSCommitResult[]
  expenses                   Expense[]
  serialNumbers              SerialNumber[]
  stockCountSessions         StockCountSession[]
  stockCountLines            StockCountLine[]
  branchDailyCloseRuns       BranchDailyCloseRun[]
  hrisPositions              HrisPosition[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, type, isActive])
  @@map("locations")
}

enum LocationType {
  WAREHOUSE
  STORE
  DISTRIBUTION_CENTER
  SUPPLIER
  CUSTOMER
  MANUFACTURING
  QUARANTINE
  DAMAGED
  TRANSIT
  VIRTUAL
}

enum BranchDailyCloseRunStatus {
  IN_REVIEW
  BLOCKED
}

model BranchDailyCloseRun {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  businessDate DateTime                  @db.Date
  periodStart  DateTime
  periodEnd    DateTime
  status       BranchDailyCloseRunStatus

  readinessState        String @db.VarChar(32)
  evidenceCoverageState String @db.VarChar(16)
  supportedItemCount    Int
  unsupportedItemCount  Int
  blockerCount          Int

  evidenceObservedAt  DateTime
  readinessSourceHash String   @db.VarChar(71)
  evidenceHash        String   @db.VarChar(71)
  evidenceManifest    Json

  startedById String
  startedBy   User     @relation("BranchDailyCloseStartedBy", fields: [startedById], references: [id], onDelete: Restrict)
  startedAt   DateTime

  idempotencyKey String @db.VarChar(200)
  requestHash    String @db.VarChar(71)
  correlationId  String @db.VarChar(200)

  signOffs BranchDailyCloseSignOff[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, locationId, businessDate])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, id])
  @@index([organizationId, status, businessDate])
  @@index([organizationId, locationId, status, businessDate])
  @@index([startedById])
  @@index([correlationId])
  @@map("branch_daily_close_runs")
}

enum BranchDailyCloseSignOffStatus {
  ACTIVE
  REVOKED
  SUPERSEDED
}

model BranchDailyCloseSignOff {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  branchDailyCloseRunId String
  branchDailyCloseRun   BranchDailyCloseRun @relation(fields: [organizationId, branchDailyCloseRunId], references: [organizationId, id], onDelete: Restrict)

  status    BranchDailyCloseSignOffStatus @default(ACTIVE)
  activeKey String?                       @db.VarChar(200)

  signedReadinessSourceHash String   @db.VarChar(71)
  signedEvidenceHash        String   @db.VarChar(71)
  signedEvidenceObservedAt  DateTime

  signedById String
  signedBy   User     @relation("BranchDailyCloseSignedBy", fields: [signedById], references: [id], onDelete: Restrict)
  signedAt   DateTime

  authAssuranceLevel String   @db.VarChar(2)
  freshAuthAt        DateTime

  invalidatedById    String?
  invalidatedBy      User?     @relation("BranchDailyCloseInvalidatedBy", fields: [invalidatedById], references: [id], onDelete: Restrict)
  invalidatedAt      DateTime?
  invalidationReason String?   @db.VarChar(500)

  supersedesSignOffId  String?
  supersedesSignOff    BranchDailyCloseSignOff?  @relation("BranchDailyCloseSignOffSupersession", fields: [organizationId, supersedesSignOffId], references: [organizationId, id], onDelete: Restrict)
  supersededBySignOffs BranchDailyCloseSignOff[] @relation("BranchDailyCloseSignOffSupersession")

  idempotencyKey String @db.VarChar(200)
  requestHash    String @db.VarChar(71)
  correlationId  String @db.VarChar(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, activeKey])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, branchDailyCloseRunId, status, signedAt])
  @@index([signedById])
  @@index([invalidatedById])
  @@index([supersedesSignOffId])
  @@index([correlationId])
  @@map("branch_daily_close_sign_offs")
}

// ============================================================
// PRODUCT CATALOG (i18n applied)
// ============================================================

model Category {
  id   String @id @default(cuid())
  slug String

  // Bilingual
  titleEn       String
  titleFr       String?
  descriptionEn String?
  descriptionFr String?

  imageUrl       String?
  parentId       String?
  parent         Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[]   @relation("CategoryHierarchy")
  isActive       Boolean      @default(true)
  deletedAt      DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          Item[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, parentId])
  @@index([organizationId, isActive, deletedAt])
  @@map("categories")
}

model Brand {
  id   String @id @default(cuid())
  slug String

  // Bilingual brand name. Many brands ARE proper nouns ("Coca-Cola", "Samsung")
  // and will use the same nameEn / nameFr value, but markets with localized
  // brand names (e.g. KFC → PFK in Québec) need this column pair to differ.
  nameEn String
  nameFr String?

  // Description can also vary by language
  descriptionEn String?
  descriptionFr String?

  logoUrl        String?
  isActive       Boolean      @default(true)
  deletedAt      DateTime?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          Item[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("brands")
}

model Unit {
  id     String   @id @default(cuid())
  symbol String // e.g. "kg" — same in both languages
  type   UnitType @default(QUANTITY)

  // Bilingual full name
  nameEn String // e.g. "kilogram"
  nameFr String? // e.g. "kilogramme"

  baseUnit       String? // For conversions
  conversionRate Decimal? @db.Decimal(18, 6) // Rate to base unit
  isActive       Boolean  @default(true)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          Item[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, symbol])
  @@unique([organizationId, nameEn])
  @@index([organizationId])
  @@map("units")
}

enum UnitType {
  QUANTITY
  WEIGHT
  VOLUME
  LENGTH
  AREA
  TIME
}

model TaxRate {
  id   String  @id @default(cuid())
  rate Decimal @db.Decimal(6, 3) // e.g., 19.250 for VAT
  type TaxType @default(SALES)

  // Bilingual display name
  nameEn String // e.g. "VAT 19.25%"
  nameFr String? // e.g. "TVA 19,25%"

  isActive       Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          Item[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, nameEn])
  @@index([organizationId])
  @@map("tax_rates")
}

enum TaxType {
  SALES
  VAT
  GST
  EXCISE
  IMPORT
  EXPORT
}

model Item {
  id      String  @id @default(cuid())
  slug    String
  sku     String
  barcode String?

  // Bilingual
  nameEn        String
  nameFr        String?
  descriptionEn String?
  descriptionFr String?

  imageUrls String[] // Postgres native array, not JSON string
  thumbnail String?

  // Product identifiers
  upc  String?
  ean  String?
  mpn  String?
  isbn String?

  // Physical properties
  dimensions String?
  weight     Decimal? @db.Decimal(12, 3)
  color      String?
  size       String?

  // Pricing
  costPrice    Decimal  @default(0) @db.Decimal(12, 2)
  sellingPrice Decimal  @default(0) @db.Decimal(12, 2)
  msrp         Decimal? @db.Decimal(12, 2)

  // Inventory settings
  trackInventory     Boolean  @default(true)
  trackSerialNumbers Boolean  @default(false)
  trackBatches       Boolean  @default(false)
  trackExpiry        Boolean  @default(false)
  minStockLevel      Decimal  @default(0) @db.Decimal(12, 3)
  maxStockLevel      Decimal? @db.Decimal(12, 3)
  reorderLevel       Decimal  @default(0) @db.Decimal(12, 3)
  reorderQuantity    Decimal? @db.Decimal(12, 3)

  // Status
  isActive       Boolean   @default(true)
  isDiscontinued Boolean   @default(false)
  deletedAt      DateTime?

  // Relationships
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])

  taxRateId String?
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id])

  // Inventory and transactions
  inventoryLevels       InventoryLevel[]
  inventoryTransactions InventoryTransaction[]
  serialNumbers         SerialNumber[]

  // Supplier relationships
  supplierItems ItemSupplier[]

  // Order lines
  purchaseOrderLines   PurchaseOrderLine[]
  salesOrderLines      SalesOrderLine[]
  adjustmentLines      StockAdjustmentLine[]
  transferLines        StockTransferLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  supplierInvoiceLines SupplierInvoiceLine[]
  stockCountLines      StockCountLine[]

  // Reporting snapshots
  dailySalesReportItems DailySalesReportItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Uniqueness: SKU and barcode (when set) must be unique per org.
  // Name is NOT unique — two items can share a name briefly (e.g. variants
  // mid-data-entry) and that's legitimate.
  @@unique([organizationId, sku])
  @@unique([organizationId, slug])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([barcode]) // POS scanner lookup
  @@index([organizationId, isActive, deletedAt]) // hot path: list active items
  @@index([organizationId, categoryId, deletedAt]) // hot path: browse by category
  @@index([organizationId, brandId])
  @@map("items")
}

// ============================================================
// INVENTORY
// ============================================================

model InventoryLevel {
  id         String   @id @default(cuid())
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // Current quantities
  quantityOnHand    Decimal @default(0) @db.Decimal(12, 3)
  quantityReserved  Decimal @default(0) @db.Decimal(12, 3)
  quantityAvailable Decimal @default(0) @db.Decimal(12, 3)
  quantityInTransit Decimal @default(0) @db.Decimal(12, 3)
  quantityOnOrder   Decimal @default(0) @db.Decimal(12, 3)
  reorderPoint      Decimal @default(0) @db.Decimal(12, 3)

  // Valuation (weighted average cost)
  averageCost Decimal @default(0) @db.Decimal(12, 2)
  totalValue  Decimal @default(0) @db.Decimal(14, 2)

  // Optimistic locking — increment on every update, fail if mismatched.
  // Prevents oversell when two POS terminals sell the last unit simultaneously.
  version Int @default(0)

  // Last updated
  lastCountDate     DateTime?
  lastTransactionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([itemId, locationId])
  @@index([itemId])
  @@index([locationId])
  @@map("inventory_levels")
}

model InventoryTransaction {
  id             String                             @id @default(cuid())
  type           TransactionType
  quantity       Decimal                            @db.Decimal(12, 3) // signed: + inbound, - outbound
  unitCost       Decimal                            @default(0) @db.Decimal(12, 2)
  totalCost      Decimal                            @default(0) @db.Decimal(14, 2)
  notes          String?
  effectiveAt    DateTime
  recordedAt     DateTime
  timeProvenance InventoryTransactionTimeProvenance
  createdAt      DateTime                           @default(now())

  itemId     String
  item       Item     @relation(fields: [itemId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdById    String?
  createdBy      User?        @relation("TransactionCreatedBy", fields: [createdById], references: [id])

  // Reference tracking
  referenceType   TransactionReferenceType?
  referenceId     String?
  referenceNumber String?

  // Batch and serial tracking
  batchNumber   String?
  serialNumbers String[]
  expiryDate    DateTime?

  balanceAfter Decimal @db.Decimal(12, 3)

  reversalOfTransactionId String?               @unique
  reversalOfTransaction   InventoryTransaction? @relation("InventoryTransactionReversal", fields: [reversalOfTransactionId], references: [id], onDelete: Restrict)
  reversedByTransaction   InventoryTransaction? @relation("InventoryTransactionReversal")

  @@index([itemId])
  @@index([locationId])
  @@index([organizationId, createdAt]) // hot: org-scoped time-range
  @@index([itemId, createdAt]) // hot: item history
  @@index([organizationId, effectiveAt, recordedAt, id])
  @@index([organizationId, recordedAt, id])
  @@index([type])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

enum InventoryTransactionTimeProvenance {
  EXPLICIT_SOURCE_TIME
  LEGACY_CREATED_AT_APPROXIMATION
}

enum TransactionType {
  // Inbound
  PURCHASE_RECEIPT
  PURCHASE_RETURN_REVERSAL
  SALES_RETURN
  TRANSFER_IN
  ADJUSTMENT_IN
  // Legacy evidence code retained for historical inventory movements; no active BOM module.
  PRODUCTION_IN
  INITIAL_STOCK

  // Outbound
  SALE
  PURCHASE_RETURN
  TRANSFER_OUT
  ADJUSTMENT_OUT
  // Legacy evidence code retained for historical inventory movements; no active BOM module.
  PRODUCTION_OUT
  DAMAGED
  EXPIRED
  THEFT
  WRITE_OFF
  SAMPLE
  PROMOTION

  // Reservations
  RESERVATION
  RESERVATION_RELEASE
}

enum TransactionReferenceType {
  SALES_ORDER
  PURCHASE_ORDER
  STOCK_TRANSFER
  STOCK_ADJUSTMENT
  GOODS_RECEIPT
  // Legacy evidence reference retained for historical traceability; no active BOM module.
  PRODUCTION_BATCH
  RETURN
  MANUAL
}

model SerialNumber {
  id           String       @id @default(cuid())
  serialNumber String
  status       SerialStatus @default(AVAILABLE)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  // Now a proper relation (was a dangling string before)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // Scoped to org so SN lookups never leak across tenants
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  batchNumber String?
  expiryDate  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([organizationId, serialNumber]) // unique per org, not globally
  @@index([itemId])
  @@index([organizationId, status])
  @@map("serial_numbers")
}

enum SerialStatus {
  AVAILABLE
  RESERVED
  SOLD
  DAMAGED
  RETURNED
  EXPIRED
}

// ============================================================
// SUPPLIERS
// ============================================================

model Supplier {
  id            String   @id @default(cuid())
  name          String // legal/business name, no i18n
  code          String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  country       String?
  taxId         String?
  paymentTerms  Int?     @default(30)
  creditLimit   Decimal? @db.Decimal(14, 2)
  notes         String?
  isActive      Boolean  @default(true)

  // Supplier's preferred language for POs/emails
  preferredLocale Locale @default(EN)

  // Running balance (positive = we owe them)
  currentBalance Decimal @default(0) @db.Decimal(14, 2)

  deletedAt DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supplierItems              ItemSupplier[]
  purchaseOrders             PurchaseOrder[]
  purchaseReturns            PurchaseReturn[]
  supplierCreditNotes        SupplierCreditNote[]
  expenses                   Expense[]
  ledgerEntries              SupplierLedgerEntry[]
  bankAccounts               SupplierBankAccount[]
  bankChanges                SupplierBankChangeRequest[]
  supplierInvoices           SupplierInvoice[]
  supplierPayments           SupplierPayment[]
  poAcknowledgementEnvelopes SupplierPoEnvelope[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, isActive, deletedAt])
  @@map("suppliers")
}

model ItemSupplier {
  id               String    @id @default(cuid())
  itemId           String
  item             Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierSku      String?
  supplierName     String?
  isPreferred      Boolean   @default(false)
  leadTimeDays     Int?
  minOrderQuantity Decimal?  @db.Decimal(12, 3)
  unitCost         Decimal?  @db.Decimal(12, 2)
  lastPurchaseDate DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([itemId, supplierId])
  @@index([supplierId])
  @@map("item_suppliers")
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id           String   @id @default(cuid())
  name         String // person/business name, no i18n
  code         String?
  email        String?
  phone        String?
  address      String?
  taxId        String?
  creditLimit  Decimal? @db.Decimal(14, 2)
  paymentTerms Int?     @default(30)
  notes        String?
  isActive     Boolean  @default(true)

  // Customer's preferred language — drives receipt printing & SMS language
  preferredLocale Locale @default(EN)

  // Running balance (positive = they owe us)
  currentBalance Decimal @default(0) @db.Decimal(14, 2)

  deletedAt DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  locationAssignments CustomerLocation[]
  salesOrders         SalesOrder[]
  ledgerEntries       CustomerLedgerEntry[]
  receivableDocuments CustomerReceivableDocument[]
  statementSnapshots  CustomerStatementSnapshot[]
  settlements         CustomerSettlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, isActive, deletedAt])
  @@index([email])
  @@index([phone])
  @@map("customers")
}

enum CustomerLocationSource {
  HISTORICAL_SALE
  POS_CREATION
  MANUAL
}

model CustomerLocation {
  id             String                 @id @default(cuid())
  organizationId String
  customerId     String
  locationId     String
  source         CustomerLocationSource @default(MANUAL)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Cascade)
  location     Location     @relation(fields: [organizationId, locationId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, customerId, locationId])
  @@index([organizationId, locationId, customerId])
  @@index([organizationId, customerId])
  @@map("customer_locations")
}

// ============================================================
// GOVERNED MASTER-DATA ONBOARDING
// ============================================================

enum OnboardingImportTarget {
  CUSTOMER
  SUPPLIER
  ITEM
}

enum OnboardingImportStatus {
  UPLOADED
  VALIDATED
  BLOCKED
  APPROVED
  COMMITTING
  COMMITTED
}

enum OnboardingImportIssueSeverity {
  ERROR
  WARNING
}

enum OnboardingImportRiskLevel {
  STANDARD
  HIGH
}

enum OnboardingReadinessState {
  NOT_STARTED
  IMPORTED
  RECONCILED
  BLOCKED
  WAIVED
}

model OnboardingImportMapping {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  target         OnboardingImportTarget
  version        Int
  schemaVersion  String                 @default("1")
  fieldMap       Json
  requiredFields String[]
  createdById    String
  createdAt      DateTime               @default(now())

  batches OnboardingImportBatch[]

  @@unique([organizationId, target, version])
  @@index([organizationId, target, createdAt])
  @@map("onboarding_import_mappings")
}

model OnboardingImportBatch {
  id                        String                    @id @default(cuid())
  organizationId            String
  organization              Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  target                    OnboardingImportTarget
  status                    OnboardingImportStatus    @default(UPLOADED)
  sourceFilename            String
  sourceMimeType            String
  sourceByteSize            Int
  contentHash               String
  mappingId                 String
  mapping                   OnboardingImportMapping   @relation(fields: [mappingId], references: [id], onDelete: Restrict)
  mappingVersion            Int
  schemaVersion             String
  sourceRecordCount         Int                       @default(0)
  validRecordCount          Int                       @default(0)
  errorRecordCount          Int                       @default(0)
  duplicateRecordCount      Int                       @default(0)
  riskLevel                 OnboardingImportRiskLevel @default(STANDARD)
  riskReasons               String[]
  sourceRequiredFieldTotals Json
  preCommitRecordCount      Int?
  postCommitRecordCount     Int?
  destinationRequiredTotals Json?
  committedRecordCount      Int                       @default(0)
  uploadedById              String
  uploadedAt                DateTime                  @default(now())
  validatedAt               DateTime?
  approvedById              String?
  approvedAt                DateTime?
  approvalDigest            String?
  commitStartedAt           DateTime?
  committedAt               DateTime?
  replayCount               Int                       @default(0)
  lastReplayedAt            DateTime?
  evidenceManifest          Json?
  evidenceHash              String?
  lastSafeErrorCode         String?
  retentionExpiresAt        DateTime
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  rows   OnboardingImportRow[]
  issues OnboardingImportIssue[]

  @@unique([organizationId, target, contentHash, mappingVersion])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, target, createdAt])
  @@index([organizationId, riskLevel, status, createdAt])
  @@map("onboarding_import_batches")
}

model OnboardingImportRow {
  id                String                @id @default(cuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchId           String
  batch             OnboardingImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber         Int
  sourceRowHash     String
  businessKey       String?
  normalizedData    Json
  valid             Boolean               @default(false)
  commitAttemptedAt DateTime?
  committedRecordId String?
  committedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  issues OnboardingImportIssue[]

  @@unique([batchId, rowNumber])
  @@index([organizationId, batchId, businessKey])
  @@index([batchId, committedRecordId])
  @@map("onboarding_import_rows")
}

model OnboardingImportIssue {
  id             String                        @id @default(cuid())
  organizationId String
  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchId        String
  batch          OnboardingImportBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowId          String?
  row            OnboardingImportRow?          @relation(fields: [rowId], references: [id], onDelete: Cascade)
  rowNumber      Int
  field          String?
  severity       OnboardingImportIssueSeverity @default(ERROR)
  code           String
  safeMessage    String
  createdAt      DateTime                      @default(now())

  @@index([organizationId, batchId, severity])
  @@index([batchId, rowNumber])
  @@map("onboarding_import_issues")
}

model OnboardingReadinessMilestone {
  id                String                   @id @default(cuid())
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  target            OnboardingImportTarget
  state             OnboardingReadinessState @default(NOT_STARTED)
  evidenceBatchId   String?
  sourceRecordCount Int                      @default(0)
  committedCount    Int                      @default(0)
  blockerCount      Int                      @default(0)
  waivedById        String?
  waivedAt          DateTime?
  waiverReason      String?
  updatedAt         DateTime                 @updatedAt
  createdAt         DateTime                 @default(now())

  @@unique([organizationId, target])
  @@index([organizationId, state])
  @@map("onboarding_readiness_milestones")
}

// ============================================================
// PURCHASE ORDERS
// ============================================================

model PurchaseOrder {
  id                   String              @id @default(cuid())
  orderNumber          String // per-org unique, not globally
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  paymentTerms         String?
  notes                String?
  internalNotes        String?

  // Totals
  subtotal     Decimal @default(0) @db.Decimal(14, 2)
  taxAmount    Decimal @default(0) @db.Decimal(14, 2)
  shippingCost Decimal @default(0) @db.Decimal(14, 2)
  discount     Decimal @default(0) @db.Decimal(14, 2)
  total        Decimal @default(0) @db.Decimal(14, 2)

  deletedAt DateTime?

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdById String?
  createdBy   User?   @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])

  approvedById String?
  approvedBy   User?     @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  lines                    PurchaseOrderLine[]
  goodsReceipts            GoodsReceipt[]
  payments                 Payment[]
  supplierInvoices         SupplierInvoice[]
  threeWayMatches          ThreeWayMatch[]
  acknowledgementEnvelopes SupplierPoEnvelope[]
  purchaseReturns          PurchaseReturn[]
  supplierCreditNotes      SupplierCreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, orderNumber])
  @@unique([organizationId, id])
  @@index([supplierId])
  @@index([organizationId, status, orderDate])
  @@index([organizationId, orderDate])
  @@index([locationId])
  @@map("purchase_orders")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  COMPLETED
  CANCELLED
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id])

  orderedQuantity  Decimal @db.Decimal(12, 3)
  receivedQuantity Decimal @default(0) @db.Decimal(12, 3)
  unitCost         Decimal @db.Decimal(12, 2)
  discount         Decimal @default(0) @db.Decimal(14, 2)
  taxRate          Decimal @default(0) @db.Decimal(6, 3)
  taxAmount        Decimal @default(0) @db.Decimal(14, 2)
  lineTotal        Decimal @db.Decimal(14, 2)
  notes            String?

  goodsReceiptLines    GoodsReceiptLine[]
  supplierInvoiceLines SupplierInvoiceLine[]
  purchaseReturnLines  PurchaseReturnLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([itemId])
  @@map("purchase_order_lines")
}

enum SupplierPoAccessTokenStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SupplierPoAccessAction {
  VIEW
  RESPOND
}

enum SupplierPoAccessOutcome {
  GRANTED
  DENIED
}

enum SupplierPoProposalType {
  ACCEPT
  REJECT
  REQUEST_CHANGE
}

enum SupplierPoProposalStatus {
  SUBMITTED
  BUYER_ACCEPTED
  BUYER_REJECTED
}

enum SupplierPoProposalActorType {
  SUPPLIER
  BUYER
}

/// Immutable, redacted purchase-order snapshot shared with one supplier.
/// Purchase-order, stock, AP, and accounting records remain authoritative.
model SupplierPoEnvelope {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  preferredLocale Locale @default(EN)
  payload         Json
  sourceStateHash String
  contentHash     String

  idempotencyKey  String
  correlationId   String
  businessEventId String
  createdById     String

  accessTokens SupplierPoAccessToken[]
  accessLogs   SupplierPoAccessLog[]
  proposals    SupplierPoProposal[]

  createdAt DateTime @default(now())

  @@unique([organizationId, id])
  @@unique([organizationId, purchaseOrderId, contentHash])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, correlationId])
  @@index([organizationId, purchaseOrderId, createdAt])
  @@index([organizationId, supplierId, createdAt])
  @@map("supplier_po_envelopes")
}

model SupplierPoAccessToken {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  envelopeId String
  envelope   SupplierPoEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Restrict)

  tokenHash           String
  jtiHash             String
  envelopeContentHash String
  recipientHash       String?

  allowView    Boolean                     @default(true)
  allowRespond Boolean                     @default(true)
  status       SupplierPoAccessTokenStatus @default(ACTIVE)

  idempotencyKey  String
  correlationId   String
  businessEventId String

  issuedById String
  issuedAt   DateTime
  expiresAt  DateTime

  revokedById      String?
  revokedAt        DateTime?
  revocationReason String?

  lastAccessedAt DateTime?
  accessCount    Int       @default(0)
  metadata       Json?

  accessLogs SupplierPoAccessLog[]
  proposal   SupplierPoProposal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, tokenHash])
  @@unique([organizationId, jtiHash])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, correlationId])
  @@unique([organizationId, businessEventId])
  @@index([organizationId, envelopeId, status])
  @@index([organizationId, status, expiresAt])
  @@map("supplier_po_access_tokens")
}

/// Append-only, redacted supplier access evidence. Raw tokens and request
/// metadata are never stored.
model SupplierPoAccessLog {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  envelopeId String
  envelope   SupplierPoEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Restrict)

  tokenId String
  token   SupplierPoAccessToken @relation(fields: [tokenId], references: [id], onDelete: Restrict)

  action  SupplierPoAccessAction
  outcome SupplierPoAccessOutcome

  envelopeContentHash String
  tokenHashPrefix     String
  ipHash              String?
  userAgentHash       String?
  responseHash        String?
  denialReason        String?
  occurredAt          DateTime

  createdAt DateTime @default(now())

  @@index([organizationId, envelopeId, occurredAt])
  @@index([organizationId, tokenId, occurredAt])
  @@map("supplier_po_access_logs")
}

/// Supplier response is an immutable proposal only; it never updates the PO.
model SupplierPoProposal {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  envelopeId String
  envelope   SupplierPoEnvelope @relation(fields: [envelopeId], references: [id], onDelete: Restrict)

  tokenId String                @unique
  token   SupplierPoAccessToken @relation(fields: [tokenId], references: [id], onDelete: Restrict)

  proposalType          SupplierPoProposalType
  requestedDeliveryDate DateTime?
  supplierNote          String?
  noteHash              String?
  payloadHash           String

  idempotencyKey  String
  correlationId   String
  businessEventId String

  lines  SupplierPoProposalLine[]
  states SupplierPoProposalState[]

  createdAt DateTime @default(now())

  @@unique([organizationId, id])
  @@unique([organizationId, envelopeId, idempotencyKey])
  @@unique([organizationId, correlationId])
  @@index([organizationId, envelopeId, proposalType, createdAt])
  @@map("supplier_po_proposals")
}

model SupplierPoProposalLine {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  proposalId String
  proposal   SupplierPoProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  purchaseOrderLineId     String
  originalOrderedQuantity Decimal @db.Decimal(12, 3)
  requestedQuantity       Decimal @db.Decimal(12, 3)

  createdAt DateTime @default(now())

  @@unique([organizationId, proposalId, purchaseOrderLineId])
  @@index([organizationId, purchaseOrderLineId])
  @@map("supplier_po_proposal_lines")
}

/// Current proposal status is derived from this append-only hash chain.
model SupplierPoProposalState {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  proposalId String
  proposal   SupplierPoProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)

  version Int
  status  SupplierPoProposalStatus

  effectiveAt DateTime
  actorType   SupplierPoProposalActorType
  actorId     String?
  reason      String?

  previousStateHash String?
  stateHash         String
  evidenceHash      String
  businessEventId   String

  createdAt DateTime @default(now())

  @@unique([organizationId, proposalId, version])
  @@unique([organizationId, stateHash])
  @@index([organizationId, proposalId, effectiveAt])
  @@map("supplier_po_proposal_states")
}

// ============================================================
// GOODS RECEIPT
// ============================================================

model GoodsReceipt {
  id                String             @id @default(cuid())
  receiptNumber     String // per-org unique
  receiptDate       DateTime           @default(now())
  status            GoodsReceiptStatus @default(DRAFT)
  idempotencyKey    String?            @db.VarChar(191)
  payloadHash       String?            @db.VarChar(64)
  finalizedAt       DateTime?
  inventoryPostedAt DateTime?
  notes             String?
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  receivedById String?
  receivedBy   User?   @relation("GoodsReceiptReceivedBy", fields: [receivedById], references: [id])

  lines                GoodsReceiptLine[]
  threeWayMatches      ThreeWayMatch[]
  inspection           GoodsReceiptInspection?
  inspectionResolution GoodsReceiptInspectionResolution?
  purchaseReturns      PurchaseReturn[]
  supplierCreditNotes  SupplierCreditNote[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([organizationId, receiptNumber])
  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([purchaseOrderId])
  @@index([organizationId, purchaseOrderId, status])
  @@index([organizationId, status, receiptDate])
  @@index([locationId])
  @@map("goods_receipts")
}

enum GoodsReceiptStatus {
  DRAFT
  HELD
  RECEIVED
  COMPLETED
  REJECTED
  CANCELLED
}

model DocumentSequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentType   String       @db.VarChar(32)
  scopeKey       String       @default("GLOBAL") @db.VarChar(64)
  nextValue      Int          @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, documentType, scopeKey])
  @@index([organizationId, documentType])
  @@map("document_sequences")
}

model GoodsReceiptLine {
  id                  String            @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String
  purchaseOrderLine   PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])
  itemId              String
  item                Item              @relation(fields: [itemId], references: [id])

  receivedQuantity Decimal   @db.Decimal(12, 3)
  unitCost         Decimal   @db.Decimal(12, 2)
  lineTotal        Decimal   @db.Decimal(14, 2)
  notes            String?
  batchNumber      String?
  expiryDate       DateTime?
  serialNumbers    String[]  @default([])

  supplierInvoiceLines    SupplierInvoiceLine[]
  purchaseReturnLines     PurchaseReturnLine[]
  supplierCreditNoteLines SupplierCreditNoteLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
  @@index([itemId])
  @@map("goods_receipt_lines")
}

enum GoodsReceiptInspectionOutcome {
  PASSED
  FAILED
  INCOMPLETE
}

enum GoodsReceiptInspectionResolutionDecision {
  ACCEPT
  REJECT
}

/// Immutable receiving-time inspection evidence. A failed or incomplete
/// inspection keeps the receipt held until a separate resolution is recorded.
model GoodsReceiptInspection {
  id             String                        @id @default(cuid())
  organizationId String
  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  goodsReceiptId String                        @unique
  goodsReceipt   GoodsReceipt                  @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  outcome        GoodsReceiptInspectionOutcome
  inspectedById  String
  inspectedBy    User                          @relation("GoodsReceiptInspectedBy", fields: [inspectedById], references: [id], onDelete: Restrict)
  reason         String?
  evidenceNotes  String?
  inspectedAt    DateTime                      @default(now())
  createdAt      DateTime                      @default(now())

  resolution GoodsReceiptInspectionResolution?

  @@unique([organizationId, goodsReceiptId], map: "gr_inspection_org_receipt_key")
  @@index([organizationId, outcome, inspectedAt], map: "gr_inspection_org_outcome_at_idx")
  @@map("goods_receipt_inspections")
}

/// Immutable decision that releases or rejects a held receipt. The receipt
/// state and inventory mutation are applied atomically with this evidence.
model GoodsReceiptInspectionResolution {
  id             String                                   @id @default(cuid())
  organizationId String
  organization   Organization                             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  goodsReceiptId String                                   @unique
  goodsReceipt   GoodsReceipt                             @relation(fields: [goodsReceiptId], references: [id], onDelete: Restrict)
  inspectionId   String                                   @unique
  inspection     GoodsReceiptInspection                   @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  decision       GoodsReceiptInspectionResolutionDecision
  resolvedById   String
  resolvedBy     User                                     @relation("GoodsReceiptInspectionResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  reason         String
  idempotencyKey String                                   @db.VarChar(191)
  payloadHash    String                                   @db.VarChar(64)
  resolvedAt     DateTime                                 @default(now())
  createdAt      DateTime                                 @default(now())

  @@unique([organizationId, idempotencyKey], map: "gr_inspection_resolution_org_idem_key")
  @@index([organizationId, decision, resolvedAt], map: "gr_inspection_resolution_org_decision_idx")
  @@map("goods_receipt_inspection_resolutions")
}

// ============================================================
// PURCHASING AP CONTROL KERNEL
// ============================================================

enum SupplierBankAccountStatus {
  PENDING_APPROVAL
  APPROVED
  SUSPENDED
  ARCHIVED
}

enum SupplierBankChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SupplierInvoiceStatus {
  DRAFT
  MATCHED
  POSTED
  PAYMENT_PENDING
  PAID
  CANCELLED
  DISPUTED
}

enum ThreeWayMatchStatus {
  MATCHED
  EXCEPTION
  APPROVED_EXCEPTION
  REJECTED
}

enum SupplierInvoiceMatchExceptionStatus {
  OPEN
  APPROVED
  REJECTED
  EXPIRED
  RESOLVED
}

enum SupplierPaymentStatus {
  DRAFT
  APPROVED
  RELEASED
  POSTED
  CANCELLED
  FAILED
}

model SupplierBankAccount {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  bankName               String?
  accountName            String?
  accountNumberMasked    String?
  accountNumberHash      String?
  mobileMoneyProvider    String?
  mobileMoneyPhoneMasked String?
  mobileMoneyPhoneHash   String?

  isPrimary Boolean                   @default(false)
  status    SupplierBankAccountStatus @default(PENDING_APPROVAL)

  requestedById String?
  approvedById  String?
  approvedAt    DateTime?
  suspendedAt   DateTime?

  evidenceHash String?
  documentHash String?
  metadata     Json?
  deletedAt    DateTime?

  changeRequests   SupplierBankChangeRequest[]
  supplierPayments SupplierPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, supplierId, status])
  @@index([organizationId, accountNumberHash])
  @@index([organizationId, mobileMoneyPhoneHash])
  @@map("supplier_bank_accounts")
}

model SupplierBankChangeRequest {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  bankAccountId String?
  bankAccount   SupplierBankAccount? @relation(fields: [bankAccountId], references: [id])

  status SupplierBankChangeStatus @default(PENDING)

  requestedById String
  approvedById  String?
  requestedAt   DateTime  @default(now())
  approvedAt    DateTime?
  rejectedAt    DateTime?
  reason        String?

  newBankName               String?
  newAccountName            String?
  newAccountNumberMasked    String?
  newAccountNumberHash      String?
  newMobileMoneyProvider    String?
  newMobileMoneyPhoneMasked String?
  newMobileMoneyPhoneHash   String?

  changeHash   String
  documentHash String?
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, supplierId, status, requestedAt])
  @@index([bankAccountId])
  @@map("supplier_bank_change_requests")
}

model SupplierInvoice {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  invoiceNumber String
  invoiceDate   DateTime
  dueDate       DateTime?
  status        SupplierInvoiceStatus @default(DRAFT)

  subtotal   Decimal @default(0) @db.Decimal(14, 2)
  taxAmount  Decimal @default(0) @db.Decimal(14, 2)
  discount   Decimal @default(0) @db.Decimal(14, 2)
  total      Decimal @default(0) @db.Decimal(14, 2)
  amountPaid Decimal @default(0) @db.Decimal(14, 2)
  currency   String  @default("XAF")

  duplicateFingerprint  String
  idempotencyKey        String?
  documentHash          String?
  evidenceHash          String?
  postedBusinessEventId String?
  ledgerPostingBatchId  String?

  createdById  String?
  approvedById String?
  postedAt     DateTime?
  cancelledAt  DateTime?
  notes        String?
  metadata     Json?
  deletedAt    DateTime?

  lines               SupplierInvoiceLine[]
  threeWayMatches     ThreeWayMatch[]
  matchExceptions     SupplierInvoiceMatchException[]
  paymentAllocations  SupplierPaymentAllocation[]
  supplierCreditNotes SupplierCreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, supplierId, invoiceNumber])
  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, duplicateFingerprint])
  @@index([organizationId, status, invoiceDate])
  @@index([supplierId, status])
  @@index([purchaseOrderId])
  @@map("supplier_invoices")
}

model SupplierInvoiceLine {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supplierInvoiceId String
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)

  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])

  goodsReceiptLineId String?
  goodsReceiptLine   GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id])

  description String
  quantity    Decimal             @db.Decimal(12, 3)
  unitCost    Decimal             @db.Decimal(12, 2)
  taxRate     Decimal             @default(0) @db.Decimal(6, 3)
  taxAmount   Decimal             @default(0) @db.Decimal(14, 2)
  lineTotal   Decimal             @db.Decimal(14, 2)
  matchStatus ThreeWayMatchStatus @default(MATCHED)
  notes       String?
  metadata    Json?

  supplierCreditNoteLines SupplierCreditNoteLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, supplierInvoiceId])
  @@index([purchaseOrderLineId])
  @@index([goodsReceiptLineId])
  @@index([itemId])
  @@map("supplier_invoice_lines")
}

model ThreeWayMatch {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supplierInvoiceId String
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Cascade)

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  goodsReceiptId String?
  goodsReceipt   GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])

  status ThreeWayMatchStatus @default(MATCHED)

  matchedAt   DateTime @default(now())
  matchedById String?

  toleranceAmount  Decimal @default(0) @db.Decimal(14, 2)
  varianceAmount   Decimal @default(0) @db.Decimal(14, 2)
  quantityVariance Decimal @default(0) @db.Decimal(12, 3)
  priceVariance    Decimal @default(0) @db.Decimal(14, 2)

  evidenceHash String?
  metadata     Json?

  matchExceptions SupplierInvoiceMatchException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, id])
  @@index([organizationId, status, matchedAt])
  @@index([supplierInvoiceId])
  @@index([purchaseOrderId])
  @@index([goodsReceiptId])
  @@map("three_way_matches")
}

model SupplierInvoiceMatchException {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supplierInvoiceId String
  supplierInvoice   SupplierInvoice @relation(fields: [organizationId, supplierInvoiceId], references: [organizationId, id], onDelete: Restrict)

  threeWayMatchId String
  threeWayMatch   ThreeWayMatch @relation(fields: [organizationId, threeWayMatchId], references: [organizationId, id], onDelete: Restrict)

  status SupplierInvoiceMatchExceptionStatus @default(OPEN)

  policyVersion     String
  reason            String
  evidenceReference String
  varianceAmount    Decimal @db.Decimal(14, 2)
  priceVariance     Decimal @db.Decimal(14, 2)

  requestedById String
  approvedById  String?
  rejectedById  String?
  resolvedById  String?

  requestedAt    DateTime  @default(now())
  decidedAt      DateTime?
  expiresAt      DateTime
  resolvedAt     DateTime?
  decisionReason String?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, id])
  @@index([organizationId, supplierInvoiceId, status])
  @@index([organizationId, threeWayMatchId, status])
  @@index([organizationId, status, expiresAt])
  @@map("supplier_invoice_match_exceptions")
}

model SupplierPayment {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  bankAccountId String?
  bankAccount   SupplierBankAccount? @relation(fields: [bankAccountId], references: [id])

  paymentNumber String
  status        SupplierPaymentStatus @default(DRAFT)
  method        PaymentMethod
  amount        Decimal               @db.Decimal(14, 2)
  currency      String                @default("XAF")
  paymentDate   DateTime              @default(now())

  idempotencyKey String?
  documentHash   String?
  evidenceHash   String?

  requestedById String
  approvedById  String?
  releasedById  String?
  approvedAt    DateTime?
  releasedAt    DateTime?

  ledgerPostingBatchId  String?
  postedBusinessEventId String?
  notes                 String?
  metadata              Json?
  deletedAt             DateTime?

  allocations SupplierPaymentAllocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, paymentNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, paymentDate])
  @@index([supplierId, status])
  @@index([bankAccountId])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  supplierPaymentId String
  supplierPayment   SupplierPayment @relation(fields: [supplierPaymentId], references: [id], onDelete: Cascade)

  supplierInvoiceId String
  supplierInvoice   SupplierInvoice @relation(fields: [supplierInvoiceId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@unique([supplierPaymentId, supplierInvoiceId])
  @@index([organizationId, supplierInvoiceId])
  @@map("supplier_payment_allocations")
}

enum PurchaseCorrectionDirection {
  CORRECTION
  REVERSAL
}

/// Immutable, source-linked return-to-supplier fact. Original purchase orders
/// and goods receipts are never edited to represent a return.
model PurchaseReturn {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "purchase_returns_organizationId_fkey")

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict, map: "purchase_returns_po_tenant_fkey")

  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [organizationId, goodsReceiptId], references: [organizationId, id], onDelete: Restrict, map: "purchase_returns_receipt_tenant_fkey")

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict, map: "purchase_returns_supplierId_fkey")

  returnNumber String
  direction    PurchaseCorrectionDirection @default(CORRECTION)

  reversalOfPurchaseReturnId String?         @unique
  reversalOfPurchaseReturn   PurchaseReturn? @relation("PurchaseReturnReversal", fields: [reversalOfPurchaseReturnId], references: [id], onDelete: Restrict, map: "purchase_returns_reversal_fkey")
  reversedByPurchaseReturn   PurchaseReturn? @relation("PurchaseReturnReversal")

  reason         String
  idempotencyKey String @db.VarChar(191)
  payloadHash    String @db.VarChar(71)
  documentHash   String @db.VarChar(71)
  evidenceHash   String @db.VarChar(71)

  inventoryBusinessEventId String
  ledgerPostingBatchId     String?
  journalEntryId           String?
  postedById               String
  occurredAt               DateTime
  createdAt                DateTime @default(now())

  lines               PurchaseReturnLine[]
  supplierCreditNotes SupplierCreditNote[]

  @@unique([organizationId, id])
  @@unique([organizationId, returnNumber])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, evidenceHash])
  @@index([organizationId, purchaseOrderId, occurredAt], map: "purchase_returns_po_occurred_idx")
  @@index([organizationId, goodsReceiptId, occurredAt], map: "purchase_returns_receipt_occurred_idx")
  @@index([organizationId, direction, occurredAt], map: "purchase_returns_direction_occurred_idx")
  @@map("purchase_returns")
}

/// Immutable line evidence derived from the source receipt. Quantity and cost
/// are server-derived; invoiced and uninvoiced portions drive AP/GRNI posting.
model PurchaseReturnLine {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "purchase_return_lines_organizationId_fkey")

  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [organizationId, purchaseReturnId], references: [organizationId, id], onDelete: Restrict, map: "purchase_return_lines_return_tenant_fkey")

  sourceGoodsReceiptLineId String
  sourceGoodsReceiptLine   GoodsReceiptLine @relation(fields: [sourceGoodsReceiptLineId], references: [id], onDelete: Restrict, map: "purchase_return_lines_receipt_line_fkey")

  sourcePurchaseOrderLineId String
  sourcePurchaseOrderLine   PurchaseOrderLine @relation(fields: [sourcePurchaseOrderLineId], references: [id], onDelete: Restrict, map: "purchase_return_lines_po_line_fkey")

  itemId              String
  quantity            Decimal @db.Decimal(12, 3)
  invoicedQuantity    Decimal @db.Decimal(12, 3)
  uninvoicedQuantity  Decimal @db.Decimal(12, 3)
  unitCost            Decimal @db.Decimal(12, 2)
  inventoryAmount     Decimal @db.Decimal(14, 2)
  supplierClaimAmount Decimal @db.Decimal(14, 2)
  grniAmount          Decimal @db.Decimal(14, 2)

  inventoryTransactionId String   @unique
  evidenceHash           String   @db.VarChar(71)
  createdAt              DateTime @default(now())

  supplierCreditNoteLines SupplierCreditNoteLine[]

  @@unique([organizationId, id])
  @@unique([organizationId, purchaseReturnId, sourceGoodsReceiptLineId], map: "purchase_return_lines_source_key")
  @@index([organizationId, sourceGoodsReceiptLineId], map: "purchase_return_lines_receipt_line_idx")
  @@index([organizationId, sourcePurchaseOrderLineId], map: "purchase_return_lines_po_line_idx")
  @@map("purchase_return_lines")
}

/// Supplier-issued credit/debit evidence. Values are derived from the linked
/// posted invoice and return; the supplier document number/hash are mandatory.
model SupplierCreditNote {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "supplier_credit_notes_organizationId_fkey")

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict, map: "supplier_credit_notes_supplierId_fkey")

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [organizationId, purchaseOrderId], references: [organizationId, id], onDelete: Restrict, map: "supplier_credit_notes_po_tenant_fkey")

  goodsReceiptId String
  goodsReceipt   GoodsReceipt @relation(fields: [organizationId, goodsReceiptId], references: [organizationId, id], onDelete: Restrict, map: "supplier_credit_notes_receipt_tenant_fkey")

  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [organizationId, purchaseReturnId], references: [organizationId, id], onDelete: Restrict, map: "supplier_credit_notes_return_tenant_fkey")

  supplierInvoiceId String
  supplierInvoice   SupplierInvoice @relation(fields: [organizationId, supplierInvoiceId], references: [organizationId, id], onDelete: Restrict, map: "supplier_credit_notes_invoice_tenant_fkey")

  direction PurchaseCorrectionDirection @default(CORRECTION)

  reversalOfSupplierCreditNoteId String?             @unique(map: "supplier_credit_notes_reversal_key")
  reversalOfSupplierCreditNote   SupplierCreditNote? @relation("SupplierCreditNoteReversal", fields: [reversalOfSupplierCreditNoteId], references: [id], onDelete: Restrict, map: "supplier_credit_notes_reversal_fkey")
  reversedBySupplierCreditNote   SupplierCreditNote? @relation("SupplierCreditNoteReversal")

  creditNoteNumber           String
  normalizedCreditNoteNumber String
  creditDate                 DateTime
  currency                   String   @default("XAF")
  subtotal                   Decimal  @db.Decimal(14, 2)
  taxAmount                  Decimal  @db.Decimal(14, 2)
