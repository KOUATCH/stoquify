  id            String                          @id @default(cuid())
  environment   String
  scheduleKey   String                          @db.VarChar(100)
  runId         String                          @db.VarChar(191)
  requestHash   String                          @db.VarChar(71)
  scheduledAt   DateTime
  startedAt     DateTime
  completedAt   DateTime?
  status        AgentReconcilerInvocationStatus @default(RUNNING)
  activeKey     String?                         @db.VarChar(100)
  correlationId String                          @db.VarChar(191)
  result        Json?
  failureCode   String?                         @db.VarChar(100)
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  @@unique([environment, scheduleKey, runId], name: "agent_reconciler_invocation_identity")
  @@unique([environment, activeKey], name: "agent_reconciler_active_lease")
  @@index([environment, scheduleKey, scheduledAt], map: "agent_reconciler_invocation_schedule_idx")
  @@index([environment, status, startedAt], map: "agent_reconciler_invocation_status_idx")
  @@map("agent_reconciler_invocations")
}

model AgentActivationPackage {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentKey            String
  releaseVersion      String
  environment         String
  commitSha           String               @db.VarChar(64)
  manifestHash        String               @db.VarChar(71)
  manifest            Json
  modelProviderPolicy Json
  allowedRoleCodes    String[]             @default([])
  activationStartsAt  DateTime
  activationEndsAt    DateTime
  residualRisks       Json?
  state               AgentActivationState @default(DRAFT)
  version             Int                  @default(1)
  requestedById       String
  activatedById       String?
  activatedAt         DateTime?
  suspendedAt         DateTime?
  suspensionReason    String?
  retiredAt           DateTime?
  retiredById         String?
  retirementReason    String?
  lastReconciledAt    DateTime?
  reconciliationState String?
  alertTransportReady Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  approvals      AgentActivationApproval[]
  owners         AgentActivationOwner[]
  certifications AgentPilotCertification[]

  @@unique([environment, agentKey, releaseVersion])
  @@index([organizationId, agentKey, state])
  @@index([organizationId, retiredAt])
  @@index([environment, agentKey, state])
  @@index([manifestHash])
  @@map("agent_activation_packages")
}

model AgentActivationApproval {
  id             String                 @id @default(cuid())
  packageId      String
  package        AgentActivationPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  idempotencyKey String?                @db.VarChar(191)
  requestHash    String?                @db.VarChar(71)
  approvalType   AgentApprovalType
  decision       AgentApprovalDecision
  approverId     String
  evidenceHash   String                 @db.VarChar(71)
  riskAcceptance Json?
  decidedAt      DateTime
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime               @default(now())

  @@unique([packageId, idempotencyKey])
  @@index([packageId, approvalType, decision, expiresAt])
  @@index([approverId, decidedAt])
  @@map("agent_activation_approvals")
}

model AgentActivationOwner {
  id                 String                   @id @default(cuid())
  packageId          String
  package            AgentActivationPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  responsibility     AgentOwnerResponsibility
  primaryUserId      String
  backupUserId       String?
  escalationRouteRef String
  runbookVersion     String
  acceptedAt         DateTime?
  validUntil         DateTime?
  coverageStartsAt   DateTime
  coverageEndsAt     DateTime
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([packageId, responsibility])
  @@index([primaryUserId, responsibility])
  @@index([packageId, acceptedAt, validUntil])
  @@map("agent_activation_owners")
}

model AgentPilotCertification {
  id             String                   @id @default(cuid())
  packageId      String
  package        AgentActivationPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)
  idempotencyKey String?                  @db.VarChar(191)
  requestHash    String?                  @db.VarChar(71)
  commitSha      String                   @db.VarChar(64)
  manifestHash   String                   @db.VarChar(71)
  suiteVersion   String
  ciRunId        String
  result         AgentCertificationResult
  reportHash     String                   @db.VarChar(71)
  passedAt       DateTime
  expiresAt      DateTime
  createdAt      DateTime                 @default(now())

  @@unique([packageId, idempotencyKey])
  @@unique([packageId, ciRunId])
  @@index([packageId, result, expiresAt])
  @@index([commitSha, manifestHash])
  @@map("agent_pilot_certifications")
}
