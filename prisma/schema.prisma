// ============================================================
// POS SYSTEM
// ============================================================

model POSStation {
  id             String  @id @default(cuid())
  terminalNumber String // per-org unique
  name           String
  isActive       Boolean @default(true)

  hasCashDrawer Boolean @default(true)

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  currentSessionId String?     @unique
  currentSession   POSSession? @relation("StationCurrentSession", fields: [currentSessionId], references: [id])

  sessions                POSSession[]                @relation("StationSessions")
  salesOrders             SalesOrder[]
  cashDrawers             CashDrawer[]
  offlineDevices          POSOfflineDevice[]
  offlineEvents           POSOfflineEvent[]
  offlineSyncCertificates POSOfflineSyncCertificate[]
  posCommitResults        POSCommitResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, terminalNumber])
  @@index([locationId])
  @@index([organizationId])
  @@map("pos_terminals")
}

model POSSession {
  id            String           @id @default(cuid())
  sessionNumber String // per-org unique
  status        POSSessionStatus @default(ACTIVE)
  startTime     DateTime         @default(now())
  endTime       DateTime?

  terminalId String
  terminal   POSStation @relation("StationSessions", fields: [terminalId], references: [id])

  stationCurrent POSStation? @relation("StationCurrentSession")

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  openingBalance  Decimal  @default(0) @db.Decimal(14, 2)
  closingBalance  Decimal? @db.Decimal(14, 2)
  expectedBalance Decimal? @db.Decimal(14, 2)
  variance        Decimal? @db.Decimal(14, 2)

  totalSales       Decimal @default(0) @db.Decimal(14, 2)
  totalTax         Decimal @default(0) @db.Decimal(14, 2)
  totalDiscount    Decimal @default(0) @db.Decimal(14, 2)
  transactionCount Int     @default(0)

  cashTotal         Decimal @default(0) @db.Decimal(14, 2)
  cardTotal         Decimal @default(0) @db.Decimal(14, 2)
  mobileMoneyTotal  Decimal @default(0) @db.Decimal(14, 2)
  bankTransferTotal Decimal @default(0) @db.Decimal(14, 2)
  creditTotal       Decimal @default(0) @db.Decimal(14, 2)

  organizationId String

  salesOrders            SalesOrder[]
  posCommitResults       POSCommitResult[]
  cashDrawerTransactions CashDrawerTransaction[]
  offlineEvents          POSOfflineEvent[]

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sessionNumber])
  @@index([terminalId])
  @@index([userId])
  @@index([locationId])
  @@index([status, startTime])
  @@map("pos_sessions")
}

enum POSSessionStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  RECONCILED
}

enum POSCommitResultStatus {
  CLAIMED
  COMMITTED
  COMPLETED
}

model POSCommitResult {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  terminalId String
  terminal   POSStation @relation(fields: [terminalId], references: [id], onDelete: Restrict)

  sessionId String
  session   POSSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)

  actorId String
  actor   User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  clientCommitId       String @db.VarChar(191)
  requestHash          String @db.VarChar(64)
  requestSchemaVersion Int    @default(1)

  status         POSCommitResultStatus @default(CLAIMED)
  resultEnvelope Json?
  resultHash     String?               @db.VarChar(64)
  committedAt    DateTime?
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, terminalId, clientCommitId])
  @@index([organizationId, locationId, status, createdAt])
  @@index([organizationId, salesOrderId])
  @@index([organizationId, sessionId, createdAt])
  @@map("pos_commit_results")
}

model CashDrawer {
  id              String  @id @default(cuid())
  name            String
  drawerNumber    String
  currentBalance  Decimal @default(0) @db.Decimal(14, 2)
  expectedBalance Decimal @default(0) @db.Decimal(14, 2)
  isOpen          Boolean @default(false)

