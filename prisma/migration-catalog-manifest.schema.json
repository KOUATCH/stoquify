{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stoquify://migration-catalog-manifest.schema.json",
  "title": "Stoquify immutable Prisma migration catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hashContract",
    "catalogSha256",
    "migrationCount",
    "migrations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "hashContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "approvalIdentity",
        "transportIdentity",
        "encoding",
        "canonicalization"
      ],
      "properties": {
        "version": { "const": "stoquify-migration-sql-sha256-v1" },
        "approvalIdentity": { "const": "canonicalLfSha256" },
        "transportIdentity": { "const": "rawSha256" },
        "encoding": { "const": "UTF-8" },
        "canonicalization": { "type": "string", "minLength": 1 }
      }
    },
    "catalogSha256": { "$ref": "#/$defs/sha256" },
    "migrationCount": { "type": "integer", "minimum": 1 },
    "migrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "timestamp",
          "path",
          "byteLength",
          "rawSha256",
          "canonicalLfSha256",
          "canonicalCrlfSha256"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[0-9]{14}_.+$" },
          "timestamp": { "type": "string", "pattern": "^[0-9]{14}$" },
          "path": { "type": "string", "pattern": "^prisma/migrations/.+/migration\\.sql$" },
          "byteLength": { "type": "integer", "minimum": 1 },
          "rawSha256": { "$ref": "#/$defs/sha256" },
          "canonicalLfSha256": { "$ref": "#/$defs/sha256" },
          "canonicalCrlfSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
