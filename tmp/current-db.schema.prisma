generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id                      String    @id @default(cuid())
  token                   String    @unique
  userId                  String
  expiresAt               DateTime
  ipAddress               String?
  userAgent               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  assuranceVerifiedAt     DateTime?
  assuranceMethod         String?
  assuranceOrganizationId String?
  assuranceLevel          Int       @default(0)
  assuranceFailureCount   Int       @default(0)
  assuranceLockedUntil    DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

model User {
  id                                  String                      @id @default(cuid())
  name                                String?
  email                               String                      @unique
  emailVerified                       Boolean                     @default(false)
  firstName                           String?
  lastName                            String?
  phone                               String?                     @unique
  image                               String?
  jobTitle                            String?
  password                            String?
  isActive                            Boolean                     @default(true)
  isVerified                          Boolean                     @default(false)
  preferredLocale                     Locale                      @default(EN)
  verificationToken                   String?
  verificationTokenExpires            DateTime?
  isLocked                            Boolean                     @default(false)
  lockedUntil                         DateTime?
  failedLoginAttempts                 Int                         @default(0)
  lastFailedLogin                     DateTime?
  lastLogin                           DateTime?
  mfaSecret                           String?
  mfaEnabledAt                        DateTime?
  mfaBackupCodes                      String[]
  createdAt                           DateTime                    @default(now())
  updatedAt                           DateTime                    @updatedAt
  organizationId                      String
  accounts                            Account[]
  auditLogs                           AuditLog[]
  startedBranchDailyCloseRuns         BranchDailyCloseRun[]       @relation("BranchDailyCloseStartedBy")
  invalidatedBranchDailyCloseSignOffs BranchDailyCloseSignOff[]   @relation("BranchDailyCloseInvalidatedBy")
  signedBranchDailyCloseSignOffs      BranchDailyCloseSignOff[]   @relation("BranchDailyCloseSignedBy")
  cashDrawerTransactions              CashDrawerTransaction[]
  approvedCashShortagePolicies        CashShortagePolicy[]        @relation("CashShortagePolicyApprovedBy")
  createdCashShortagePolicies         CashShortagePolicy[]        @relation("CashShortagePolicyCreatedBy")
  generatedReports                    DailySalesReport[]          @relation("ReportGeneratedBy")
  createdExpenses                     Expense[]                   @relation("ExpenseCreatedBy")
  receivedGoodsReceipts               GoodsReceipt[]              @relation("GoodsReceiptReceivedBy")
  createdTransactions                 InventoryTransaction[]      @relation("TransactionCreatedBy")
  legacy_production_batches           legacy_production_batches[]
  managedLocations                    Location[]                  @relation("LocationManager")
  matchedPaymentRecords               MatchRecord[]               @relation("MatchRecordMatchedBy")
  passwordHistory                     PasswordHistory[]
  ownedPaymentExceptions              PaymentException[]          @relation("PaymentExceptionOwner")
  refundsProcessed                    PaymentRefund[]
  paymentsProcessed                   Payment[]
  posSessions                         POSSession[]
  approvedPurchaseOrders              PurchaseOrder[]             @relation("PurchaseOrderApprovedBy")
  createdPurchaseOrders               PurchaseOrder[]             @relation("PurchaseOrderCreatedBy")
  runPaymentReconciliations           ReconciliationRun[]         @relation("ReconciliationRunRunBy")
  signedPaymentReconciliations        ReconciliationRun[]         @relation("ReconciliationRunSignedBy")
  createdSalesOrders                  SalesOrder[]                @relation("SalesOrderCreatedBy")
  sessions                            Session[]
  importedStatementFiles              StatementFile[]             @relation("StatementFileImportedBy")
  approvedAdjustments                 StockAdjustment[]           @relation("AdjustmentApprovedBy")
  createdAdjustments                  StockAdjustment[]           @relation("AdjustmentCreatedBy")
  stockCountsApproved                 StockCountSession[]         @relation("StockCountApprovedBy")
  stockCountsCreated                  StockCountSession[]         @relation("StockCountCreatedBy")
  stockCountsPosted                   StockCountSession[]         @relation("StockCountPostedBy")
  stockCountsSubmitted                StockCountSession[]         @relation("StockCountSubmittedBy")
  approvedTransfers                   StockTransfer[]             @relation("TransferApprovedBy")
  createdTransfers                    StockTransfer[]             @relation("TransferCreatedBy")
  ownedSuspenseItems                  SuspenseItem[]              @relation("SuspenseItemOwner")
  organization                        Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roles                               Role[]                      @relation("UserRoles")

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([email])
  @@index([phone])
  @@map("users")
}

model Role {
  id             String       @id @default(cuid())
  code           String
  description    String?
  nameEn         String
  nameFr         String?
  permissions    String[]
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  invites        Invite[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]       @relation("UserRoles")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model Organization {
  id                                      String                                   @id @default(cuid())
  name                                    String
  slug                                    String                                   @unique
  industry                                String?
  tradeName                               String?
  taxIdentifier                           String?
  country                                 String?
  countryCode                             String?
  state                                   String?
  address                                 String?
  currency                                String                                   @default("XAF")
  timezone                                String                                   @default("Africa/Douala")
  defaultLocale                           Locale                                   @default(EN)
  companySize                             String?
  businessType                            String?
  branchCount                             String?
  primaryPain                             String?
  setupRole                               String?
  requestedModules                        String[]                                 @default([])
  assistedSetupRequested                  Boolean                                  @default(false)
  onboardingSource                        String?
  onboardingCompletedAt                   DateTime?
  inventoryStartDate                      DateTime?
  fiscalYearStart                         String?                                  @default("01-01")
  isActive                                Boolean                                  @default(true)
  deletedAt                               DateTime?
  createdAt                               DateTime                                 @default(now())
  updatedAt                               DateTime                                 @updatedAt
  accountantAccessGrants                  AccountantAccessGrant[]
  accountantComments                      AccountantComment[]
  accountantReviews                       AccountantReview[]
  accountingPeriods                       AccountingPeriod[]
  accountingSourceLinks                   AccountingSourceLink[]
  agentActivationPackages                 AgentActivationPackage[]
  agentCostLedger                         AgentCostLedger[]
  agentFeedback                           AgentFeedback[]
  agentPolicyIncidents                    AgentPolicyIncident[]
  agentRuns                               AgentRun[]
  auditLogs                               AuditLog[]
  branchDailyCloseRuns                    BranchDailyCloseRun[]
  branchDailyCloseSignOffs                BranchDailyCloseSignOff[]
  brands                                  Brand[]
  businessEventOutbox                     BusinessEventOutbox[]
  businessEvents                          BusinessEvent[]
  cashShortagePolicies                    CashShortagePolicy[]
  categories                              Category[]
  chartOfAccounts                         ChartOfAccount[]
  closeAssuranceFindings                  CloseAssuranceFinding[]
  closeChecklistItems                     CloseChecklistItem[]
  closeEvidenceItems                      CloseEvidenceItem[]
  closePackExports                        ClosePackExport[]
  closeRuns                               CloseRun[]
  complianceAdapterConfigs                ComplianceAdapterConfig[]
  complianceEvidence                      ComplianceEvidence[]
  complianceSubmissions                   ComplianceSubmission[]
  customerLedgerEntries                   CustomerLedgerEntry[]
  customers                               Customer[]
  dailySalesReports                       DailySalesReport[]
  expenseCategories                       ExpenseCategory[]
  expenses                                Expense[]
  fiscalDocumentLines                     FiscalDocumentLine[]
  fiscalDocuments                         FiscalDocument[]
  fiscalSequences                         FiscalSequence[]
  fiscalYears                             FiscalYear[]
  goodsReceipts                           GoodsReceipt[]
  hrisAttendanceAnomalies                 HrisAttendanceAnomaly[]
  hrisEmploymentAssignments               HrisEmploymentAssignment[]
  hrisLeaveBalanceEntries                 HrisLeaveBalanceEntry[]
  hrisLeavePolicies                       HrisLeavePolicy[]
  hrisManagerDelegations                  HrisManagerDelegation[]
  hrisOrgUnits                            HrisOrgUnit[]
  hrisPositions                           HrisPosition[]
  hrisPublicHolidays                      HrisPublicHoliday[]
  hrisReportingRelationships              HrisReportingRelationship[]
  hrisTimeEntries                         HrisTimeEntry[]
  hrisTimeImportBatches                   HrisTimeImportBatch[]
  hrisTimeRequests                        HrisTimeRequest[]
  hrisWorkCalendars                       HrisWorkCalendar[]
  hrisWorkSchedules                       HrisWorkSchedule[]
  inventoryTransactions                   InventoryTransaction[]
  invites                                 Invite[]
  items                                   Item[]
  journalEntries                          JournalEntry[]
  journalEntryLines                       JournalEntryLine[]
  journals                                Journal[]
  ledgerAuditEvents                       LedgerAuditEvent[]
  ledgerPostingBatches                    LedgerPostingBatch[]
  legacy_production_batches               legacy_production_batches[]
  legacy_recipes                          legacy_recipes[]
  locations                               Location[]
  matchRecords                            MatchRecord[]
  accountingSettings                      OrganizationAccountingSettings?
  paymentExceptions                       PaymentException[]
  paymentRails                            PaymentRail[]
  reconciliationInbox                     PaymentReconciliationInboxItem[]
  paymentTransactions                     PaymentTransaction[]
  payments                                Payment[]
  payrollAttendanceSnapshots              PayrollAttendanceSnapshot[]
  payrollContracts                        PayrollContract[]
  payrollDeclarationEvidence              PayrollDeclarationEvidence[]
  payrollDeclarations                     PayrollDeclaration[]
  payrollEmployeeBalanceCases             PayrollEmployeeBalanceCase[]
  payrollEmployeeBalanceEvents            PayrollEmployeeBalanceEvent[]
  payrollRubriqueAssignments              PayrollEmployeeRubriqueAssignment[]
  payrollEmployees                        PayrollEmployee[]
  payrollPaymentAllocations               PayrollPaymentAllocation[]
  payrollPaymentBatches                   PayrollPaymentBatch[]
  payrollPaymentDestinationChangeRequests PayrollPaymentDestinationChangeRequest[]
  payrollPayslipLines                     PayrollPayslipLine[]
  payrollPayslips                         PayrollPayslip[]
  payrollPeriods                          PayrollPeriod[]
  payrollRubriques                        PayrollRubrique[]
  payrollRunLines                         PayrollRunLine[]
  payrollRuns                             PayrollRun[]
  payrollSalaryChangeRequests             PayrollSalaryChangeRequest[]
  posOfflineDevices                       POSOfflineDevice[]
  posOfflineEvents                        POSOfflineEvent[]
  posOfflineSyncBatches                   POSOfflineSyncBatch[]
  posOfflineSyncCertificates              POSOfflineSyncCertificate[]
  posOfflineSyncConflicts                 POSOfflineSyncConflict[]
  posStations                             POSStation[]
  postingRuleLines                        PostingRuleLine[]
  postingRules                            PostingRule[]
  providerAccounts                        ProviderAccount[]
  providerEvents                          ProviderEvent[]
  publicReceiptAccessTokens               PublicReceiptAccessToken[]
  purchaseOrders                          PurchaseOrder[]
  reconciliationRuns                      ReconciliationRun[]
  roles                                   Role[]
  salesOrders                             SalesOrder[]
  serialNumbers                           SerialNumber[]
  settlementAccounts                      SettlementAccount[]
  statementFiles                          StatementFile[]
  statementLines                          StatementLine[]
  stockAdjustments                        StockAdjustment[]
  stockCountSessions                      StockCountSession[]
  stockTransfers                          StockTransfer[]
  supplierBankAccounts                    SupplierBankAccount[]
  supplierBankChanges                     SupplierBankChangeRequest[]
  supplierInvoiceLines                    SupplierInvoiceLine[]
  supplierInvoices                        SupplierInvoice[]
  supplierLedgerEntries                   SupplierLedgerEntry[]
  supplierPaymentAllocations              SupplierPaymentAllocation[]
  supplierPayments                        SupplierPayment[]
  suppliers                               Supplier[]
  suspenseItems                           SuspenseItem[]
  taxRates                                TaxRate[]
  threeWayMatches                         ThreeWayMatch[]
  units                                   Unit[]
  users                                   User[]
  workflowAssuranceAlertDeliveries        WorkflowAssuranceAlertDelivery[]
  workflowAssuranceCheckFindings          WorkflowAssuranceCheckFinding[]
  workflowAssuranceCheckRuns              WorkflowAssuranceCheckRun[]
  workflowAssuranceIncidentEvents         WorkflowAssuranceIncidentEvent[]
  workflowAssuranceIncidents              WorkflowAssuranceIncident[]
  workflowAssuranceWaivers                WorkflowAssuranceWaiver[]

  @@index([slug])
  @@index([isActive, deletedAt])
  @@map("organizations")
}

model Invite {
  id             String       @id @default(cuid())
  token          String       @unique
  email          String
  organizationId String
  roleId         String
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])

  @@unique([email, organizationId])
  @@index([email])
  @@index([organizationId, status])
  @@index([token, status])
  @@map("invites")
}

model Location {
  id                         String                      @id @default(cuid())
  name                       String
  code                       String
  type                       LocationType                @default(WAREHOUSE)
  address                    String?
  phone                      String?
  email                      String?
  isActive                   Boolean                     @default(true)
  isDefault                  Boolean                     @default(false)
  deletedAt                  DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  organizationId             String
  managerId                  String?
  allowNegativeStock         Boolean                     @default(false)
  requiresApproval           Boolean                     @default(false)
  branchDailyCloseRuns       BranchDailyCloseRun[]
  cashDrawers                CashDrawer[]
  dailySalesReports          DailySalesReport[]
  expenses                   Expense[]
  goodsReceipts              GoodsReceipt[]
  hrisPositions              HrisPosition[]
  inventoryLevels            InventoryLevel[]
  inventoryTransactions      InventoryTransaction[]
  legacy_production_batches  legacy_production_batches[]
  manager                    User?                       @relation("LocationManager", fields: [managerId], references: [id])
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posOfflineDevices          POSOfflineDevice[]
  posOfflineEvents           POSOfflineEvent[]
  posOfflineSyncCertificates POSOfflineSyncCertificate[]
  posSessions                POSSession[]
  posStations                POSStation[]
  purchaseOrders             PurchaseOrder[]
  salesOrders                SalesOrder[]
  serialNumbers              SerialNumber[]
  stockAdjustments           StockAdjustment[]
  stockCountLines            StockCountLine[]
  stockCountSessions         StockCountSession[]
  transfersFrom              StockTransfer[]             @relation("TransferFrom")
  transfersTo                StockTransfer[]             @relation("TransferTo")

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId])
  @@index([organizationId, type, isActive])
  @@map("locations")
}

model BranchDailyCloseRun {
  id                    String                    @id @default(cuid())
  organizationId        String
  locationId            String
  businessDate          DateTime                  @db.Date
  periodStart           DateTime
  periodEnd             DateTime
  status                BranchDailyCloseRunStatus
  readinessState        String                    @db.VarChar(32)
  evidenceCoverageState String                    @db.VarChar(16)
  supportedItemCount    Int
  unsupportedItemCount  Int
  blockerCount          Int
  evidenceObservedAt    DateTime
  readinessSourceHash   String                    @db.VarChar(71)
  evidenceHash          String                    @db.VarChar(71)
  evidenceManifest      Json
  startedById           String
  startedAt             DateTime
  idempotencyKey        String                    @db.VarChar(200)
  requestHash           String                    @db.VarChar(71)
  correlationId         String                    @db.VarChar(200)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  location              Location                  @relation(fields: [locationId], references: [id])
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startedBy             User                      @relation("BranchDailyCloseStartedBy", fields: [startedById], references: [id])
  signOffs              BranchDailyCloseSignOff[]

  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, id])
  @@unique([organizationId, locationId, businessDate], map: "branch_daily_close_runs_organizationId_locationId_businessDate_")
  @@index([organizationId, status, businessDate])
  @@index([startedById])
  @@index([correlationId])
  @@index([organizationId, locationId, status, businessDate], map: "branch_daily_close_runs_organizationId_locationId_status_busine")
  @@map("branch_daily_close_runs")
}

model BranchDailyCloseSignOff {
  id                        String                        @id @default(cuid())
  organizationId            String
  branchDailyCloseRunId     String
  status                    BranchDailyCloseSignOffStatus @default(ACTIVE)
  activeKey                 String?                       @db.VarChar(200)
  signedReadinessSourceHash String                        @db.VarChar(71)
  signedEvidenceHash        String                        @db.VarChar(71)
  signedEvidenceObservedAt  DateTime
  signedById                String
  signedAt                  DateTime
  authAssuranceLevel        String                        @db.VarChar(2)
  freshAuthAt               DateTime
  invalidatedById           String?
  invalidatedAt             DateTime?
  invalidationReason        String?                       @db.VarChar(500)
  supersedesSignOffId       String?
  idempotencyKey            String                        @db.VarChar(200)
  requestHash               String                        @db.VarChar(71)
  correlationId             String                        @db.VarChar(200)
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  invalidatedBy             User?                         @relation("BranchDailyCloseInvalidatedBy", fields: [invalidatedById], references: [id], onDelete: Restrict)
  branchDailyCloseRun       BranchDailyCloseRun           @relation(fields: [organizationId, branchDailyCloseRunId], references: [organizationId, id], map: "branch_daily_close_sign_offs_organizationId_branchDailyCloseRun")
  organization              Organization                  @relation(fields: [organizationId], references: [id])
  supersedesSignOff         BranchDailyCloseSignOff?      @relation("BranchDailyCloseSignOffSupersession", fields: [organizationId, supersedesSignOffId], references: [organizationId, id], map: "branch_daily_close_sign_offs_organizationId_supersedesSignOffId")
  supersededBySignOffs      BranchDailyCloseSignOff[]     @relation("BranchDailyCloseSignOffSupersession")
  signedBy                  User                          @relation("BranchDailyCloseSignedBy", fields: [signedById], references: [id])

  @@unique([organizationId, id])
  @@unique([organizationId, activeKey])
  @@unique([organizationId, idempotencyKey])
  @@index([signedById])
  @@index([invalidatedById])
  @@index([supersedesSignOffId])
  @@index([correlationId])
  @@index([organizationId, branchDailyCloseRunId, status, signedAt], map: "branch_daily_close_sign_offs_organizationId_branchDailyCloseRun")
  @@map("branch_daily_close_sign_offs")
}

model Category {
  id             String       @id @default(cuid())
  slug           String
  titleEn        String
  titleFr        String?
  descriptionEn  String?
  descriptionFr  String?
  imageUrl       String?
  parentId       String?
  isActive       Boolean      @default(true)
  deletedAt      DateTime?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[]   @relation("CategoryHierarchy")
  items          Item[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, parentId])
  @@index([organizationId, isActive, deletedAt])
  @@map("categories")
}

model Brand {
  id             String       @id @default(cuid())
  slug           String
  nameEn         String
  nameFr         String?
  descriptionEn  String?
  descriptionFr  String?
  logoUrl        String?
  isActive       Boolean      @default(true)
  deletedAt      DateTime?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          Item[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("brands")
}

model Unit {
  id             String       @id @default(cuid())
  symbol         String
  type           UnitType     @default(QUANTITY)
  nameEn         String
  nameFr         String?
  baseUnit       String?
  conversionRate Decimal?     @db.Decimal(18, 6)
  isActive       Boolean      @default(true)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          Item[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, symbol])
  @@unique([organizationId, nameEn])
  @@index([organizationId])
  @@map("units")
}

model TaxRate {
  id             String       @id @default(cuid())
  rate           Decimal      @db.Decimal(6, 3)
  type           TaxType      @default(SALES)
  nameEn         String
  nameFr         String?
  isActive       Boolean      @default(true)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          Item[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, nameEn])
  @@index([organizationId])
  @@map("tax_rates")
}

model Item {
  id                        String                      @id @default(cuid())
  slug                      String
  sku                       String
  barcode                   String?
  nameEn                    String
  nameFr                    String?
  descriptionEn             String?
  descriptionFr             String?
  imageUrls                 String[]
  thumbnail                 String?
  upc                       String?
  ean                       String?
  mpn                       String?
  isbn                      String?
  dimensions                String?
  weight                    Decimal?                    @db.Decimal(12, 3)
  color                     String?
  size                      String?
  costPrice                 Decimal                     @default(0) @db.Decimal(12, 2)
  sellingPrice              Decimal                     @default(0) @db.Decimal(12, 2)
  msrp                      Decimal?                    @db.Decimal(12, 2)
  trackInventory            Boolean                     @default(true)
  trackSerialNumbers        Boolean                     @default(false)
  trackBatches              Boolean                     @default(false)
  trackExpiry               Boolean                     @default(false)
  minStockLevel             Decimal                     @default(0) @db.Decimal(12, 3)
  maxStockLevel             Decimal?                    @db.Decimal(12, 3)
  reorderLevel              Decimal                     @default(0) @db.Decimal(12, 3)
  reorderQuantity           Decimal?                    @db.Decimal(12, 3)
  isActive                  Boolean                     @default(true)
  isDiscontinued            Boolean                     @default(false)
  deletedAt                 DateTime?
  organizationId            String
  categoryId                String?
  brandId                   String?
  unitId                    String?
  taxRateId                 String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  dailySalesReportItems     DailySalesReportItem[]
  goodsReceiptLines         GoodsReceiptLine[]
  inventoryLevels           InventoryLevel[]
  inventoryTransactions     InventoryTransaction[]
  supplierItems             ItemSupplier[]
  brand                     Brand?                      @relation(fields: [brandId], references: [id])
  category                  Category?                   @relation(fields: [categoryId], references: [id])
  organization              Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taxRate                   TaxRate?                    @relation(fields: [taxRateId], references: [id])
  unit                      Unit?                       @relation(fields: [unitId], references: [id])
  legacy_recipe_ingredients legacy_recipe_ingredients[]
  legacy_recipes            legacy_recipes[]
  purchaseOrderLines        PurchaseOrderLine[]
  salesOrderLines           SalesOrderLine[]
  serialNumbers             SerialNumber[]
  adjustmentLines           StockAdjustmentLine[]
  stockCountLines           StockCountLine[]
  transferLines             StockTransferLine[]
  supplierInvoiceLines      SupplierInvoiceLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, slug])
  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([barcode])
  @@index([organizationId, isActive, deletedAt])
  @@index([organizationId, categoryId, deletedAt])
  @@index([organizationId, brandId])
  @@map("items")
}

model InventoryLevel {
  id                String    @id @default(cuid())
  itemId            String
  locationId        String
  quantityOnHand    Decimal   @default(0) @db.Decimal(12, 3)
  quantityReserved  Decimal   @default(0) @db.Decimal(12, 3)
  quantityAvailable Decimal   @default(0) @db.Decimal(12, 3)
  quantityInTransit Decimal   @default(0) @db.Decimal(12, 3)
  quantityOnOrder   Decimal   @default(0) @db.Decimal(12, 3)
  reorderPoint      Decimal   @default(0) @db.Decimal(12, 3)
  averageCost       Decimal   @default(0) @db.Decimal(12, 2)
  totalValue        Decimal   @default(0) @db.Decimal(14, 2)
  version           Int       @default(0)
  lastCountDate     DateTime?
  lastTransactionAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  item              Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location          Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([itemId])
  @@index([locationId])
  @@map("inventory_levels")
}

model InventoryTransaction {
  id                      String                             @id @default(cuid())
  type                    TransactionType
  quantity                Decimal                            @db.Decimal(12, 3)
  unitCost                Decimal                            @default(0) @db.Decimal(12, 2)
  totalCost               Decimal                            @default(0) @db.Decimal(14, 2)
  notes                   String?
  createdAt               DateTime                           @default(now())
  itemId                  String
  locationId              String
  organizationId          String
  createdById             String?
  referenceType           TransactionReferenceType?
  referenceId             String?
  referenceNumber         String?
  batchNumber             String?
  serialNumbers           String[]
  expiryDate              DateTime?
  balanceAfter            Decimal                            @db.Decimal(12, 3)
  effectiveAt             DateTime
  recordedAt              DateTime
  timeProvenance          InventoryTransactionTimeProvenance
  reversalOfTransactionId String?                            @unique
  createdBy               User?                              @relation("TransactionCreatedBy", fields: [createdById], references: [id])
