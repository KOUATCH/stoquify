  "reviewMatrix": {
    "architecture": "Reuses authenticated purchase-order route, shell, organization context, module entitlement service and existing envelope/proposal/event records. Shared route helper adds an optional presentation callback; guard behavior is unchanged.",
    "backend_api": "All proposal result paths verify scoped applied events and actual quantity/date/note/request payloads. History batches event reads; failed queries propagate. The existing action identity, permissions and fresh-auth controls remain.",
    "database_migrations": "No schema migration or evidence rewrite. Original event line ordering verifies legacy hashes despite reversed database row order. Real local before/after query-result fault injection verifies denial without business side effects.",
    "security_iam_privacy": "Current active account, organization, known read/update permission, purchasing access and password assurance are required for writes/replays. Scope and cross-object attempts denied. Drafts do not retain passwords or bearer links; scope changes clear credentials and discard late results.",
    "frontend_design_system": "Existing tokens and components preserved. Explicit historical selection survives a default-page route refresh. Changed order/authority invalidates the selection and failed in-flight reads keep data hidden.",
    "workflow_accessibility_localization": "EN/FR connected buyer journeys plus six-envelope keyboard traversal and return to latest. Existing translated feedback reused; 320/390/768/1440 widths and CSS 200% text covered. Native assistive technology and zoom remain open.",
    "product_operations": "Buyer can prepare a private invitation, inspect supplier consequences, record a reasoned decision and disable access. Current and earlier records support reconciliation. Creating a link does not send it.",
    "finance_reconciliation_controls": "Original PO quantities/totals/approval and financial records unchanged by acknowledgement operations. Buyer acceptance cannot receive stock, authorize payment or alter AP/ledger. Downstream controlled operations remain separate.",
    "statutory_country": "Not applicable to calculation changes: no statutory/country-pack/tax/posting rule changed. No OHADA/SYSCOHADA approval or certification is asserted.",
    "audit_records": "Proposal content now reconstructs against the retained submission event; reviewer identity, time, source, payload, state and applied status must match. This is consistency verification, not signature or identity certification.",
    "quality_release": "75 tests in seven suites; 18 real PostgreSQL integrity groups plus nine buyer regression groups; four EN/FR browser journeys; 34 screenshots; final typecheck and six-file lint pass. Earlier failed attempts remain explicit.",
    "sre_performance_cost": "One tenant-scoped event batch per history page, no query for empty history. Recorded development route/pagination timings only; no approved production-budget comparison or certification.",
