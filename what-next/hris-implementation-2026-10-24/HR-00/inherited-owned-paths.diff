+// AF03 foundation with AF04 managed authorization. SQL owns partial uniqueness,
+// lifecycle/retention guards and sticky managed mandate keys; services own authority.
+enum FirmEngagementStatus {
+  DRAFT
+  ACTIVE
+  SUSPENDED
+  ENDED
+}
+
+model FirmEngagement {
+  id String @id @default(cuid())
+  firmOrganizationId String
+  clientOrganizationId String
+  firm Organization @relation("EngagementFirm", fields: [firmOrganizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
+  client Organization @relation("EngagementClient", fields: [clientOrganizationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
+  ownerUserId String
+  createdById String
+  owner User @relation("FirmEngagementOwner", fields: [ownerUserId, firmOrganizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
+  creator User @relation("FirmEngagementCreator", fields: [createdById, firmOrganizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
+  scope AccountantAccessRole
+  effectiveFrom DateTime
+  expiresAt DateTime
+  status FirmEngagementStatus @default(DRAFT)
+  version Int @default(0)
+  lastTransitionId String?
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+  assignments FirmEngagementAssignment[]
+  transitions FirmEngagementTransition[]
+  grantLinks FirmEngagementGrantLink[]
+
+  @@unique([id, firmOrganizationId, clientOrganizationId], map: "firm_engagement_identity_key")
+  @@index([firmOrganizationId, status, expiresAt])
+  @@index([clientOrganizationId, status])
+  @@map("firm_engagements")
+}
+
+model FirmEngagementAssignment {
+  id String @id @default(cuid())
+  engagementId String
+  firmOrganizationId String
+  clientOrganizationId String
+  engagement FirmEngagement @relation(fields: [engagementId, firmOrganizationId, clientOrganizationId], references: [id, firmOrganizationId, clientOrganizationId], onDelete: Restrict, onUpdate: Restrict)
+  accountantUserId String
+  createdById String
+  accountant User @relation("FirmEngagementStaff", fields: [accountantUserId, firmOrganizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
+  creator User @relation("FirmEngagementAssigner", fields: [createdById, firmOrganizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
+  version Int
+  scope AccountantAccessRole
+  effectiveFrom DateTime
+  expiresAt DateTime
+  endedAt DateTime?
+  endedById String?
+  endReason String?
+  endedBy User? @relation("FirmEngagementAssignmentEnder", fields: [endedById, firmOrganizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
+  createdAt DateTime @default(now())
+
+  @@unique([engagementId, accountantUserId, version], map: "firm_assignment_version_key")
+  @@index([firmOrganizationId, accountantUserId, endedAt])
+  @@map("firm_engagement_assignments")
+}
+
+model FirmEngagementGrantLink {
+  id String @id @default(cuid())
+  engagementId String
+  firmOrganizationId String
+  clientOrganizationId String
+  engagement FirmEngagement @relation(fields: [engagementId, firmOrganizationId, clientOrganizationId], references: [id, firmOrganizationId, clientOrganizationId], onDelete: Restrict, onUpdate: Restrict)
+  grantId String @unique
+  accountantUserId String
+  grant AccountantAccessGrant @relation(fields: [grantId, clientOrganizationId, accountantUserId], references: [id, organizationId, accountantUserId], onDelete: Restrict, onUpdate: Restrict)
+  accountant User @relation("FirmLinkedAccountant", fields: [accountantUserId, firmOrganizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
+  enrolledById String
+  enrolledBy User @relation(fields: [enrolledById, firmOrganizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
+  enrolledAt DateTime @default(now())
+
+  @@unique([grantId, clientOrganizationId, accountantUserId], map: "firm_link_grant_identity_key")
+  @@index([firmOrganizationId, engagementId, accountantUserId])
+  @@map("firm_engagement_grant_links")
+}
+
+model FirmEngagementTransition {
+  id String @id @default(cuid())
+  engagementId String
+  firmOrganizationId String
+  clientOrganizationId String
+  engagement FirmEngagement @relation(fields: [engagementId, firmOrganizationId, clientOrganizationId], references: [id, firmOrganizationId, clientOrganizationId], onDelete: Restrict, onUpdate: Restrict)
+  version Int
+  fromStatus FirmEngagementStatus
+  toStatus FirmEngagementStatus
+  actorId String
+  actor User @relation(fields: [actorId, firmOrganizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)
+  reason String
+  idempotencyKey String
+  createdAt DateTime @default(now())
+
+  @@unique([engagementId, version], map: "firm_transition_version_key")
+  @@unique([engagementId, idempotencyKey], map: "firm_transition_idempotency_key")
+  @@index([firmOrganizationId, engagementId, createdAt])
+  @@map("firm_engagement_transitions")
+}
+
