+// AF09 evidence only: no operational balance or posting relation.
+model FinancialOpeningRevision {
+  id                 String       @id @default(cuid())
+  organizationId     String
+  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
+  cutoverDate        String
+  revision           Int
+  sourceFilename     String
+  controlsFilename   String
+  sourceContent      String
+  controlsContent    String
+  sourceHash         String
+  controlsHash       String
+  mappingHash        String
+  datasetHash        String
+  mappings           Json
+  manifest           Json
+  manifestDigest     String
+  commandHash        String
+  idempotencyKey     String
+  createdById        String
+  createdAt          DateTime     @default(now())
+  status             String       @default("STAGED")
+  reviewedById       String?
+  reviewedAt         DateTime?
+  reviewDigest       String?
+  reviewKey          String?
+  reviewCommandHash  String?
+  conclusion         String?
+
+  executions FinancialOpeningExecution[]
+  openingReceivables CustomerReceivableDocument[]
+  openingPayables SupplierInvoice[]
+
+  @@unique([organizationId, id])
+  @@unique([organizationId, cutoverDate, revision])
+  @@unique([organizationId, idempotencyKey])
+  @@index([organizationId, cutoverDate, sourceHash])
+  @@map("financial_opening_revisions")
+}
+
+// AF10 approvals and final receipts are retained separately from immutable previews.
+model FinancialOpeningExecution {
+  id String @id @default(cuid())
+  organizationId String
+  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
+  revisionId String
+  revision FinancialOpeningRevision @relation(fields: [organizationId, revisionId], references: [organizationId, id], onDelete: Restrict)
+  cutoverDate String
+  activeScopeKey String? @unique
+  manifestDigest String
+  periodId String
+  periodVersion Int
+  approvedById String
+  approvedAt DateTime @default(now())
+  expiresAt DateTime
+  approvalKey String
+  approvalHash String
+  conclusion String
+  status String @default("APPROVED")
+  appliedById String?
+  appliedAt DateTime?
+  applyKey String?
+  applyHash String?
+  reconciliation Json?
+  reconciliationHash String?
+  cancelledById String?
+  cancelledAt DateTime?
+  cancellationReason String?
+  operations FinancialOpeningOperation[]
+  @@unique([organizationId, id])
+  @@unique([organizationId, approvalKey])
+  @@index([organizationId, cutoverDate, approvedAt])
+  @@map("financial_opening_executions")
+}
+
+model FinancialOpeningOperation {
+  id String @id @default(cuid())
+  organizationId String
+  executionId String
+  execution FinancialOpeningExecution @relation(fields: [organizationId, executionId], references: [organizationId, id], onDelete: Restrict)
+  domain String
+  sourceId String
+  sourceHash String
+  receipt Json
+  receiptHash String
+  createdAt DateTime @default(now())
+  @@unique([executionId, domain, sourceId])
+  @@map("financial_opening_operations")
+}
