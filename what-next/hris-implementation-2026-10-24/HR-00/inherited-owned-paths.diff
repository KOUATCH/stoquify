+  instanceId String
+  version Int
+  code String
+  periodId String
+  countryCode String
+  ownerId String
+  applicability String
+  dueAt DateTime?
+  sourceHash String
+  sourceSnapshot Json
+  evidenceId String?
+  evidenceHash String?
+  decision String
+  actorId String
+  reason String
+  idempotencyKey String
+  commandHash String
+  createdAt DateTime @default(now())
+  @@unique([organizationId, instanceId, version])
+  @@unique([organizationId, idempotencyKey])
+  @@index([organizationId, periodId, createdAt])
+  @@map("firm_obligation_revisions")
+}
