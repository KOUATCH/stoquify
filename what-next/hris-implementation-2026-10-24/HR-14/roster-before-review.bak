"use client"
import { useEffect, useRef, useState, type FormEvent } from "react"
import type { getRosterWorkspace } from "@/services/hris/roster-workspace.service"
export type RosterWorkspace=Awaited<ReturnType<typeof getRosterWorkspace>>
export type RosterCommand="READ"|"PREPARE"|"APPROVE"|"PREVIEW"|"IMPORT"|"RESOLVE"|"CERTIFY"
export type RosterExecute=(command:RosterCommand,input:Record<string,unknown>)=>Promise<{success:boolean;data?:any;error?:string|null}>
export function HrisRosterWorkspace({initial,locale,execute}:{initial:RosterWorkspace;locale:"en"|"fr";execute:RosterExecute}){
  const [data,setData]=useState(initial),[busy,setBusy]=useState(false),[message,setMessage]=useState(""),[preview,setPreview]=useState<any>(null),[file,setFile]=useState<{content:string;fileName:string}|null>(null),[sourceSystem,setSourceSystem]=useState(""),[revision,setRevision]=useState<RosterWorkspace["versions"][number]|null>(null)
  const locked=useRef(false),alert=useRef<HTMLParagraphElement>(null),fileGeneration=useRef(0)
  const [fileLoading,setFileLoading]=useState(false)
  const [receipt,setReceipt]=useState<any>(null)
  const t=(en:string,fr:string)=>locale==="fr"?fr:en,control="dashboard-control w-full min-w-0 rounded border p-2"
  const employeeId=data.employees.length===1?data.employees[0].id:undefined
  useEffect(()=>{if(!busy&&message)alert.current?.focus()},[busy,message])
  const status=(value:string)=>({ACTIVE:t("Published","Publié"),DRAFT:t("Awaiting independent review","En attente de validation indépendante"),RETIRED:t("Retained previous version","Version précédente conservée"),VALIDATED:t("Validated observation","Observation validée"),REJECTED:t("Rejected observation","Observation rejetée"),OPEN:t("Open","Ouverte"),RESOLVED:t("Repaired","Corrigée"),REQUESTED:t("Awaiting decision","Décision attendue"),APPROVED:t("Approved","Approuvée"),CANCELLED:t("Cancelled","Annulée")} as Record<string,string>)[value]??value
  async function send(command:RosterCommand,values:Record<string,unknown>){
    if(locked.current)return;locked.current=true;setBusy(true);setMessage("")
    try{
      const result=await execute(command,{employeeId,...values});if(!result.success)throw Error(result.error||t("Unable to confirm.","Confirmation impossible."))
      if(command==="IMPORT")setReceipt(result.data)
      if(command==="PREVIEW")setPreview(result.data)
      else{const refreshed=command==="READ"?result:await execute("READ",{employeeId,startDate:data.startDate,days:data.days,payrollPeriodId:data.closure?.period.id});if(!refreshed.success)throw Error(t("Saved; refresh to confirm the current state.","Enregistré ; actualisez pour confirmer le statut."));setData(refreshed.data);setRevision(null);if(command==="IMPORT")setPreview(null);if(command==="READ"){setReceipt(null);fileGeneration.current++;setFile(null);setPreview(null);setFileLoading(false)}}
      setMessage(command==="PREVIEW"?t("Preview ready. Review every row before importing.","Aperçu prêt. Vérifiez chaque ligne avant l’import."):t("Current server state confirmed.","État actuel confirmé par le serveur."))
    }catch(error){setMessage(error instanceof Error?error.message:t("Refresh before retrying.","Actualisez avant de réessayer."))}finally{locked.current=false;setBusy(false)}
  }
  const form=(event:FormEvent<HTMLFormElement>)=>{event.preventDefault();return Object.fromEntries(new FormData(event.currentTarget).entries()) as Record<string,string>}
  const field=(name:string,label:string,type="text",value="",required=true)=><label className="block min-w-0">{label}<input className={control} name={name} type={type} defaultValue={value} required={required}/></label>
  function shiftIntervals(v:Record<string,string>){
    const retained=(revision?.shiftPlan as any)?.shifts??[]
    const breaks=v.breakStart||v.breakEnd?[{start:v.breakStart,end:v.breakEnd}]:[]
    return [{start:v.start,end:v.end,unpaidBreaks:[...breaks,...(retained[0]?.unpaidBreaks??[]).slice(1).map((b:any)=>({start:b.start,end:b.end}))]},...retained.slice(1).map((s:any)=>({start:s.start,end:s.end,unpaidBreaks:s.unpaidBreaks.map((b:any)=>({start:b.start,end:b.end}))}))]
  }
  return <main className="dashboard-landing-theme dark min-h-screen p-4"><div className="dashboard-landing-content mx-auto max-w-6xl space-y-6">
    <h1 className="text-2xl font-semibold">{data.own?t("My published schedule","Mon planning publié"):t("Roster and attendance closure","Planning et clôture des présences")}</h1>
    <p>{t("Planned work, recorded observations and certified payroll inputs are shown separately. Overnight work belongs wholly to its local start date.","Le travail prévu, les observations et les données certifiées de paie sont distincts. Le travail de nuit appartient entièrement à sa date locale de début.")}</p>
    <nav className="flex flex-wrap gap-4"><a className="underline" href={`/${locale}/dashboard/people/${data.own?"me":"manage"}`}>{t("People workspace","Espace du personnel")}</a>{!data.own&&<a className="underline" href={`/${locale}/dashboard/people/setup`}>{t("Calendars, policies and independent reviewers","Calendriers, politiques et validateurs indépendants")}</a>}</nav>
    {message&&<p ref={alert} tabIndex={-1} role="status" className="break-words rounded border p-3">{message}</p>}
    <form onSubmit={event=>{const v=form(event);void send("READ",{startDate:v.startDate,days:7,employeeId:v.employeeId||undefined,payrollPeriodId:v.payrollPeriodId||undefined})}}><fieldset disabled={busy} className="grid min-w-0 gap-3 sm:grid-cols-3">
      {field("startDate",t("Week starts","Début de semaine"),"date",data.startDate)}
      {!data.own&&<><label>{t("Employee identifier (blank for team)","Identifiant salarié (vide pour l’équipe)")}<input name="employeeId" className={control} defaultValue={employeeId??""}/></label><label>{t("Payroll period for closure","Période de paie à clôturer")}<select className={control} name="payrollPeriodId" defaultValue={data.closure?.period.id??""}><option value="">{t("Select period","Choisir une période")}</option>{data.periods.map(p=><option key={p.id} value={p.id}>{p.name}</option>)}</select></label></>}
      <button className="dashboard-btn-secondary rounded p-2">{t("Refresh view","Actualiser la vue")}</button></fieldset></form>
    {!data.roster.length&&<p>{t("No employees in your authorized scope.","Aucun salarié dans votre périmètre autorisé.")}</p>}
    {data.roster.map(person=><section key={person.employeeId} className="space-y-3 rounded border p-3"><h2 className="font-semibold">{person.displayName}</h2>{!data.own&&<p className="break-all text-sm">{person.employeeId}</p>}<div className="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">{person.days.map(d=><article key={d.workDate} className="min-w-0 space-y-1 rounded border p-2"><h3>{d.workDate}</h3>{d.state==="MISSING"?<p>{t("Coverage missing — review required","Couverture manquante — validation requise")}</p>:<><p>{d.minutes} {t("planned minutes","minutes prévues")} · {t("version","version")} {d.revision}</p><p className="break-words">{d.timezone}</p>{d.shiftPlan?<div>{(d.shiftPlan as any).shifts.length===0?<p>{t("Explicit off day","Repos explicite")}</p>:(d.shiftPlan as any).shifts.map((s:any,i:number)=><div key={i} className="break-words"><p>{s.start} → {s.end}</p>{s.unpaidBreaks.map((b:any,j:number)=><p key={j}>{t("Unpaid break","Pause non rémunérée")}: {b.start} → {b.end}</p>)}</div>)}</div>:<p>{t("Recurring office minutes; clock times not declared.","Minutes récurrentes de bureau ; horaires non déclarés.")}</p>}</>}</article>)}</div></section>)}
    {data.canManage&&employeeId&&<section className="space-y-3 rounded border p-3"><h2 className="text-xl font-semibold">{revision?t("Prepare same-interval revision","Préparer une révision du même intervalle"):t("Prepare schedule","Préparer un planning")}</h2><p>{t("A finite dated plan temporarily overrides an older recurring plan, which resumes afterward. An independent reviewer publishes the draft. Clock times require an explicit offset matching the calendar timezone.","Un planning daté temporaire remplace la récurrence antérieure, qui reprend ensuite. Un validateur indépendant publie le brouillon. Le décalage horaire explicite doit correspondre au fuseau du calendrier.")}</p>
      <form key={employeeId+":"+(revision?.id??"new")} onSubmit={event=>{const v=form(event),calendar=data.calendars.find(c=>c.id===v.calendarId);if(!calendar)return;const dated=v.kind!=="OFFICE",pattern=Object.fromEntries(["sun","mon","tue","wed","thu","fri","sat"].map(k=>[k,Number(v[k]??0)]));void send("PREPARE",{calendarId:calendar.id,name:v.name,timezone:calendar.timezone,effectiveFrom:v.effectiveFrom,effectiveTo:dated?v.effectiveFrom:v.effectiveTo||null,weeklyPattern:pattern,standardWeeklyMinutes:Object.values(pattern).reduce((a,b)=>a+b,0),sourceHash:v.evidence,...(revision?{supersedesScheduleId:revision.id,expectedSourceHash:revision.sourceHash}:{}),...(dated?{shiftPlan:{workDate:v.effectiveFrom,timezone:calendar.timezone,shifts:v.kind==="OFF"?[]:shiftIntervals(v)}}:{})})}}>
        <fieldset disabled={busy} className="grid min-w-0 gap-3 sm:grid-cols-2">
          {field("name",t("Schedule name","Nom du planning"),"text",revision?.name??"")}
          <label>{t("Reviewed calendar","Calendrier validé")}<select name="calendarId" className={control} required defaultValue={revision?.calendarId}>{data.calendars.map(c=><option key={c.id} value={c.id}>{c.name} · {c.timezone}</option>)}</select></label>
          <label>{t("Plan type","Type de planning")}<select name="kind" className={control} defaultValue={revision?.shiftPlan?((revision.shiftPlan as any).shifts?.length?"SHIFT":"OFF"):"OFFICE"}><option value="OFFICE">{t("Recurring office minutes","Minutes récurrentes de bureau")}</option><option value="SHIFT">{t("Dated shift","Poste daté")}</option><option value="OFF">{t("Dated off day","Repos daté")}</option></select></label>
          {field("effectiveFrom",t("Start work date","Date locale de début"),"date",revision?.effectiveFrom??data.startDate)}{field("effectiveTo",t("Last office date (optional)","Dernière date de bureau (facultative)"),"date",revision?.effectiveTo??"",false)}
          <div className="grid grid-cols-2 gap-2">{["sun","mon","tue","wed","thu","fri","sat"].map((k,i)=>field(k,[t("Sunday","Dimanche"),t("Monday","Lundi"),t("Tuesday","Mardi"),t("Wednesday","Mercredi"),t("Thursday","Jeudi"),t("Friday","Vendredi"),t("Saturday","Samedi")][i]+" (min)","number",String((revision?.weeklyPattern as any)?.[k]??(revision?.weeklyPattern as any)?.[String(i)]??(i>0&&i<6?480:0))))}</div>
          {field("start",t("Shift start · YYYY-MM-DDTHH:mm+HH:mm","Début du poste · AAAA-MM-JJTHH:mm+HH:mm"),"text",(revision?.shiftPlan as any)?.shifts?.[0]?.start??"",false)}{field("end",t("Shift end with offset","Fin du poste avec décalage horaire"),"text",(revision?.shiftPlan as any)?.shifts?.[0]?.end??"",false)}
          {field("breakStart",t("Unpaid break start (optional)","Début de pause non rémunérée (facultatif)"),"text",(revision?.shiftPlan as any)?.shifts?.[0]?.unpaidBreaks?.[0]?.start??"",false)}{field("breakEnd",t("Unpaid break end (optional)","Fin de pause non rémunérée (facultative)"),"text",(revision?.shiftPlan as any)?.shifts?.[0]?.unpaidBreaks?.[0]?.end??"",false)}{field("evidence",t("Preparation evidence reference","Référence de preuve de préparation"))}
          <button className="dashboard-btn-primary rounded p-2">{t("Save draft for review","Enregistrer le brouillon à valider")}</button>{revision&&<button type="button" onClick={()=>setRevision(null)}>{t("Cancel revision","Annuler la révision")}</button>}
        </fieldset></form></section>}
    {!data.own&&<section className="space-y-3"><h2 className="text-xl font-semibold">{t("Schedule versions","Versions du planning")}</h2>{data.versions.map(v=><article key={v.id} className="min-w-0 space-y-2 rounded border p-3"><h3>{v.name} · {status(v.status)} · v{v.revision}</h3><p>{v.effectiveFrom} → {v.effectiveTo??t("Open ended","Sans date de fin")} · {v.timezone}</p><details><summary>{t("Review planned facts and lineage","Vérifier les faits prévus et la filiation")}</summary><pre className="whitespace-pre-wrap break-all text-sm">{JSON.stringify({weeklyMinutes:v.weeklyPattern,shift:v.shiftPlan,predecessor:v.supersedesScheduleId},null,2)}</pre></details>{data.canManage&&employeeId&&v.status==="ACTIVE"&&<button disabled={busy} className="dashboard-btn-secondary rounded p-2" onClick={()=>setRevision(v)}>{t("Revise this interval","Réviser cet intervalle")}</button>}{v.canApprove&&<form onSubmit={event=>{const values=form(event);void send("APPROVE",{employeeId:v.employeeId,scheduleId:v.id,approvalEvidenceHash:values.evidence})}}><fieldset disabled={busy} className="space-y-2">{field("evidence",t("Independent review evidence","Preuve de validation indépendante"))}<button className="dashboard-btn-primary rounded p-2">{t("Publish reviewed schedule","Publier le planning validé")}</button></fieldset></form>}</article>)}</section>}
    {data.canManage&&<section className="space-y-3 rounded border p-3"><h2 className="text-xl font-semibold">{t("Import observed attendance","Importer les présences observées")}</h2><p>{t("UTF-8 CSV, 1–200 rows, exact columns below. One daily total per employee; do not infer presence from the roster. Changed validated observations require the correction request workflow.","CSV UTF-8, 1 à 200 lignes, colonnes exactes ci-dessous. Un total quotidien par salarié ; ne déduisez pas la présence du planning. Les observations validées modifiées exigent une demande de correction.")}</p><p className="break-all text-sm">sourceRecordId,employeeId,workDate,scheduledMinutes,workedMinutes,absenceMinutes,overtimeMinutes</p>
      <label className="block">{t("Attendance source","Source des présences")}<input className={control} value={sourceSystem} onChange={e=>{setSourceSystem(e.target.value);setPreview(null)}} disabled={busy}/></label>
      <label className="block">{t("Attendance CSV file","Fichier CSV de présences")}<input className={control} type="file" accept=".csv,text/csv" disabled={busy} onChange={async e=>{const generation=++fileGeneration.current;setPreview(null);setFile(null);const f=e.target.files?.[0];if(!f){setFileLoading(false);return}setFileLoading(true);try{if(f.size>262144)throw Error(t("File limit: 256 KiB.","Limite : 256 Kio."));const content=new TextDecoder("utf-8",{fatal:true}).decode(await f.arrayBuffer());if(generation===fileGeneration.current)setFile({fileName:f.name,content})}catch(error){if(generation===fileGeneration.current)setMessage(error instanceof Error?error.message:"Invalid UTF-8")}finally{if(generation===fileGeneration.current)setFileLoading(false)}}}/></label>
      <button disabled={busy||fileLoading||!file||!sourceSystem.trim()} className="dashboard-btn-secondary rounded p-2" onClick={()=>void send("PREVIEW",{...file,sourceSystem})}>{t("Preview attendance file","Prévisualiser le fichier de présences")}</button>
      {fileLoading&&<p role="status">{t("Reading selected file…","Lecture du fichier sélectionné…")}</p>}{file&&<p>{t("Selected for preview: ","Sélectionné pour aperçu : ")}{file.fileName}</p>}{preview&&<><ul className="space-y-1">{preview.rows.map((r:any)=><li key={r.index} className="break-words">{r.index+1} · {r.workDate} · {r.employeeId} · {r.sourceRecordId} · {t("Scheduled / worked / absent / overtime (min): ","Prévues / travaillées / absentes / supplémentaires (min) : ")}{r.scheduledMinutes} / {r.workedMinutes} / {r.absenceMinutes} / {r.overtimeMinutes} · {r.duplicate?t("Already retained; no new time","Déjà conservée ; aucun temps ajouté"):r.issues.length?r.issues.join(", "):t("Ready","Prête")}</li>)}</ul><button disabled={busy} className="dashboard-btn-primary rounded p-2" onClick={()=>void send("IMPORT",{...file,sourceSystem,previewHash:preview.payloadHash})}>{t("Import reviewed rows","Importer les lignes vérifiées")}</button></>}
    </section>}
    {receipt&&<section aria-label={t("Import receipt","Reçu d’import")} className="space-y-2 rounded border p-3"><h2>{t("Import receipt","Reçu d’import")}</h2><p className="break-all">{receipt.id}</p><p>{t("Accepted / rejected / unchanged: ","Acceptées / rejetées / inchangées : ")}{receipt.acceptedCount} / {receipt.rejectedCount} / {receipt.metadata?.duplicateCount??0}</p><p>{receipt.replayed?t("Retained result recovered; no new observations.","Résultat conservé récupéré ; aucune nouvelle observation."):t("Import recorded. Review rejected observations in the closure desk.","Import enregistré. Vérifiez les observations rejetées dans la clôture.")}</p></section>}
    {data.closure&&<section key={employeeId+":"+data.closure.period.id} className="space-y-3 rounded border p-3"><h2 className="text-xl font-semibold">{t("Attendance closure","Clôture des présences")} · {data.closure.period.name}</h2><p>{data.closure.period.start} → {data.closure.period.end}</p><p>{data.closure.readiness.ready?t("Ready for independent certification","Prête pour certification indépendante"):t("Certification blocked. Resolve the source issues below.","Certification bloquée. Résolvez les problèmes de source ci-dessous.")}</p>{!data.closure.readiness.ready&&<p className="break-words">{data.closure.readiness.message}</p>}
      <h3>{t("Original observations and approved corrections","Observations originales et corrections approuvées")}</h3><ul className="space-y-2">{data.closure.entries.map(e=><li key={e.id} className="break-words rounded border p-2">{e.workDate} · {status(e.status)} · {e.workedMinutes} {t("recorded minutes","minutes enregistrées")} → {e.correctedWorkedMinutes} {t("after correction","après correction")} · {e.absenceMinutes} {t("absence minutes","minutes d’absence")}<details><summary>{t("Observation reference","Référence d’observation")}</summary><p className="break-all">{e.id}</p><p>{e.sourceSystem} · {e.sourceRecordId}</p></details></li>)}</ul>
      {data.closure.anomalies.map(a=><article key={a.id} className="space-y-2 rounded border p-2"><p>{a.code} · {status(a.status)}</p>{a.status==="OPEN"&&data.canManage&&<form onSubmit={event=>{const v=form(event);void send("RESOLVE",{anomalyId:a.id,status:"RESOLVED",replacementEntryId:v.replacementEntryId,resolutionHash:v.evidence})}}><fieldset disabled={busy} className="space-y-2"><label>{t("Validated replacement observation","Observation de remplacement validée")}<select name="replacementEntryId" className={control} required>{data.closure!.entries.filter(e=>e.status==="VALIDATED").map(e=><option key={e.id} value={e.id}>{e.workDate} · {e.workedMinutes} min · {e.sourceRecordId}</option>)}</select></label>{field("evidence",t("Repair evidence reference","Référence de preuve de correction"))}<button className="dashboard-btn-secondary rounded p-2">{t("Verify repair and close anomaly","Vérifier la correction et clôturer l’anomalie")}</button></fieldset></form>}</article>)}
      <h3>{t("Leave, overtime and correction decisions","Décisions de congés, heures supplémentaires et corrections")}</h3><ul>{data.closure.requests.map(r=><li key={r.id}>{r.type} · {status(r.status)} · {r.minutes} min</li>)}</ul><a href={`/${locale}/dashboard/people/approvals`} className="underline">{t("Review pending decisions","Examiner les décisions en attente")}</a><a href={`/${locale}/dashboard/people/me`} className="block underline">{t("Request a correction to my observations","Demander une correction de mes observations")}</a>
      {data.canManage&&<form onSubmit={event=>{const v=form(event);void send("CERTIFY",{payrollPeriodId:data.closure!.period.id,approvalEvidenceHash:v.evidence})}}><fieldset disabled={busy||!data.closure.readiness.ready} className="space-y-2">{field("evidence",t("Certification evidence reference","Référence de preuve de certification"))}<button className="dashboard-btn-primary rounded p-2">{t("Certify reviewed period","Certifier la période vérifiée")}</button></fieldset></form>}
      <h3>{t("Retained certification history","Historique des certifications conservées")}</h3><ul>{data.closure.snapshots.map(s=><li key={s.id} className="break-all">{s.workedMinutes} min · {s.correctedFromId?t("Correction of ","Correction de ")+s.correctedFromId:t("Initial certification","Certification initiale")} · {s.id}</li>)}</ul>
    </section>}
  </div></main>
}
