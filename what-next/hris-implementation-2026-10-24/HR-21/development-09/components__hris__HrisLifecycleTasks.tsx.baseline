"use client"
import {useRef,useState} from 'react'
import {Button} from '@/components/ui/button'
import {Input} from '@/components/ui/input'
import {Label} from '@/components/ui/label'
import {Card,CardHeader,CardTitle,CardContent} from '@/components/ui/card'
import type {getLifecycleTaskWorkspace} from '@/services/hris/lifecycle-task.service'
export type LifecycleTaskWorkspace=Awaited<ReturnType<typeof getLifecycleTaskWorkspace>>
export type LifecycleTaskTransport=(operation:'READ'|'DECIDE'|'RESCHEDULE',input?:unknown)=>Promise<any>
export function HrisLifecycleTasks({initial,locale,execute}:{initial:LifecycleTaskWorkspace;locale:'en'|'fr';execute:LifecycleTaskTransport}){
 const t=(en:string,fr:string)=>locale==='fr'?fr:en,labels:Record<string,string>={HR_PREPARATION:t('HR preparation','Préparation RH'),APPLICATION_ACCESS:t('Application account access','Accès au compte applicatif'),EXTERNAL_ACCESS:t('External system access','Accès aux systèmes externes'),ASSETS:t('Asset handover','Remise des équipements'),CREATED:t('Created from approved employment','Créée à partir de l’emploi approuvé'),SOURCE_CANCELLED:t('Employment request cancelled','Demande d’emploi annulée'),RESCHEDULE_REQUESTED:t('Replacement awaiting approval','Remplacement en attente d’approbation'),OPEN:t('Pending work','Travail en attente'),FAILED:t('Failed — retry or escalate','Échec — réessayer ou faire remonter'),AWAITING_REVIEW:t('Evidence awaiting review','Preuves en attente de vérification'),COMPLETED:t('Manual completion reviewed','Réalisation manuelle vérifiée'),CANCELLED:t('Source cancelled','Source annulée'),SUBMIT:t('Submit completion evidence','Soumettre les preuves de réalisation'),FAIL:t('Record failure / escalate','Enregistrer l’échec / faire remonter'),RETRY:t('Retry manual work','Réessayer le travail manuel'),APPROVE:t('Verify completion evidence','Vérifier les preuves de réalisation'),RETURN:t('Return for evidence','Demander des preuves'),REASSIGN:t('Use configured replacement owners','Utiliser les nouveaux responsables configurés')}
 const [accessDenied,setAccessDenied]=useState(false)
 const [data,setData]=useState(initial),[filter,setFilter]=useState('ALL'),[selected,setSelected]=useState<string|null>(null),[operation,setOperation]=useState('SUBMIT'),[reason,setReason]=useState(''),[evidence,setEvidence]=useState(''),[ack,setAck]=useState(false),[busy,setBusy]=useState(false),[error,setError]=useState(''),[notice,setNotice]=useState(''),[retry,setRetry]=useState<{operation:'DECIDE'|'RESCHEDULE';input:any}|null>(null),[effectiveAt,setEffectiveAt]=useState('');const message=useRef<HTMLParagraphElement>(null)
 const row=data.tasks.find(t=>t.id===selected),choices=(r:LifecycleTaskWorkspace['tasks'][number])=>r.sourceState!=='ACTIVE'||['COMPLETED','CANCELLED'].includes(r.status)?[]:[...(r.canWork&&['OPEN','FAILED'].includes(r.status)?['SUBMIT','FAIL',...(r.status==='FAILED'?['RETRY']:[])]:[]),...(r.canReview&&r.status==='AWAITING_REVIEW'?['APPROVE','RETURN']:[]),...(r.canReassign?['REASSIGN']:[])]
 async function refresh(){setData(await execute('READ'));setAccessDenied(false)}
 async function run(fn:()=>Promise<void>,write=false){setBusy(true);setError('');setNotice('');try{await fn()}catch(e){const failure=e as {status?:number;code?:string};if(failure.code==="FRESH_AUTH_REQUIRED"){setError(t("Verify your password, then explicitly retry the unchanged request.","Vérifiez votre mot de passe, puis réessayez explicitement la demande inchangée."))}else if(failure.status===401||failure.status===403||["AUTH_REQUIRED","FORBIDDEN","TENANT_SCOPE_VIOLATION"].includes(failure.code??"")){setAccessDenied(true);setError(t("Access is no longer authorized. Private details are hidden. Restore access before refreshing or recovering the original result.","L’accès n’est plus autorisé. Les détails confidentiels sont masqués. Rétablissez l’accès avant d’actualiser ou de récupérer le résultat initial."))}else if([400,404,409,422].includes((e as {status?:number}).status??0)){setRetry(null);setAck(false);setError(t('The task or your access changed, or evidence is incomplete. Refresh and review the task; your draft is retained.','La tâche ou vos droits ont changé, ou les preuves sont incomplètes. Actualisez et vérifiez la tâche ; votre brouillon est conservé.'))}else setError(write?t('Outcome unconfirmed. Recover the recorded result before starting another action.','Résultat incertain. Récupérez le résultat enregistré avant une autre action.'):t('The current task list is unavailable. Retry Refresh tasks.','La liste actuelle est indisponible. Réessayez Actualiser les tâches.'))}finally{setBusy(false);setTimeout(()=>message.current?.focus(),0)}}
 async function send(envelope:NonNullable<typeof retry>){setRetry(envelope);await execute(envelope.operation,envelope.input);setRetry(null);setSelected(null);setReason('');setEvidence('');setAck(false);setNotice(t('Task outcome recorded. External actions are not executed by this workspace.','Résultat de la tâche enregistré. Cet espace n’exécute aucune action externe.'));try{await refresh()}catch(e){const failure=e as {status?:number;code?:string};if(failure.status===401||failure.status===403||["AUTH_REQUIRED","FORBIDDEN","TENANT_SCOPE_VIOLATION"].includes(failure.code??""))setAccessDenied(true);setNotice(t('Task outcome recorded. Refresh tasks to reload the list.','Résultat enregistré. Actualisez les tâches pour recharger la liste.'))}}
 if(accessDenied)return <main className="space-y-4 p-4"><h1>{t("Access needs to be restored","L’accès doit être rétabli")}</h1><p ref={message} tabIndex={-1} role={error?"alert":"status"}>{error||notice}</p><Button disabled={busy} onClick={()=>run(async()=>{await refresh()})}>{t("Refresh tasks","Actualiser les tâches")}</Button>{retry&&<Button disabled={busy} onClick={()=>run(()=>send(retry),true)}>{t("Recover recorded result","Récupérer le résultat enregistré")}</Button>}</main>
 const filtered=data.tasks.filter(r=>filter==='ALL'||filter==='OVERDUE'&&r.overdue||r.status===filter)
 return <main className="mx-auto max-w-4xl min-w-0 space-y-4 p-4"><h1 className="text-2xl font-semibold">{t('Starter and leaver tasks','Tâches d’entrée et de sortie')}</h1><p>{t('Assigned work, retained evidence and independent verification. Employment, application access, external access and assets remain separate.','Travail attribué, preuves conservées et vérification indépendante. Emploi, accès applicatif, accès externes et équipements restent distincts.')}</p><p className="text-sm">{t('As of: ','Situation au : ')}{new Date(data.asOf).toLocaleString(locale)}</p>
 <p ref={message} tabIndex={-1} role={error?'alert':'status'}>{error||notice}</p><Button disabled={busy} variant="outline" onClick={()=>run(async()=>{await refresh();if(!retry){setSelected(null);setAck(false)}})}>{t('Refresh tasks','Actualiser les tâches')}</Button>{retry&&<Button disabled={busy} onClick={()=>run(()=>send(retry),true)}>{t('Recover recorded result','Récupérer le résultat enregistré')}</Button>}
 {!data.configured&&<p role="status">{locale==='fr'?data.support.fr:data.support.en}</p>}<p>{t('Escalation contact: ','Contact pour faire remonter un problème : ')}{locale==='fr'?data.support.fr:data.support.en}</p>
 <Label htmlFor="task-filter">{t('Task status','Statut des tâches')}</Label><select id="task-filter" className="w-full rounded-md border bg-background p-2" value={filter} onChange={e=>setFilter(e.target.value)}>{['ALL','OVERDUE','OPEN','FAILED','AWAITING_REVIEW','COMPLETED','CANCELLED'].map(s=><option key={s} value={s}>{s==='ALL'?t('All assigned tasks','Toutes les tâches attribuées'):s==='OVERDUE'?t('Overdue','En retard'):labels[s]}</option>)}</select><p>{filtered.length} / {data.tasks.length} {t('authorized tasks','tâches autorisées')}{data.truncated?' · '+t('Recent 800 shown; contact HR for older history.','800 tâches affichées ; contactez les RH pour l’historique antérieur.'):''}</p>
 {!filtered.length&&<p>{t('No assigned tasks in this view.','Aucune tâche attribuée dans cette vue.')}</p>}
 {filtered.map(r=><Card key={r.id} data-task-id={r.id}><CardHeader><CardTitle className="break-words">{r.employeeName} · {labels[r.code]}</CardTitle></CardHeader><CardContent className="space-y-3 break-words"><p>{labels[r.status]}{r.overdue?' · '+t('Overdue','En retard'):''}{r.sourceState==='CANCELLED'&&r.status==='COMPLETED'?' · '+t('Source cancelled; evidence retained','Source annulée ; preuves conservées'):''}</p><p>{t('Owner: ','Responsable : ')}{r.ownerName} · {t('Reviewer: ','Vérificateur : ')}{r.reviewerName}</p><p>{t('Due: ','Échéance : ')}{new Date(r.dueAt).toLocaleString(locale)} · {t('Effective employment: ','Date d’effet de l’emploi : ')}{new Date(r.effectiveAt).toLocaleString(locale)}</p><p>{locale==='fr'?r.template.evidenceInstructionsFr:r.template.evidenceInstructionsEn}</p><p>{t('Prerequisites: ','Préalables : ')}{r.template.dependsOn.length?r.template.dependsOn.map(code=>labels[code]).join(', '):t('None','Aucun')}</p>{r.code!=='HR_PREPARATION'&&<p>{t('Completion requires the effective employment event to be applied and prerequisite tasks to be verified. Use the separately authorized account or external workflow first.','La réalisation exige l’application du changement d’emploi et la vérification des tâches préalables. Utilisez d’abord le circuit de compte ou externe autorisé séparément.')}</p>}{r.evidenceReference&&<p>{t('Retained evidence reference: ','Référence de preuve conservée : ')}{r.evidenceReference}</p>}{r.documentId&&<a className="underline" href={`/${locale}/dashboard/people/documents?employeeId=${encodeURIComponent(r.employeeId)}`}>{t('Open protected evidence (separate permission required)','Ouvrir les preuves protégées (autorisation distincte requise)')}</a>}<details><summary>{t('Task history','Historique de la tâche')}</summary><ol className="list-decimal pl-5">{r.history.map((h,i)=><li key={i}>{new Date(h.at).toLocaleString(locale)} · {labels[h.operation]??h.operation}<p>{h.reason}</p></li>)}</ol></details>
 {choices(r).length>0&&<Button variant="outline" disabled={busy||!!retry} onClick={()=>{setSelected(r.id);setOperation(choices(r)[0]);setReason('');setEvidence('');setAck(false)}}>{t('Review task','Vérifier la tâche')}</Button>}
 {row?.id===r.id&&<section className="space-y-3 border-t pt-3" aria-label={t('Task decision','Décision de tâche')}><form className="space-y-3" onSubmit={e=>{e.preventDefault();if(!choices(r).includes(operation))return;void run(()=>send({operation:'DECIDE',input:{taskId:r.id,revision:r.revision,operation,reason,acknowledged:ack,idempotencyKey:crypto.randomUUID(),...(operation==='SUBMIT'?{evidenceReference:evidence}:{})}}),true)}}><fieldset disabled={busy||!!retry} className="space-y-3"><Label htmlFor="task-operation">{t('Action','Action')}</Label><select id="task-operation" value={operation} onChange={e=>{setOperation(e.target.value);setAck(false)}} className="w-full rounded-md border bg-background p-2">{choices(r).map(o=><option key={o} value={o}>{labels[o]}</option>)}</select>{operation==='SUBMIT'&&<><Label htmlFor="task-evidence">{t('Evidence reference','Référence de preuve')}</Label><Input id="task-evidence" required minLength={8} maxLength={500} value={evidence} onChange={e=>setEvidence(e.target.value)}/><p>{t('Use a retained ticket, signed checklist or provider receipt; avoid secrets and personal data in this reference.','Utilisez un ticket conservé, une liste signée ou un reçu du prestataire ; évitez les secrets et données personnelles dans cette référence.')}</p></>}<Label htmlFor="task-reason">{t('Reason and result','Motif et résultat')}</Label><textarea id="task-reason" required minLength={8} maxLength={1000} value={reason} onChange={e=>setReason(e.target.value)} className="w-full rounded-md border bg-background p-2"/><label className="flex items-start gap-2"><input type="checkbox" checked={ack} onChange={e=>setAck(e.target.checked)}/>{t('I checked the source, responsibilities and retained evidence. This is a manual attestation, not connector confirmation.','J’ai vérifié la source, les responsabilités et les preuves conservées. Il s’agit d’une attestation manuelle, pas d’une confirmation de connecteur.')}</label></fieldset><Button type="submit" disabled={busy||!!retry||!ack||reason.trim().length<8}>{t('Record task outcome','Enregistrer le résultat')}</Button></form>
 {r.canReview&&['TERMINATE','OFFBOARD'].includes(r.lifecycleType)&&new Date(r.effectiveAt)>new Date()&&<details><summary>{t('Request a revised departure date','Demander une nouvelle date de départ')}</summary><p>{t('The old request and pending tasks are cancelled. A replacement employment request needs another HR approver; current employment and access remain unchanged. HR management authority is required.','L’ancienne demande et les tâches en attente sont annulées. La nouvelle demande exige un autre approbateur RH ; l’emploi et les accès actuels restent inchangés. L’autorité de gestion RH est requise.')}</p><Label htmlFor="task-effective">{t('New departure date','Nouvelle date de départ')}</Label><Input id="task-effective" type="date" value={effectiveAt} onChange={e=>setEffectiveAt(e.target.value)}/><Button disabled={busy||!!retry||!ack||reason.length<8||!effectiveAt} onClick={()=>run(()=>send({operation:'RESCHEDULE',input:{taskId:r.id,revision:r.revision,effectiveAt:new Date(effectiveAt+'T00:00:00Z').toISOString(),reason,acknowledged:ack,idempotencyKey:crypto.randomUUID()}}),true)}>{t('Request replacement for approval','Demander un remplacement à approuver')}</Button></details>}</section>}
 </CardContent></Card>)}
 </main>
}
