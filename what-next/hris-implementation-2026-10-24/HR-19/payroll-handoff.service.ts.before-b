import 'server-only'
import {randomUUID} from 'node:crypto'
import {Prisma} from '@prisma/client'
import {z} from 'zod'
import {db} from '@/prisma/db'
import {BusinessRuleError,ConflictError,ForbiddenError,NotFoundError} from '@/services/_shared/action-errors'
import {hasAnyRbacPermission} from '@/lib/security/rbac-permissions'
import {stableJsonStringify} from '@/services/events/business-event.service'
import type {SelfServiceActor} from './self-service-boundary.service'
import {handoffActor,handoffPermission,readHandoffInputsInTx} from './payroll-handoff-read.service'
import {handoffPolicy,handoffSelectionSchema,handoffIssueSchema,handoffReceiptSchema,handoffHash,handoffBytesHash,handoffCsv,reconcileHandoffReceipt,type HandoffManifest} from './payroll-handoff.contract'
type Tx=Prisma.TransactionClient
type Package={id:string;organizationId:string;payrollPeriodId:string;version:number;recipientUserId:string;issuedById:string;idempotencyKey:string;requestHash:string;previewHash:string;manifestJson:HandoffManifest;manifestBytes:string;csvBytes:string;manifestHash:string;csvHash:string;packageHash:string;replacesPackageId:string|null;issuedAt:Date}
type Receipt={id:string;organizationId:string;packageId:string;actorId:string;idempotencyKey:string;requestHash:string;packageHash:string;status:'ACKNOWLEDGED'|'CORRECTION_REQUESTED';acceptedRowIds:string[];rejectedRows:Array<{rowId:string;reason:string}>;reference:string;recordedAt:Date}
const transaction=<T>(client:typeof db,fn:(tx:Tx)=>Promise<T>)=>client.$transaction(fn,{isolationLevel:Prisma.TransactionIsolationLevel.ReadCommitted,maxWait:15000,timeout:120000})
const manager=(a:SelfServiceActor)=>hasAnyRbacPermission(a.actorPermissions,['hris.people.manage'])
const summary=(p:Package)=>({id:p.id,payrollPeriodId:p.payrollPeriodId,version:p.version,packageHash:p.packageHash,previewHash:p.previewHash,replacesPackageId:p.replacesPackageId,issuedAt:p.issuedAt.toISOString(),recipientUserId:p.recipientUserId,employeeCount:p.manifestJson.rows.length})
const publicReceipt=(r:Receipt)=>({id:r.id,packageId:r.packageId,packageHash:r.packageHash,status:r.status,acceptedRowIds:r.acceptedRowIds,rejectedRows:r.rejectedRows,reference:r.reference,recordedAt:r.recordedAt.toISOString()})
async function profileLock(tx:Tx,org:string){await tx.$queryRaw`SELECT pg_advisory_xact_lock(hashtextextended(${"hris-profile:"+org},0))::text`}
async function audit(tx:Tx,a:SelfServiceActor,entityId:string,operation:string,changes:Prisma.InputJsonValue){await tx.auditLog.create({data:{organizationId:a.organizationId,userId:a.actorId,entityType:'HrisPayrollHandoff',entityId,action:'HRIS_HANDOFF_'+operation,changes}})}
async function event(tx:Tx,a:SelfServiceActor,id:string,kind:string,payload:Record<string,string|number>){await tx.businessEvent.create({data:{organizationId:a.organizationId,eventType:'hris.payroll.handoff.'+kind,status:'APPLIED',actorId:a.actorId,sourceId:id,idempotencyKey:'hris-handoff:'+kind+':'+id,payloadHash:handoffHash(payload),payload,occurredAt:new Date()}})}
async function packageRow(tx:Tx,a:SelfServiceActor,id:string){const rows=await tx.$queryRaw<Package[]>`SELECT * FROM hris_payroll_handoff_packages WHERE id=${id} AND "organizationId"=${a.organizationId}`;const p=rows[0];if(!p||!manager(a)&&p.recipientUserId!==a.actorId)throw new NotFoundError();return p}
function verifyBytes(p:Package){if(handoffBytesHash(p.manifestBytes)!==p.manifestHash||handoffBytesHash(p.csvBytes)!==p.csvHash||handoffHash({manifestHash:p.manifestHash,csvHash:p.csvHash})!==p.packageHash||handoffHash(JSON.parse(p.manifestBytes))!==handoffHash(p.manifestJson))throw new BusinessRuleError('HRIS_HANDOFF_ARTIFACT_INTEGRITY_FAILED')}
async function freshness(tx:Tx,a:SelfServiceActor,p:Package){
 const successors=await tx.$queryRaw<Array<{id:string}>>`SELECT id FROM hris_payroll_handoff_packages WHERE "organizationId"=${a.organizationId} AND "replacesPackageId"=${p.id}`
 if(successors.length)return 'SUPERSEDED' as const
 try{const current=await readHandoffInputsInTx(tx,a,p.payrollPeriodId,manager(a)?undefined:p.id);return current.blockers.length||current.previewHash!==p.previewHash?'STALE' as const:'CURRENT' as const}
 catch(e){if(e instanceof BusinessRuleError||e instanceof ConflictError||e instanceof ForbiddenError||e instanceof NotFoundError)return 'UNAVAILABLE' as const;throw e}
}
export async function previewPayrollHandoff(actor:SelfServiceActor,raw:unknown,client:typeof db=db){const input=handoffSelectionSchema.parse(raw);return transaction(client,async tx=>{const a=await handoffActor(tx,actor);handoffPermission(a,'hris.people.manage');const r=await readHandoffInputsInTx(tx,a,input.payrollPeriodId);await audit(tx,a,input.payrollPeriodId,'PREVIEW',{previewHash:r.previewHash,employeeCount:r.manifest.rows.length,blockerCount:r.blockers.length});return {scopeKey:a.organizationId+':'+a.actorId,asOf:r.asOf,manifest:r.manifest,blockers:r.blockers,previewHash:r.previewHash}})}
export async function issuePayrollHandoff(actor:SelfServiceActor,raw:unknown,client:typeof db=db){const input=handoffIssueSchema.parse(raw);return transaction(client,async tx=>{
 const a=await handoffActor(tx,actor,true);handoffPermission(a,'hris.people.manage');const requestHash=handoffHash({...input,actorId:a.actorId})
 await profileLock(tx,a.organizationId)
 const prior=await tx.$queryRaw<Package[]>`SELECT * FROM hris_payroll_handoff_packages WHERE "organizationId"=${a.organizationId} AND "issuedById"=${a.actorId} AND "idempotencyKey"=${input.idempotencyKey}`
 if(prior[0]){if(prior[0].requestHash!==requestHash)throw new ConflictError('HRIS_HANDOFF_REPLAY_CONFLICT');verifyBytes(prior[0]);return summary(prior[0])}
 const current=await readHandoffInputsInTx(tx,a,input.payrollPeriodId)
 if(current.policy.recipientUserId===a.actorId)throw new ForbiddenError('Issuer and recipient must be different people.')
 if(current.blockers.length)throw new BusinessRuleError('HRIS_HANDOFF_MANDATORY_INPUTS_BLOCKED')
 if(current.previewHash!==input.previewHash)throw new ConflictError('HRIS_HANDOFF_PREVIEW_STALE')
 const latest=(await tx.$queryRaw<Package[]>`SELECT * FROM hris_payroll_handoff_packages WHERE "organizationId"=${a.organizationId} AND "payrollPeriodId"=${input.payrollPeriodId} ORDER BY version DESC LIMIT 1`)[0]
 if((latest?.id??undefined)!==input.replacesPackageId)throw new ConflictError('HRIS_HANDOFF_REPLACEMENT_MUST_REFERENCE_LATEST')
 if(latest&&latest.previewHash===current.previewHash)throw new ConflictError('HRIS_HANDOFF_SOURCE_UNCHANGED')
 const id=randomUUID(),issuedAt=new Date(),version=(latest?.version??0)+1,manifest={...current.manifest,packageId:id,packageVersion:version,issuedAt:issuedAt.toISOString(),issuedById:a.actorId,replacesPackageId:latest?.id??null},manifestBytes=stableJsonStringify(manifest),csvBytes=handoffCsv(current.manifest),manifestHash=handoffBytesHash(manifestBytes),csvHash=handoffBytesHash(csvBytes),packageHash=handoffHash({manifestHash,csvHash})
 const rows=await tx.$queryRaw<Package[]>`INSERT INTO hris_payroll_handoff_packages (id,"organizationId","payrollPeriodId",version,"recipientUserId","issuedById","idempotencyKey","requestHash","previewHash","manifestJson","manifestBytes","csvBytes","manifestHash","csvHash","packageHash","replacesPackageId","issuedAt") VALUES (${id},${a.organizationId},${input.payrollPeriodId},${version},${current.policy.recipientUserId},${a.actorId},${input.idempotencyKey},${requestHash},${current.previewHash},${JSON.stringify(manifest)}::jsonb,${manifestBytes},${csvBytes},${manifestHash},${csvHash},${packageHash},${latest?.id??null},${issuedAt}) RETURNING *`
 await event(tx,a,id,'issued',{packageId:id,packageHash,version,employeeCount:manifest.rows.length});await audit(tx,a,id,'ISSUED',{packageHash,version,employeeCount:manifest.rows.length,replacesPackageId:latest?.id??null});return summary(rows[0])
})}
export async function getPayrollHandoffPackage(actor:SelfServiceActor,raw:unknown,client:typeof db=db){const input=z.object({packageId:z.string().uuid()}).strict().parse(raw);return transaction(client,async tx=>{const a=await handoffActor(tx,actor),p=await packageRow(tx,a,input.packageId);verifyBytes(p);const status=await freshness(tx,a,p),receipts=await tx.$queryRaw<Receipt[]>`SELECT * FROM hris_payroll_handoff_receipts WHERE "organizationId"=${a.organizationId} AND "packageId"=${p.id}`;await audit(tx,a,p.id,'READ',{packageHash:p.packageHash,status});return {...summary(p),scopeKey:a.organizationId+':'+a.actorId,manifest:p.manifestJson,manifestBytes:p.manifestBytes,csvBytes:p.csvBytes,manifestHash:p.manifestHash,csvHash:p.csvHash,freshness:status,receipt:receipts[0]?publicReceipt(receipts[0]):null,canReceive:p.recipientUserId===a.actorId&&p.issuedById!==a.actorId&&hasAnyRbacPermission(a.actorPermissions,['hris.handoff.receive'])&&status==='CURRENT'&&!receipts.length}})}
export async function acknowledgePayrollHandoff(actor:SelfServiceActor,raw:unknown,client:typeof db=db){const input=handoffReceiptSchema.parse(raw);return transaction(client,async tx=>{
 const a=await handoffActor(tx,actor);handoffPermission(a,'hris.handoff.receive');const p=await packageRow(tx,a,input.packageId)
 if(p.recipientUserId!==a.actorId||p.issuedById===a.actorId)throw new ForbiddenError('Only the independent named recipient can acknowledge this package.')
 verifyBytes(p);if(input.packageHash!==p.packageHash)throw new ConflictError('HRIS_HANDOFF_PACKAGE_HASH_MISMATCH')
 const requestHash=handoffHash({...input,actorId:a.actorId});await profileLock(tx,a.organizationId)
 const previous=await tx.$queryRaw<Receipt[]>`SELECT * FROM hris_payroll_handoff_receipts WHERE "organizationId"=${a.organizationId} AND ("packageId"=${p.id} OR ("actorId"=${a.actorId} AND "idempotencyKey"=${input.idempotencyKey}))`
 if(previous.length){const old=previous[0];if(old.requestHash!==requestHash||old.idempotencyKey!==input.idempotencyKey)throw new ConflictError('HRIS_HANDOFF_RECEIPT_REPLAY_CONFLICT');return publicReceipt(old)}
 if(await freshness(tx,a,p)!=='CURRENT')throw new ConflictError('HRIS_HANDOFF_PACKAGE_NOT_CURRENT')
 const result=reconcileHandoffReceipt(p.manifestJson,input.acceptedRowIds,input.rejectedRows),id=randomUUID(),at=new Date()
 const receipts=await tx.$queryRaw<Receipt[]>`INSERT INTO hris_payroll_handoff_receipts (id,"organizationId","packageId","actorId","idempotencyKey","requestHash","packageHash",status,"acceptedRowIds","rejectedRows",reference,"recordedAt") VALUES (${id},${a.organizationId},${p.id},${a.actorId},${input.idempotencyKey},${requestHash},${p.packageHash},${result.status},${JSON.stringify(input.acceptedRowIds)}::jsonb,${JSON.stringify(input.rejectedRows)}::jsonb,${input.reference},${at}) RETURNING *`
 await event(tx,a,id,'recipient-recorded',{packageId:p.id,packageHash:p.packageHash,acceptedCount:result.acceptedCount,rejectedCount:result.rejectedCount});await audit(tx,a,p.id,result.status,{packageHash:p.packageHash,receiptId:id,acceptedCount:result.acceptedCount,rejectedCount:result.rejectedCount});return publicReceipt(receipts[0])
})}
export async function getPayrollHandoffWorkspace(actor:SelfServiceActor,client:typeof db=db){return transaction(client,async tx=>{const a=await handoffActor(tx,actor),hr=manager(a),policy=handoffPolicy(a.organizationId),packages=await tx.$queryRaw<Package[]>`SELECT * FROM hris_payroll_handoff_packages WHERE "organizationId"=${a.organizationId} AND (${hr} OR "recipientUserId"=${a.actorId}) ORDER BY "issuedAt" DESC,id LIMIT 101`,periods=hr?await tx.payrollPeriod.findMany({where:{organizationId:a.organizationId},select:{id:true,name:true,periodStart:true,periodEnd:true,countryCode:true},orderBy:[{periodStart:'desc'},{id:'asc'}],take:101}):[];return {scopeKey:a.organizationId+':'+a.actorId,asOf:new Date().toISOString(),canPrepare:hr,canIssue:hr&&hasAnyRbacPermission(a.actorPermissions,['hris.handoff.export']),configured:!!policy,recipientLabel:policy&&(hr||policy.recipientUserId===a.actorId)?policy.recipientLabel:null,periods:periods.slice(0,100).map(p=>({...p,periodStart:p.periodStart.toISOString(),periodEnd:p.periodEnd.toISOString()})),packages:packages.slice(0,100).map(summary),historyTruncated:packages.length>100||periods.length>100}})}
