import {z} from "zod"
import {createHash,createCipheriv,createDecipheriv,randomBytes,createHmac,timingSafeEqual} from "node:crypto"
import {BusinessRuleError,ForbiddenError} from "@/services/_shared/action-errors"

export const HR_DOCUMENT_MAX_BYTES=5*1024*1024
export const documentPolicySchema=z.object({
 organizationId:z.string().min(1),countryCode:z.string().length(2),code:z.string().min(2).max(60),version:z.string().min(1).max(40),
 nameEn:z.string().min(1).max(120),nameFr:z.string().min(1).max(120),retentionDays:z.number().int().positive().max(36500),
 employeeVisible:z.boolean(),employeeMayUpload:z.boolean(),approvalReference:z.string().min(8).max(200),approvedBy:z.string().min(1).max(120),approvedAt:z.string().datetime(),
 effectiveFrom:z.string().datetime(),effectiveTo:z.string().datetime(),documentKind:z.enum(["CONTRACT","IDENTITY","EMPLOYMENT_RECORD"]),
}).strict()
export type DocumentPolicy=z.infer<typeof documentPolicySchema>
export type HrisDocumentActor={organizationId:string;actorId:string;actorPermissions:string[]}
export const documentInputSchema=z.object({employeeId:z.string().min(1).optional(),policyCode:z.string().min(2),title:z.string().trim().min(2).max(120),mimeType:z.enum(["application/pdf","image/png","image/jpeg"]),idempotencyKey:z.string().min(8).max(160),replacesDocumentId:z.string().uuid().optional(),expiresAt:z.string().datetime().nullable().optional()}).strict()
export const digest=(bytes:Uint8Array|string)=>createHash("sha256").update(bytes).digest("hex")
export function documentPolicies(organizationId:string,now=new Date()):DocumentPolicy[]{
 const raw=process.env.HRIS_DOCUMENT_POLICIES_JSON;if(!raw)return []
 let parsed:unknown;try{parsed=JSON.parse(raw)}catch{throw new BusinessRuleError("HRIS_DOCUMENT_POLICY_UNAVAILABLE")}
 const policies=z.array(documentPolicySchema).max(200).parse(parsed)
 if(policies.some(p=>new Date(p.effectiveFrom)>=new Date(p.effectiveTo)||new Date(p.approvedAt)>now))throw new BusinessRuleError("HRIS_DOCUMENT_POLICY_UNAVAILABLE")
 const admitted=policies.filter(p=>p.organizationId===organizationId&&new Date(p.effectiveFrom)<=now&&new Date(p.effectiveTo)>now)
 if(new Set(admitted.map(p=>p.code)).size!==admitted.length)throw new BusinessRuleError("HRIS_DOCUMENT_POLICY_AMBIGUOUS")
 return admitted
}
export function validateEmployeeDocument(bytes:Uint8Array,mimeType:string){
 const b=Buffer.from(bytes);if(b.length<12||b.length>HR_DOCUMENT_MAX_BYTES)throw new BusinessRuleError("HRIS_DOCUMENT_SIZE: Choose a PDF, PNG or JPEG no larger than 5 MB.")
 const valid=mimeType==="application/pdf"?b.subarray(0,5).toString("ascii")==="%PDF-"&&b.subarray(Math.max(0,b.length-1024)).includes(Buffer.from("%%EOF")):
 mimeType==="image/png"?b.subarray(0,8).equals(Buffer.from([137,80,78,71,13,10,26,10])):mimeType==="image/jpeg"?b[0]===255&&b[1]===216&&b[2]===255&&b[b.length-2]===255&&b[b.length-1]===217:false
 if(!valid)throw new BusinessRuleError("HRIS_DOCUMENT_FORMAT: File contents do not match the supported format.")
 // Format recognition is not a malware verdict. Every accepted file remains quarantined.
 return {sha256:digest(bytes),byteLength:b.length,mimeType}
}
export function encryptEmployeeDocument(bytes:Uint8Array,organizationId:string,id:string){
 const key=randomBytes(32),iv=randomBytes(12),cipher=createCipheriv("aes-256-gcm",key,iv);cipher.setAAD(Buffer.from(`hris-document-v1:${organizationId}:${id}`));const ciphertext=Buffer.concat([cipher.update(bytes),cipher.final()]);return {ciphertext,encryptionKey:key.toString("base64"),encryptionIv:iv.toString("base64"),encryptionTag:cipher.getAuthTag().toString("base64")}
}
export function decryptEmployeeDocument(ciphertext:Uint8Array,record:{id:string;organizationId:string;encryptionKey:string;encryptionIv:string;encryptionTag:string;byteLength:number;sha256:string}){
 try{if(ciphertext.length!==record.byteLength||ciphertext.length>HR_DOCUMENT_MAX_BYTES)throw Error();const cipher=createDecipheriv("aes-256-gcm",Buffer.from(record.encryptionKey,"base64"),Buffer.from(record.encryptionIv,"base64"));cipher.setAAD(Buffer.from(`hris-document-v1:${record.organizationId}:${record.id}`));cipher.setAuthTag(Buffer.from(record.encryptionTag,"base64"));const bytes=Buffer.concat([cipher.update(ciphertext),cipher.final()]);if(bytes.length!==record.byteLength||digest(bytes)!==record.sha256)throw Error();return bytes}catch{throw new BusinessRuleError("HRIS_DOCUMENT_INTEGRITY_UNAVAILABLE: The retained original could not be verified.")}
}
const grantSchema=z.object({v:z.literal(1),documentId:z.string().uuid(),organizationId:z.string().min(1),actorId:z.string().min(1),revision:z.number().int().positive(),issuedAt:z.number().int(),expiresAt:z.number().int(),nonce:z.string().length(32)}).strict()
function grantSecret(){const secret=process.env.HRIS_DOCUMENT_GRANT_SECRET;if(!secret||secret.length<32)throw new BusinessRuleError("HRIS_DOCUMENT_GRANTS_UNCONFIGURED");return secret}
export function issueDocumentGrant(input:Omit<z.infer<typeof grantSchema>,"v"|"issuedAt"|"expiresAt"|"nonce">,now=Date.now()){
 const data={...input,v:1 as const,issuedAt:now,expiresAt:now+60000,nonce:randomBytes(16).toString("hex")},payload=Buffer.from(JSON.stringify(data)).toString("base64url"),signature=createHmac("sha256",grantSecret()).update(payload).digest("base64url");return {token:payload+"."+signature,expiresAt:new Date(data.expiresAt).toISOString()}
}
export function parseDocumentGrant(token:string,now=Date.now()){
 try{if(token.length>4096)throw Error();const [payload,signature,extra]=token.split(".");if(extra||!payload||!signature)throw Error();const expected=createHmac("sha256",grantSecret()).update(payload).digest(),actual=Buffer.from(signature,"base64url");if(actual.length!==expected.length||!timingSafeEqual(actual,expected))throw Error();const value=grantSchema.parse(JSON.parse(Buffer.from(payload,"base64url").toString("utf8")));if(value.expiresAt<=now||value.issuedAt>now||value.expiresAt-value.issuedAt!==60000)throw Error();return value}catch{throw new ForbiddenError("HRIS_DOCUMENT_GRANT_EXPIRED: Request a fresh download link.")}
}
