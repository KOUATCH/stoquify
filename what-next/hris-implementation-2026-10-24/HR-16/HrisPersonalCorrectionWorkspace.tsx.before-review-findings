"use client"
import {useRef,useState} from "react"
import {Button} from "@/components/ui/button"
import {Input} from "@/components/ui/input"
import {Label} from "@/components/ui/label"
import {Card,CardHeader,CardTitle,CardContent} from "@/components/ui/card"
import type {getOwnCorrectionWorkspace,getCorrectionQueue,getCorrectionReview} from "@/services/hris/personal-correction.service"
export type OwnCorrections=Awaited<ReturnType<typeof getOwnCorrectionWorkspace>>
export type CorrectionQueue=Awaited<ReturnType<typeof getCorrectionQueue>>
type Review=Awaited<ReturnType<typeof getCorrectionReview>>
export type CorrectionTransport=(operation:"OWN"|"SUBMIT"|"AMEND"|"QUEUE"|"REVIEW"|"DECIDE",input?:unknown)=>Promise<any>
const stateLabels:Record<string,[string,string]>={REQUESTED:["Awaiting HR review","En attente de vérification RH"],RETURNED:["Information requested","Informations demandées"],REJECTED:["Rejected","Refusée"],APPLIED:["Approved and applied","Approuvée et appliquée"]}
export function HrisPersonalCorrectionWorkspace({initial,own,locale,execute}:{initial:OwnCorrections|CorrectionQueue;own:boolean;locale:"en"|"fr";execute:CorrectionTransport}){
 const fr=locale==="fr",t=(en:string,frText:string)=>fr?frText:en,fieldLabel=(field:string)=>field==="legalName"?t("Legal name","Nom légal"):t("Display name","Nom usuel")
 const [data,setData]=useState(initial),[field,setField]=useState<"displayName"|"legalName">("displayName"),[value,setValue]=useState(""),[reason,setReason]=useState(""),[documentId,setDocumentId]=useState(""),[amending,setAmending]=useState<{id:string;revision:number}|null>(null),[review,setReview]=useState<Review|null>(null),[decision,setDecision]=useState("APPROVE"),[decisionReason,setDecisionReason]=useState(""),[ack,setAck]=useState(false),[busy,setBusy]=useState(false),[error,setError]=useState(""),[notice,setNotice]=useState(""),[retry,setRetry]=useState<{operation:"SUBMIT"|"AMEND"|"DECIDE";input:any}|null>(null)
 const message=useRef<HTMLParagraphElement>(null),ownData=own?data as OwnCorrections:null
 const refresh=async()=>{const next=await execute(own?"OWN":"QUEUE");setData(next);return next}
 async function run(fn:()=>Promise<void>){setBusy(true);setError("");setNotice("");try{await fn()}catch(e){if([400,403,404,409,422].includes((e as {status?:number}).status??0)){setRetry(null);setAck(false);setReview(null);setError(t("The request needs correction or your access changed. Refresh the case and review the current facts; your draft is retained.","La demande doit être corrigée ou vos droits ont changé. Actualisez le dossier et vérifiez les faits actuels ; votre brouillon est conservé."))}else setError(t("Outcome unconfirmed. Retry the same request to recover its recorded result.","Résultat incertain. Réessayez la même demande pour récupérer son résultat enregistré."))}finally{setBusy(false);setTimeout(()=>message.current?.focus(),0)}}
 async function send(envelope:NonNullable<typeof retry>){setRetry(envelope);const result=await execute(envelope.operation,envelope.input);setRetry(null);setReview(null);setAck(false);setAmending(null);setNotice(result.status==="APPLIED"?t("Correction approved and applied to the employee profile. Published payroll records remain unchanged.","Correction approuvée et appliquée au profil. Les documents de paie publiés restent inchangés."):t("Case update recorded. Its status and history are shown below.","Mise à jour du dossier enregistrée. Son statut et son historique figurent ci-dessous."));await refresh()}
 const cases=data.cases
 return <main className="mx-auto max-w-4xl space-y-4 p-4 min-w-0"><h1 className="text-2xl font-semibold">{own?t("My profile corrections","Mes corrections de profil"):t("Personal-data correction review","Vérification des corrections personnelles")}</h1><p>{t("Changes follow a reviewed case. Salary, bank details, employment status and account access use their separate HR workflows.","Les changements suivent un dossier vérifié. La rémunération, les coordonnées bancaires, le statut d’emploi et les accès suivent leurs propres procédures RH.")}</p>
 <p ref={message} tabIndex={-1} role={error?"alert":"status"} className="break-words">{error||notice}</p><div className="flex flex-wrap gap-2"><Button disabled={busy} variant="outline" onClick={()=>run(async()=>{await refresh();if(!retry){setReview(null);setAck(false)}setNotice(t("Current case status loaded.","Statut actuel du dossier chargé."))})}>{t("Refresh cases","Actualiser les dossiers")}</Button>{retry&&<Button disabled={busy} onClick={()=>run(()=>send(retry))}>{t("Recover recorded result","Récupérer le résultat enregistré")}</Button>}</div>
 {ownData&&<Card><CardHeader><CardTitle>{amending?t("Complete the returned request","Compléter la demande retournée"):t("Request a profile correction","Demander une correction du profil")}</CardTitle></CardHeader><CardContent className="space-y-3"><p>{t("HR owner: ","Responsable RH : ")}{ownData.ownerName??t("Not configured","Non configuré")}</p>
 {!ownData.canSubmit?<p role="status">{fr?ownData.support.fr:ownData.support.en}</p>:<form className="space-y-3" onSubmit={e=>{e.preventDefault();const input={proposal:{[field]:value},reason,...(documentId?{documentId}:{}),idempotencyKey:crypto.randomUUID(),...(amending?{caseId:amending.id,revision:amending.revision}:{})};void run(()=>send({operation:amending?"AMEND":"SUBMIT",input}))}}><fieldset disabled={busy||!!retry} className="space-y-3"><div><Label htmlFor="correction-field">{t("Field to correct","Champ à corriger")}</Label><select id="correction-field" value={field} onChange={e=>setField(e.target.value as typeof field)} className="w-full rounded-md border bg-background p-2">{ownData.allowedFields.map(f=><option key={f} value={f}>{fieldLabel(f)}</option>)}</select></div><p>{t("Current value: ","Valeur actuelle : ")}{ownData.profile[field]??"—"}</p><div><Label htmlFor="correction-value">{t("Proposed value","Valeur proposée")}</Label><Input id="correction-value" required maxLength={field==="legalName"?200:160} value={value} onChange={e=>setValue(e.target.value)}/></div><div><Label htmlFor="correction-reason">{t("Reason and supporting details","Motif et informations utiles")}</Label><textarea id="correction-reason" className="w-full rounded-md border bg-background p-2" required minLength={8} maxLength={1000} value={reason} onChange={e=>setReason(e.target.value)}/></div><div><Label htmlFor="correction-document">{t("Reviewed identity document","Pièce d’identité vérifiée")}</Label><select id="correction-document" className="w-full rounded-md border bg-background p-2" required={field==="legalName"} value={documentId} onChange={e=>setDocumentId(e.target.value)}><option value="">{t("Choose if required","Choisir si nécessaire")}</option>{ownData.documents.map(d=><option key={d.id} value={d.id}>{d.title}</option>)}</select><p className="text-sm">{t("A legal-name correction requires a reviewed, valid identity original.","Une correction du nom légal nécessite une pièce d’identité valide et vérifiée.")} <a className="underline" href={`/${locale}/dashboard/people/me/documents`}>{t("Open my documents","Ouvrir mes documents")}</a></p></div></fieldset><Button type="submit" disabled={busy||!!retry||!value.trim()||reason.trim().length<8||!ownData.allowedFields.includes(field)}>{amending?t("Resubmit information","Renvoyer les informations"):t("Submit for review","Soumettre pour vérification")}</Button></form>}</CardContent></Card>}
 {data.historyTruncated&&<p role="status">{t("Recent cases are shown. Contact HR for older retained history.","Les dossiers récents sont affichés. Contactez les RH pour l’historique antérieur.")}</p>}
 {!cases.length&&<p>{t("No correction cases in this scope.","Aucun dossier de correction dans ce périmètre.")}</p>}
 {cases.map(c=><Card key={c.id}><CardHeader><CardTitle className="break-words">{!own&&"employeeName" in c?String(c.employeeName)+" · ":""}{stateLabels[c.status]?.[fr?1:0]??c.status}</CardTitle></CardHeader><CardContent className="space-y-3 break-words"><p>{new Date(c.createdAt).toLocaleDateString(locale)} · {t("Version ","Version ")}{c.revision}</p><dl>{Object.entries(c.proposal).map(([k,v])=><div key={k}><dt>{fieldLabel(k)}</dt><dd>{c.baseline[k as keyof typeof c.baseline]??"—"} → {v}</dd></div>)}</dl><p>{c.reason}</p>
 {c.status==="APPLIED"&&<p>{t("Applied employee version: ","Version du profil appliquée : ")}{c.appliedEmployeeVersion}</p>}
 <details><summary>{t("Case history","Historique du dossier")}</summary><ol className="list-decimal pl-5 space-y-2">{c.history.map((h,index)=><li key={index}><span>{new Date(h.at).toLocaleString(locale)} · {h.operation}</span><p>{h.reason}</p>{h.proposal&&<p>{Object.entries(h.proposal).map(([key,v])=>fieldLabel(key)+": "+v).join(" · ")}</p>}</li>)}</ol></details>
 {own&&c.status==="RETURNED"&&ownData?.canSubmit&&<Button disabled={busy||!!retry} onClick={()=>{setAmending({id:c.id,revision:c.revision});const first=Object.entries(c.proposal)[0];setField(first[0] as typeof field);setValue(first[1]!);setReason(c.reason);setDocumentId(c.documentId??"");window.scrollTo({top:0,behavior:"smooth"})}}>{t("Provide requested information","Fournir les informations demandées")}</Button>}
 {!own&&<Button disabled={busy||!!retry} variant="outline" onClick={()=>run(async()=>{setReview(await execute("REVIEW",{caseId:c.id}));setAck(false);setDecisionReason("");setDecision("APPROVE")})}>{t("Review current facts","Vérifier les faits actuels")}</Button>}
 {review?.id===c.id&&<section aria-label={t("Correction review","Vérification de la correction")} className="space-y-3 border-t pt-3"><h2 className="font-semibold">{review.employee.displayName}</h2><p>{t("Assigned reviewer: ","Responsable désigné : ")}{review.ownerName}</p><dl>{Object.entries(review.proposal).map(([k,v])=><div key={k}><dt>{fieldLabel(k)}</dt><dd>{t("Current: ","Actuel : ")}{review.current[k as keyof typeof review.current]??"—"} → {v}</dd></div>)}</dl>{review.documentId&&<a className="underline" target="_blank" rel="noreferrer" href={`/${locale}/dashboard/people/documents?employeeId=${encodeURIComponent(review.employee.id)}`}>{t("Inspect the protected supporting original","Vérifier l’original justificatif protégé")}</a>}
 {!review.independent?<p>{t("Another HR reviewer must decide your own correction.","Un autre responsable RH doit décider de votre propre correction.")}</p>:["REQUESTED","RETURNED"].includes(review.status)&&<form className="space-y-3" onSubmit={e=>{e.preventDefault();void run(()=>send({operation:"DECIDE",input:{caseId:review.id,revision:review.revision,reviewVersion:review.reviewVersion,decision,reason:decisionReason,acknowledged:ack,idempotencyKey:crypto.randomUUID()}}))}}><fieldset className="space-y-3" disabled={busy||!!retry}><label className="block">{t("Decision","Décision")}<select className="w-full rounded-md border bg-background p-2" value={decision} onChange={e=>{setDecision(e.target.value);setAck(false)}}>{review.assignedToActor&&review.status==="REQUESTED"&&<><option value="APPROVE">{t("Approve and apply","Approuver et appliquer")}</option><option value="RETURN">{t("Return for information","Demander des informations")}</option></>}{review.assignedToActor&&<option value="REJECT">{t("Reject","Refuser")}</option>}<option value="REASSIGN">{t("Assign configured replacement reviewer","Désigner le nouveau responsable configuré")}</option></select></label><Label htmlFor="correction-decision-reason">{t("Decision reason","Motif de décision")}</Label><textarea id="correction-decision-reason" required minLength={8} maxLength={1000} value={decisionReason} onChange={e=>setDecisionReason(e.target.value)} className="w-full rounded-md border bg-background p-2"/><label className="flex items-start gap-2"><input type="checkbox" checked={ack} onChange={e=>setAck(e.target.checked)}/>{t("I reviewed the current values, proposal, evidence and responsible reviewer.","J’ai vérifié les valeurs actuelles, la proposition, les preuves et le responsable désigné.")}</label></fieldset><Button type="submit" disabled={busy||!!retry||!ack||decisionReason.trim().length<8}>{t("Record decision","Enregistrer la décision")}</Button></form>}</section>}
 </CardContent></Card>)}
 </main>
}
