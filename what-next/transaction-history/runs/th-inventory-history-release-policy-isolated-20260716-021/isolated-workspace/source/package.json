    "release:evidence:gate:release": "node scripts/release-evidence-ratchet.js --mode fail --release on --out what-next/skills-life-cycle/STOQUIFY_OHADA_LEADERSHIP_RELEASE_EVIDENCE_INDEX_2026-07-11.md --json-out what-next/skills-life-cycle/stoquify-ohada-leadership-release-evidence-index-2026-07-11.json",
    "release:secrets:preflight": "node scripts/release-secret-preflight.js --mode fail --release auto --out what-next/release-secret-preflight.md --json-out what-next/release-secret-preflight.json",
    "release:secrets:preflight:release": "node scripts/release-secret-preflight.js --mode fail --release on --out what-next/release-secret-preflight.md --json-out what-next/release-secret-preflight.json",
    "ci:release:gate": "node scripts/ci-release-readiness-gate.js --mode fail --out what-next/ci-release-readiness.md --json-out what-next/ci-release-readiness.json",
    "public-identity:abuse:gate:release": "node scripts/public-identity-abuse-gate.js --mode fail --release on --out what-next/public-identity-abuse-readiness.md --json-out what-next/public-identity-abuse-readiness.json",
