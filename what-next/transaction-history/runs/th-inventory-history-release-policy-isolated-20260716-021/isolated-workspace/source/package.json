    "regulatory:hardcode": "node scripts/regulatory-hardcode-gate.js --mode report",
    "regulatory:hardcode:fail": "node scripts/regulatory-hardcode-gate.js --mode fail",
    "seed:e2e:payroll": "node scripts/seed-payroll-e2e-user.js",
