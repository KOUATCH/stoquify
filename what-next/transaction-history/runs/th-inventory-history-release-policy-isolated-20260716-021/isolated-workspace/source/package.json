{
  "name": "STOQUIFY",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx prisma generate && next dev -p 3000",
    "dev:turbopack": "npx prisma generate && next dev --turbopack -p 3000",
    "build": "npm run release:secrets:preflight && npm run prisma:migrate:deploy:safe && npm run build:linted",
    "build:app": "node scripts/build-app-safe.js",
    "build:app:next": "next build",
    "build:app:diagnostics": "node scripts/build-app-diagnostics.js",
    "build:linted": "npm run lint && npm run build:app",
    "start": "next start",
    "lint": "eslint app actions components config hooks lib services --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit --pretty false",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migration:safety:gate": "node scripts/prisma-production-migration-gate.js --mode fail --environment local --out what-next/prisma-migration-deployment-readiness.md --json-out what-next/prisma-migration-deployment-readiness.json",
    "prisma:migration:release:preflight": "node scripts/prisma-production-migration-gate.js --mode fail --environment production --out what-next/prisma-migration-deployment-readiness.md --json-out what-next/prisma-migration-deployment-readiness.json",
    "prisma:migrate:deploy:safe": "node scripts/prisma-production-migration-gate.js --mode execute --environment auto --out what-next/prisma-migration-deployment-readiness.md --json-out what-next/prisma-migration-deployment-readiness.json",
    "service:boundary": "node scripts/service-boundary-gate.js --mode report",
    "service:boundary:ratchet": "node scripts/service-boundary-gate.js --mode fail --baseline what-next/service-boundary-ratchet-baseline-current.json",
    "service:boundary:fail": "node scripts/service-boundary-gate.js --mode fail",
    "workflow:assurance:runtime-check": "node scripts/workflow-assurance-runtime-table-check.js --mode fail",
    "error:boundary": "node scripts/raw-error-boundary-gate.js --mode report",
    "error:boundary:fail": "node scripts/raw-error-boundary-gate.js --mode fail",
    "demo:trust": "node scripts/demo-report-trust-gate.js --mode report",
    "demo:trust:fail": "node scripts/demo-report-trust-gate.js --mode fail",
    "hard-delete": "node scripts/hard-delete-gate.js --mode report",
    "hard-delete:fail": "node scripts/hard-delete-gate.js --mode fail",
    "inventory:boundary": "node scripts/inventory-boundary-gate.js --mode report",
    "inventory:boundary:fail": "node scripts/inventory-boundary-gate.js --mode fail",
    "policy:gates": "npm run inventory:boundary:fail && npm run service:boundary:fail && npm run api:guard:inventory:fail && npm run public-identity:abuse:gate && npm run ledger:close-truth:gate && npm run payment:cash-truth:gate && npm run purchasing:ap:gate && npm run offline:pos:replay:gate && npm run statutory:country-pack:gate && npm run report:trust:export:gate && npm run role:cockpit:gate && npm run settings:surface:fail && npm run workflow:assurance:runtime-check && npm run workflow:assurance:release-gate && npm run kontava:moat:release-gate && npm run receipt:token:config-gate && npm run payroll:immutability:runtime && npm run hard-delete:fail && npm run regulatory:hardcode:fail && npm run demo:trust:fail && npm run error:boundary:fail && npm run ci:release:gate && npm run prisma:migration:safety:gate && npm run release:secrets:preflight && npm run release:evidence:gate",
    "verify:repo": "npm run prisma:validate && npm run typecheck && npm run lint && npm run policy:gates && npm run build:app && npm test -- --runInBand",
    "verify:ci": "npm run ci:release:gate && npm run prisma:migrate:deploy && npm run prisma:migrate:status && npm run verify:repo",
    "verify:release": "npm run verify:repo && npm run release:secrets:preflight:release && npm run prisma:migration:release:preflight && npm run public-identity:abuse:gate:release && npm run receipt:token:config-gate:release && npm run release:evidence:gate:release",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "postinstall": "npx prisma generate",
    "seed": "npx prisma db seed",
    "reset": "npx prisma migrate reset && npm run seed",
