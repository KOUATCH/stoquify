{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stoquify:business-event/v1",
  "title": "Stoquify Business Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "tenant_id",
    "organization_id",
    "occurred_at",
    "producer",
    "correlation_id",
    "payload_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "organization_id": {
      "type": "string"
    },
    "location_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "payload_ref": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    }
  }
}
