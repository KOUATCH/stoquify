{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stoquify:workflow-case/v1",
  "title": "Stoquify Workflow Case v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_type",
    "tenant_id",
    "state",
    "owner_role",
    "opened_at",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string"
    },
    "case_type": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "owner_role": {
      "type": "string"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
