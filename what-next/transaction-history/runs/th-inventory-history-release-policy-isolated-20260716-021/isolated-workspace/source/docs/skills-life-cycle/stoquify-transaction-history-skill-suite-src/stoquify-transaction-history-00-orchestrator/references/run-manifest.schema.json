{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stoquify.local/schemas/transaction-history-run-manifest.schema.json",
  "title": "Stoquify Transaction History Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "traceId",
    "mode",
    "sliceId",
    "contractVersion",
    "proposal",
    "baseCommit",
    "runtimeArtifactRoot",
    "scope",
    "stageAllowlists",
    "orchestratorPolicy",
    "gates",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": {
      "type": "string",
      "pattern": "^th-[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "mode": {
      "enum": ["audit", "implement", "verify"]
    },
    "sliceId": {
      "enum": ["foundation-inventory", "cash-payment", "ap-ar"]
    },
    "contractVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "proposal": {
      "$ref": "#/$defs/checksummedPath"
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "runtimeArtifactRoot": {
      "type": "string",
      "pattern": "^what-next/transaction-history/runs/th-[a-z0-9][a-z0-9._-]{2,127}/$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lanes", "includePaths", "excludePaths"],
      "properties": {
        "lanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["workbench", "inventory", "cash", "payment", "ap", "ar"]
          }
        },
        "includePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "excludePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        }
      }
    },
    "stageAllowlists": {
      "type": "object",
      "additionalProperties": false,
      "required": ["01", "02", "03", "04", "05", "06", "07"],
      "properties": {
        "01": { "$ref": "#/$defs/pathList" },
        "02": { "$ref": "#/$defs/pathList" },
        "03": { "$ref": "#/$defs/pathList" },
        "04": { "$ref": "#/$defs/pathList" },
        "05": { "$ref": "#/$defs/pathList" },
        "06": { "$ref": "#/$defs/pathList" },
        "07": { "$ref": "#/$defs/pathList" }
      }
    },
    "orchestratorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productCodeEdits", "installSkills", "deployMigrations"],
      "properties": {
        "productCodeEdits": { "const": false },
        "installSkills": { "const": false },
        "deployMigrations": { "const": false }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foundationInventory", "arAccountingPrerequisites"],
      "properties": {
        "foundationInventory": { "$ref": "#/$defs/gate" },
        "arAccountingPrerequisites": { "$ref": "#/$defs/gate" }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "pathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repoPath" }
    },
    "checksummedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "enum": ["PENDING", "PASS", "BLOCKED", "NA"] },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        }
      }
    }
  }
}
