{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stoquify:handoff/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "from_capability",
    "to_capability",
    "reason",
    "state",
    "evidence_refs",
    "next_required_action",
    "security"
  ],
  "properties": {
    "trace_id": {
      "type": "string"
    },
    "from_capability": {
      "type": "string"
    },
    "to_capability": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_required_action": {
      "type": "string"
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "security": {
      "$ref": "urn:stoquify:retrieved-content-isolation-result/v1"
    }
  },
  "title": "Handoff v1"
}
