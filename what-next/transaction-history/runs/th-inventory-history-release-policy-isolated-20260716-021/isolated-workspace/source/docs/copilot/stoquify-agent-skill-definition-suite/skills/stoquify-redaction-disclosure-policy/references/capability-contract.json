{
  "schema_version": "1.0.0",
  "id": "S08",
  "name": "stoquify-redaction-disclosure-policy",
  "title": "Redaction and Disclosure Policy",
  "owner": "Stoquify Copilot Platform",
  "lifecycle": "source-candidate",
  "phase": "now",
  "risk": "critical",
  "autonomy_ceiling": "read",
  "disposition": "COMPOSE",
  "overlaps": [
    "aqstoqflow-access-boundary-hardener",
    "aqstoqflow-hris-payroll-07-document-evidence-redaction"
  ],
  "dependencies": [
    "S01",
    "S02"
  ],
  "permitted_service_domains": [
    "security",
    "evidence",
    "hris",
    "payroll"
  ],
  "input_schema": "../schemas/input.schema.json",
  "output_schema": "../schemas/output.schema.json",
  "max_runtime_seconds": 45,
  "max_tool_calls": 12,
  "cost_class": "controlled",
  "retry_class": "read-safe",
