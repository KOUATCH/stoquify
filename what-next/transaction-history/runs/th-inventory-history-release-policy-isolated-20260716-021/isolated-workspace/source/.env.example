# Database
DATABASE_URL="postgresql://username:password@localhost:5432/stockflow?schema=public"
PAYROLL_IMMUTABILITY_DATABASE_URL="postgresql://username:password@localhost:5432/stockflow_immutability_test?schema=public"

# Auth.js Configuration
AUTH_SECRET="your-super-secret-key-here-minimum-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Configuration (for password reset, etc.)
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
EMAIL_FROM="noreply@yourdomain.com"

# Redis (for session storage and caching - optional)
REDIS_URL="redis://localhost:6379"

# Application Settings
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production-only dedicated secrets. Generate independent random values; do not reuse AUTH_SECRET.
PUBLIC_IDENTITY_ABUSE_HASH_SECRET="your-public-identity-hash-secret-minimum-32-characters-long"
AQSTOQFLOW_RECEIPT_TOKEN_SECRET="your-receipt-token-secret-minimum-32-characters-long"
PAYROLL_PAYMENT_DESTINATION_HASH_SECRET="your-payroll-destination-hmac-secret-minimum-32-characters-long"

# Migration deployment overrides (normally leave disabled; see the production migration runbook)
AQSTOQFLOW_DEPLOY_MIGRATIONS=0
AQSTOQFLOW_DATABASE_TARGET=""

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Security Settings
BCRYPT_ROUNDS=12
JWT_EXPIRATION="7d"
SESSION_MAX_AGE=604800

# Two-Factor Authentication
TWO_FACTOR_ISSUER="StockFlow"

# File Upload
UPLOADTHING_SECRET="your-uploadthing-secret"
UPLOADTHING_APP_ID="your-uploadthing-app-id"

# Monitoring & Logging
LOG_LEVEL="info"
SENTRY_DSN=""

# Feature Flags
ENABLE_GOOGLE_AUTH=true
ENABLE_TWO_FACTOR=true
ENABLE_AUDIT_LOGGING=true
