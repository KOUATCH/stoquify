      ]
    },
    {
      "model": "TaxRate",
      "table": "tax_rates",
      "scalarFields": [
        "id",
        "rate",
        "type",
        "nameEn",
        "nameFr",
        "isActive",
        "organizationId",
        "createdAt",
        "updatedAt"
      ]
    },
    {
      "model": "Item",
      "table": "items",
      "scalarFields": [
        "id",
        "slug",
        "sku",
