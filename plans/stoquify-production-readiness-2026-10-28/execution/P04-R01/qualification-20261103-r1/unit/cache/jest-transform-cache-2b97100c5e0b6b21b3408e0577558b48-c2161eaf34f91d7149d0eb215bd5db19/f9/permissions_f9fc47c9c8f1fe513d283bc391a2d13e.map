  cashierPermissions,
  viewerPermissions,
  rolePermissionMap,
  permissionCategories,
  getPermissionsForRole,
  hasPermission,
  hasAnyPermission,
  hasAllPermissions,
  getPermissionsByCategory,
  getAllPermissions,
  isValidPermission,
};
